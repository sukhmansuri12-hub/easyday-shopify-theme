{% comment %}
  Show All Products CTA
  Prominent call-to-action button linking to full catalog
{% endcomment %}

<section class="show-all-cta-section" style="padding: 40px 20px; background: #f8f9fa;">
  <div class="container" style="max-width: 1200px; margin: 0 auto; text-align: center;">
    <div class="cta-content" style="position: relative; z-index: 1;">
      <a href="/collections/all" class="btn-show-all">
        <span class="btn-text">EXPLORE ALL PRODUCTS</span>
        <span class="btn-arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .show-all-cta-section {
    position: relative;
    overflow: hidden;
  }
  
  .btn-show-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 16px 36px;
    background: #1E88E5;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 1rem;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(30, 136, 229, 0.3);
  }
  
  .btn-show-all:hover {
    background: #1565C0;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(30, 136, 229, 0.4);
  }
  
  .btn-show-all:active {
    transform: translateY(-1px) scale(1.02);
  }
  

  
  .btn-arrow {
    font-size: 1.3rem;
    transition: transform 0.3s ease;
  }
  
  .btn-show-all:hover .btn-arrow {
    transform: translateX(5px);
  }
  

  
  /* Mobile optimization */
  @media (max-width: 640px) {
    .show-all-cta-section {
      padding: 30px 15px;
    }
    
    .cta-heading {
      font-size: 1.4rem !important;
      margin-bottom: 10px !important;
    }
    
    .cta-subtext {
      font-size: 0.9rem !important;
      margin-bottom: 20px !important;
      padding: 0 10px;
    }
    
    .btn-show-all {
      width: 100%;
      max-width: 350px;
      padding: 16px 30px;
      font-size: 1rem;
      gap: 10px;
    }
    
    .btn-icon {
      font-size: 1.3rem;
    }
    
    .btn-arrow {
      font-size: 1.1rem;
    }
  }
  
  @media (max-width: 400px) {
    .btn-text {
      font-size: 0.95rem;
    }
  }
</style>

{% schema %}
{
  "name": "Show All Products CTA",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover More Amazing Products"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Browse our complete collection of innovative products designed to make your life easier"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "EXPLORE ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Show All Products CTA"
    }
  ]
}
{% endschema %}
