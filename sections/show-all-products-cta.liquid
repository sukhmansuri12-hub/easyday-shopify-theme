{% comment %}
  Show All Products CTA
  Prominent call-to-action button linking to full catalog
{% endcomment %}

<section class="show-all-cta-section" style="padding: 60px 20px; background: #fff;">
  <div class="container" style="max-width: 1200px; margin: 0 auto; text-align: center;">
    <div class="cta-content" style="position: relative; z-index: 1;">
      <a href="/collections/all" class="btn-show-all">
        <span class="btn-icon">🛍️</span>
        <span class="btn-text">EXPLORE ALL PRODUCTS</span>
        <span class="btn-arrow">→</span>
      </a>
    </div>
    
    <!-- Decorative elements -->
    <svg class="cta-decoration" xmlns="http://www.w3.org/2000/svg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; opacity: 0.05; pointer-events: none;">
      <circle cx="10%" cy="30%" r="40" fill="#1a56db"/>
      <circle cx="90%" cy="70%" r="60" fill="#1e40af"/>
      <circle cx="85%" cy="20%" r="30" fill="#dbeafe"/>
    </svg>
  </div>
</section>

<style>
  .show-all-cta-section {
    position: relative;
    overflow: hidden;
  }
  
  .btn-show-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 20px 50px;
    background: #1a56db;
    color: white;
    text-decoration: none;
    border-radius: 50px;
    font-weight: 700;
    font-size: 1.15rem;
    font-family: 'Poppins', sans-serif;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 0 6px 25px rgba(26, 86, 219, 0.3);
    position: relative;
    overflow: hidden;
  }
  
  .btn-show-all::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.5s ease;
  }
  
  .btn-show-all:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 12px 35px rgba(26, 86, 219, 0.45);
    background: #1e40af;
  }
  
  .btn-show-all:hover::before {
    left: 100%;
  }
  
  .btn-arrow {
    font-size: 1.3rem;
    transition: transform 0.3s ease;
  }
  
  .btn-show-all:hover .btn-arrow {
    transform: translateX(5px);
  }
  
  .btn-icon {
    font-size: 1.5rem;
    line-height: 1;
  }
  
  /* Mobile optimization */
  @media (max-width: 640px) {
    .show-all-cta-section {
      padding: 30px 15px;
    }
    
    .cta-heading {
      font-size: 1.4rem !important;
      margin-bottom: 10px !important;
    }
    
    .cta-subtext {
      font-size: 0.9rem !important;
      margin-bottom: 20px !important;
      padding: 0 10px;
    }
    
    .btn-show-all {
      width: 100%;
      max-width: 350px;
      padding: 16px 30px;
      font-size: 1rem;
      gap: 10px;
    }
    
    .btn-icon {
      font-size: 1.3rem;
    }
    
    .btn-arrow {
      font-size: 1.1rem;
    }
  }
  
  @media (max-width: 400px) {
    .btn-text {
      font-size: 0.95rem;
    }
  }
</style>

{% schema %}
{
  "name": "Show All Products CTA",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover More Amazing Products"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Browse our complete collection of innovative products designed to make your life easier"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "EXPLORE ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Show All Products CTA"
    }
  ]
}
{% endschema %}
