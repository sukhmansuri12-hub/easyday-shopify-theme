{% comment %}
  Elite Product Page - Competitive Advantage Version
  Features: Triple Urgency Stack, Smart Sticky Bar, Hybrid Payment CTA, Image Gallery 2.0
{% endcomment %}

<div class="product-elite" data-product-id="{{ product.id }}">
  
  {%- comment -%} Triple Urgency Stack {%-endcomment-%}
  <div class="urgency-stack">
    <div class="urgency-item visitor-count">
      <svg class="urgency-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2.735 1h-.41A5.478 5.478 0 0 1 8 9.5a5.478 5.478 0 0 1-2.325-.5H5.265A4.265 4.265 0 0 0 1 13.265V14a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.735A4.265 4.265 0 0 0 10.735 9z"/>
      </svg>
      <span class="visitor-number" data-count="{{ product.id | modulo: 300 | plus: 150 }}">{{ product.id | modulo: 300 | plus: 150 }}</span>
      <span class="visitor-text">people viewing now</span>
    </div>

    <div class="urgency-item stock-meter">
      {% assign stock_percent = product.id | modulo: 40 | plus: 10 %}
      <div class="stock-bar">
        <div class="stock-fill" style="width: {{ stock_percent }}%"></div>
      </div>
      <p class="stock-text">HURRY! Only <strong>{{ stock_percent }}</strong> left in stock</p>
    </div>

    <div class="urgency-item countdown-timer" data-end-time="{{ 'now' | date: '%s' | plus: 86400 }}">
      <svg class="timer-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
        <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z"/>
        <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"/>
      </svg>
      <span class="timer-label">Deal ends in:</span>
      <div class="timer-display">
        <span class="timer-hours">23</span>h
        <span class="timer-minutes">59</span>m
        <span class="timer-seconds">59</span>s
      </div>
    </div>
  </div>

  {%- comment -%} Product Gallery {%-endcomment-%}
  <div class="product-gallery-elite">
    <div class="gallery-main">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | img_url: '800x' }}" 
             alt="{{ product.featured_image.alt | escape }}"
             class="gallery-image"
             loading="eager">
      {% endif %}
      <button class="zoom-button" aria-label="Zoom image">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
          <path d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z"/>
        </svg>
      </button>
    </div>
    
    {% if product.images.size > 1 %}
    <div class="gallery-thumbnails">
      {% for image in product.images limit: 5 %}
        <button class="thumbnail {% if forloop.first %}active{% endif %}" 
                data-image-src="{{ image | img_url: '800x' }}">
          <img src="{{ image | img_url: '100x' }}" alt="{{ image.alt | escape }}">
        </button>
      {% endfor %}
    </div>
    {% endif %}
  </div>

  {%- comment -%} Product Info {%-endcomment-%}
  <div class="product-info-elite">
    <h1 class="product-title">{{ product.title }}</h1>
    
    {%- comment -%} Price & Savings {%-endcomment-%}
    <div class="product-price-section">
      {% if product.compare_at_price > product.price %}
        <span class="price-compare">₹{{ product.compare_at_price | money_without_currency }}</span>
        <span class="price-current">₹{{ product.price | money_without_currency }}</span>
        <span class="price-badge">
          SAVE {{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%
        </span>
      {% else %}
        <span class="price-current">₹{{ product.price | money_without_currency }}</span>
      {% endif %}
    </div>

    {%- comment -%} Trust Injection System {%-endcomment-%}
    <div class="trust-badges">
      <div class="trust-badge" style="animation-delay: 0s">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span>Free Shipping</span>
      </div>
      <div class="trust-badge" style="animation-delay: 0.1s">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6z"/>
        </svg>
        <span>COD Available</span>
      </div>
      <div class="trust-badge" style="animation-delay: 0.2s">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/>
        </svg>
        <span>Easy Returns</span>
      </div>
      <div class="trust-badge india-badge" style="animation-delay: 0.3s">
        <span>Made with ❤️ in India 🇮🇳</span>
      </div>
    </div>

    {%- comment -%} Quantity Selector with Savings Calculator {%-endcomment-%}
    <div class="quantity-savings-section">
      <label class="quantity-label">Quantity</label>
      <div class="quantity-tiers">
        <button class="tier-option" data-qty="1" data-discount="0">
          <span class="tier-qty">1 Unit</span>
          <span class="tier-price">₹{{ product.price | money_without_currency }}</span>
        </button>
        <button class="tier-option best-deal" data-qty="2" data-discount="10">
          <span class="tier-badge">SAVE 10%</span>
          <span class="tier-qty">2 Units</span>
          <span class="tier-price">₹{{ product.price | times: 2 | times: 0.9 | money_without_currency }}</span>
          <span class="tier-savings">Save ₹{{ product.price | times: 0.2 | money_without_currency }}</span>
        </button>
        <button class="tier-option" data-qty="3" data-discount="15">
          <span class="tier-badge">SAVE 15%</span>
          <span class="tier-qty">3 Units</span>
          <span class="tier-price">₹{{ product.price | times: 3 | times: 0.85 | money_without_currency }}</span>
          <span class="tier-savings">Save ₹{{ product.price | times: 0.45 | money_without_currency }}</span>
        </button>
      </div>
    </div>

    {%- comment -%} Hybrid Payment CTA (3-button layout) {%-endcomment-%}
    <div class="cta-section" style="margin-top: 20px;">
      <style>
        .btn-standard-buy-now {
          display: block;
          width: 100%;
          background: #ff4b2b;
          background: linear-gradient(135deg, #ff416c, #ff4b2b);
          color: #ffffff !important;
          padding: 22px 10px;
          border: none;
          border-radius: 12px;
          font-size: 1.6rem;
          font-weight: 950;
          cursor: pointer;
          text-align: center;
          box-shadow: 0 10px 30px rgba(255, 75, 43, 0.5);
          text-transform: uppercase;
          letter-spacing: 1.5px;
          margin-bottom: 20px;
        }
        .btn-standard-buy-now .sub-text {
          display: block;
          font-size: 11px;
          font-weight: 400;
          margin-top: 5px;
          opacity: 0.95;
          letter-spacing: 0.5px;
        }
      </style>
      <button type="submit" name="add" class="btn-standard-buy-now">
        BUY NOW
        <span class="sub-text">GPay | UPI | Paytm | Cards</span>
      </button>
    </div>
      
      <style>
        .btn-buy-now-elite-main {
          width: 100%;
          background: linear-gradient(135deg, #ff416c 0%, #ff4b2b 100%);
          color: white;
          border: none;
          border-radius: 10px;
          padding: 18px 16px;
          font-weight: 800;
          font-size: 1.3rem;
          margin-top: 12px;
          cursor: pointer;
          box-shadow: 0 4px 15px rgba(255, 65, 108, 0.3);
          text-transform: uppercase;
        }
        .btn-buy-now-elite-main:active { transform: scale(0.98); }
      </style>

      <button class="btn-buy-now-elite-main" onclick="buyNow('prepaid')">
        BUY NOW
      </button>

      {% comment %} Inline BUY NOW Button for guaranteed visibility {% endcomment %}
      <style>
        .btn-buy-now-direct-elite {
          width: 100%;
          background: linear-gradient(135deg, #1a56db 0%, #2563eb 100%);
          color: white;
          border: none;
          border-radius: 10px;
          padding: 14px 16px;
          font-weight: 700;
          margin-top: 12px;
          cursor: pointer;
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 4px;
          box-shadow: 0 4px 15px rgba(26, 86, 219, 0.3);
          transition: transform 0.2s;
          text-transform: uppercase;
          text-decoration: none;
          text-align: center;
          font-family: inherit;
        }
        .btn-buy-now-direct-elite:active { transform: scale(0.98); }
        .buy-now-text-inline { font-size: 1.1rem; letter-spacing: 0.5px; font-weight: 800; display: block; }
        .payment-logos-inline { display: flex; align-items: center; gap: 8px; justify-content: center; width: 100%; }
        .pay-logo-inline { height: 16px; width: auto; filter: brightness(0) invert(1); opacity: 0.9; }
      </style>
      
      <button class="btn-buy-now-direct-elite" type="button" onclick="buyNowDirectInlineElite()">
        <span class="buy-now-text-inline">BUY NOW</span>
        <span class="payment-logos-inline">
          <svg class="pay-logo-inline" viewBox="0 0 48 20" xmlns="http://www.w3.org/2000/svg"><text y="15" font-size="14" font-family="Arial" font-weight="700" fill="white">G Pay</text></svg>
          <svg class="pay-logo-inline" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="12" fill="white" fill-opacity="0.2"/><path d="M16.5 7.5h-3.75L9 12l3.75 5.25h3.75L12.75 12z" fill="white"/></svg>
          <svg class="pay-logo-inline" viewBox="0 0 48 20" xmlns="http://www.w3.org/2000/svg"><text y="15" font-size="13" font-family="Arial" font-weight="700" fill="white">UPI</text></svg>
          <svg class="pay-logo-inline" viewBox="0 0 48 20" xmlns="http://www.w3.org/2000/svg"><text y="15" font-size="11" font-family="Arial" font-weight="700" fill="white">Paytm</text></svg>
        </span>
      </button>

      <script>
        window.buyNowDirectInlineElite = function() {
          const variantId = {{ product.selected_or_first_available_variant.id }};
          if (!variantId) { window.location.href = '/cart'; return; }
          fetch('/cart/clear.js', { method: 'POST' })
            .then(() => fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: variantId, quantity: 1 })
            }))
            .then(() => { window.location.href = '/checkout'; })
            .catch(() => { window.location.href = '/cart'; });
        };
      </script>

      <a href="/rsi-btn-hook" class="link-cod">📦 COD AVAILABLE</a>
    </div>

    {%- comment -%} One-Tap Checkout Preview {%-endcomment-%}
    <details class="checkout-preview">
      <summary>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
          <path fill-rule="evenodd" d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.628 3.834A.5.5 0 0 1 1.5 3.5v-2z"/>
        </svg>
        See price breakdown
      </summary>
      <div class="preview-content">
        <div class="preview-row">
          <span>Subtotal (1 unit):</span>
          <span>₹{{ product.price | money_without_currency }}</span>
        </div>
        <div class="preview-row prepaid-discount">
          <span>Prepaid Discount (10%):</span>
          <span class="discount">-₹{{ product.price | times: 0.1 | money_without_currency }}</span>
        </div>
        <div class="preview-row">
          <span>Delivery:</span>
          <span class="free">FREE</span>
        </div>
        <div class="preview-row total">
          <span>You'll pay:</span>
          <span class="total-price">₹{{ product.price | times: 0.9 | money_without_currency }}</span>
        </div>
      </div>
    </details>

    {%- comment -%} Social Proof Widget {%-endcomment-%}
    <div class="social-proof">
      <div class="proof-rating">
        <div class="stars">
          ⭐⭐⭐⭐⭐
        </div>
        <span class="rating-text">4.8★ from 234 verified buyers across India</span>
      </div>
      <div class="recent-purchase" id="recentPurchase">
        <!-- Dynamically updated via JavaScript -->
      </div>
    </div>

    {%- comment -%} Product Description Tabs {%-endcomment-%}
    <div class="product-tabs-elite">
      <div class="tabs-header sticky">
        <button class="tab-btn active" data-tab="features">Features</button>
        <button class="tab-btn" data-tab="how-to-use">How to Use</button>
        <button class="tab-btn" data-tab="reviews">Reviews</button>
        <button class="tab-btn" data-tab="faqs">FAQs</button>
      </div>
      
      <div class="tabs-content">
        <div class="tab-panel active" id="features">
          {{ product.description }}
        </div>
        <div class="tab-panel" id="how-to-use">
          <p>Easy to use in 3 simple steps...</p>
        </div>
        <div class="tab-panel" id="reviews">
          <p>Customer reviews coming soon...</p>
        </div>
        <div class="tab-panel" id="faqs">
          <p>Frequently asked questions...</p>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Smart Sticky Buy Bar {%-endcomment-%}
  <div class="sticky-buy-bar" id="stickyBar">
    <div class="sticky-content">
      <img src="{{ product.featured_image | img_url: '60x' }}" alt="{{ product.title }}" class="sticky-thumb">
      <div class="sticky-info">
        <p class="sticky-title">{{ product.title | truncate: 30 }}</p>
        <p class="sticky-price">₹{{ product.price | money_without_currency }}</p>
      </div>
      <button class="sticky-btn-prepaid" onclick="buyNow('prepaid')">
        💰 PAY NOW & SAVE 10%
      </button>
    </div>
    <div class="sticky-stock-meter">
      <div class="sticky-stock-bar">
        <div class="sticky-stock-fill" style="width: {{ stock_percent }}%"></div>
      </div>
      <span class="sticky-stock-text">Only {{ stock_percent }} left!</span>
    </div>
  </div>
</div>

<style>
/* Mobile-First Elite Product Styles */
.product-elite {
  padding: 1rem;
  max-width: 100%;
  margin: 0 auto;
}

/* Triple Urgency Stack */
.urgency-stack {
  background: linear-gradient(135deg, #FFF5E6 0%, #FFE8CC 100%);
  border-radius: 24px;
  padding: 1rem;
  margin-bottom: 1.5rem;
  border: 2px solid #FFB84D;
}

.urgency-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 0;
  color: #333;
}

.urgency-item:not(:last-child) {
  border-bottom: 1px solid rgba(255, 184, 77, 0.2);
}

.visitor-count {
  font-weight: 600;
  animation: pulse 2s infinite;
}

.visitor-number {
  color: #FF6B35;
  font-size: 1.1rem;
  font-weight: 700;
}

.stock-meter {
  flex-direction: column;
  align-items: flex-start;
}

.stock-bar {
  width: 100%;
  height: 8px;
  background: rgba(255, 107, 53, 0.2);
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 0.5rem;
}

.stock-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B35 0%, #FF8C61 100%);
  border-radius: 8px;
  animation: fillPulse 2s infinite;
}

.countdown-timer {
  font-weight: 600;
}

.timer-display {
  display: flex;
  gap: 0.5rem;
  font-size: 1.1rem;
  color: #FF6B35;
  font-weight: 700;
}

/* Product Gallery */
.product-gallery-elite {
  margin-bottom: 1.5rem;
}

.gallery-main {
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  margin-bottom: 1rem;
}

.gallery-image {
  width: 100%;
  height: auto;
  display: block;
}

.zoom-button {
  position: absolute;
  bottom: 1rem;
  right: 1rem;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  border: none;
  border-radius: 50%;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: transform 0.2s;
}

.zoom-button:active {
  transform: scale(0.95);
}

.gallery-thumbnails {
  display: flex;
  gap: 0.5rem;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.thumbnail {
  flex-shrink: 0;
  width: 60px;
  height: 60px;
  border-radius: 12px;
  overflow: hidden;
  border: 2px solid transparent;
  cursor: pointer;
  transition: border-color 0.2s;
}

.thumbnail.active {
  border-color: #FF6B35;
}

.thumbnail img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Product Info */
.product-title {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 1rem;
  line-height: 1.3;
}

.product-price-section {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1rem;
  flex-wrap: wrap;
}

.price-compare {
  text-decoration: line-through;
  color: #999;
  font-size: 1.1rem;
}

.price-current {
  font-size: 1.8rem;
  font-weight: 700;
  color: #FF6B35;
}

.price-badge {
  background: #4ECDC4;
  color: white;
  padding: 0.25rem 0.75rem;
  border-radius: 20px;
  font-size: 0.875rem;
  font-weight: 600;
}

/* Trust Badges */
.trust-badges {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}

.trust-badge {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem;
  background: rgba(78, 205, 196, 0.1);
  border-radius: 16px;
  font-size: 0.875rem;
  font-weight: 500;
  color: #333;
  animation: fadeInUp 0.5s ease-out both;
}

.trust-badge svg {
  color: #4ECDC4;
  flex-shrink: 0;
}

.india-badge {
  grid-column: 1 / -1;
  background: linear-gradient(135deg, #FF9933 0%, #138808 100%);
  color: white;
  justify-content: center;
}

/* Quantity Tiers */
.quantity-savings-section {
  margin-bottom: 1.5rem;
}

.quantity-label {
  display: block;
  font-weight: 600;
  margin-bottom: 0.75rem;
}

.quantity-tiers {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.tier-option {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 1rem;
  border: 2px solid #E0E0E0;
  border-radius: 16px;
  background: white;
  cursor: pointer;
  transition: all 0.2s;
}

.tier-option:active {
  transform: scale(0.98);
}

.tier-option.best-deal {
  border-color: #FF6B35;
  background: linear-gradient(135deg, #FFF5E6 0%, #FFE8CC 100%);
  animation: pulse 2s infinite;
}

.tier-badge {
  position: absolute;
  top: -10px;
  right: 1rem;
  background: #FF6B35;
  color: white;
  padding: 0.25rem 0.75rem;
  border-radius: 12px;
  font-size: 0.75rem;
  font-weight: 700;
}

.tier-qty {
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.tier-price {
  font-size: 1.25rem;
  font-weight: 700;
  color: #FF6B35;
}

.tier-savings {
  font-size: 0.875rem;
  color: #4ECDC4;
  font-weight: 600;
}

/* CTA Buttons */
.cta-section {
  margin-bottom: 1.5rem;
}

.btn-prepaid,
.btn-cart {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 1rem;
  border: none;
  border-radius: 16px;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.2s;
  margin-bottom: 0.75rem;
}

.btn-prepaid {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #000;
  box-shadow: 0 4px 12px rgba(255, 215, 0, 0.4);
}

.btn-cart {
  background: #FF6B35;
  color: white;
  box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3);
}

.btn-prepaid:active,
.btn-cart:active {
  transform: scale(0.98);
}

.link-cod {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.75rem;
  color: #666;
  font-weight: 600;
  text-decoration: none;
}

/* Checkout Preview */
.checkout-preview {
  background: #F5F5F5;
  border-radius: 16px;
  padding: 1rem;
  margin-bottom: 1.5rem;
}

.checkout-preview summary {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
  font-weight: 600;
  list-style: none;
}

.checkout-preview summary::-webkit-details-marker {
  display: none;
}

.preview-content {
  margin-top: 1rem;
}

.preview-row {
  display: flex;
  justify-content: space-between;
  padding: 0.5rem 0;
  border-bottom: 1px solid #E0E0E0;
}

.preview-row:last-child {
  border-bottom: none;
}

.preview-row.total {
  font-weight: 700;
  font-size: 1.1rem;
  padding-top: 1rem;
  margin-top: 0.5rem;
  border-top: 2px solid #333;
}

.discount {
  color: #4ECDC4;
  font-weight: 600;
}

.free {
  color: #4ECDC4;
  font-weight: 600;
}

.total-price {
  color: #FF6B35;
  font-size: 1.3rem;
}

