{% comment %}
  Product Delivery Section
  Delivery timeline and COD/returns reassurance
{% endcomment %}

<section class="product-delivery">
  <div class="container">
    <h2 class="section-title animate-on-scroll" data-animation="fade-in-up">
      Delivery & Returns
    </h2>

    <div class="trust-signals animate-on-scroll" data-animation="fade-in-up">
      <div class="trust-badge">
        <div class="trust-icon">📦</div>
        <h4 class="trust-title">Delivery Timeline</h4>
        <p class="trust-text">{{ section.settings.delivery_text | default: '3-7 Days Delivery' }}</p>
      </div>

      <div class="trust-badge">
        <div class="trust-icon">💰</div>
        <h4 class="trust-title">Cash on Delivery</h4>
        <p class="trust-text">{{ section.settings.cod_text | default: 'Pay when you receive the product' }}</p>
      </div>

      <div class="trust-badge">
        <div class="trust-icon">🔄</div>
        <h4 class="trust-title">Easy Returns</h4>
        <p class="trust-text">{{ section.settings.returns_text | default: '7 days easy returns policy' }}</p>
      </div>

      <div class="trust-badge">
        <div class="trust-icon">🎁</div>
        <h4 class="trust-title">Quality Guaranteed</h4>
        <p class="trust-text">{{ section.settings.quality_text | default: '100% satisfaction guaranteed' }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Delivery",
  "settings": [
    {
      "type": "text",
      "id": "delivery_text",
      "label": "Delivery Text",
      "default": "3-7 Days Delivery"
    },
    {
      "type": "text",
      "id": "cod_text",
      "label": "COD Text",
      "default": "Pay when you receive the product"
    },
    {
      "type": "text",
      "id": "returns_text",
      "label": "Returns Text",
      "default": "7 days easy returns policy"
    },
    {
      "type": "text",
      "id": "quality_text",
      "label": "Quality Text",
      "default": "100% satisfaction guaranteed"
    }
  ],
  "presets": [
    {
      "name": "Product Delivery"
    }
  ]
}
{% endschema %}
