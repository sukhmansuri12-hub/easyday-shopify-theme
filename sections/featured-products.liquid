{% comment %}
  Featured Products Section
  Displays selected collection products in grid
{% endcomment %}

<section class="section-padding" style="padding-top: 20px !important; position: relative; overflow: hidden;">
  <div class="container">
    <!-- Decorative Background Lines -->
    <svg class="decorative-lines" xmlns="http://www.w3.org/2000/svg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; opacity: 0.06; pointer-events: none;">
      <path d="M 0 150 Q 150 100, 300 150 T 600 150" stroke="#FF6F00" stroke-width="2" fill="none"/>
      <path d="M 100 250 Q 250 200, 400 250 T 700 250" stroke="#00C853" stroke-width="2" fill="none"/>
      <path d="M 50 350 Q 200 300, 350 350 T 650 350" stroke="#2196F3" stroke-width="1.5" fill="none"/>
    </svg>
    
    {%- if section.settings.heading != blank -%}
      <h2 class="section-title animate-on-scroll" data-animation="fade-in-up" style="position: relative; z-index: 1;">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- assign collection = collections[section.settings.collection] -%}
    
    {%- if collection != blank and collection.products.size > 0 -%}
<div class="product-grid featured-products-mock">
    
        <!-- Product 1: Vegetable Chopper -->
        <div class="product-card animate-on-scroll" data-animation="scale-in">
             <div class="product-image-wrapper">
                <span class="badge-sale">50% OFF</span>
                <button class="quick-add-btn" onclick="quickAddToCart('vegetable-chopper')">+</button>
                <img src="https://m.media-amazon.com/images/I/61Sgd-b9D-L._SL1500_.jpg" alt="12-in-1 Vegetable Chopper" class="product-image">
             </div>
             <div class="product-info">
                <h3 class="product-title">12-in-1 Vegetable Chopper</h3>
                <div class="price-container">
                    <span class="current-price">₹899.00</span>
                    <span class="original-price">₹1,799.00</span>
                </div>
                <!-- Fake Add to Cart for Visuals -->
                <button class="btn-atc-mock">ADD TO CART</button>
             </div>
             <a href="/products/vegetable-chopper" class="product-link-overlay"></a>
        </div>

        <!-- Product 2: Knee Sleeves -->
        <div class="product-card animate-on-scroll" data-animation="scale-in" style="animation-delay: 0.1s">
             <div class="product-image-wrapper">
                <span class="badge-sale">HOT</span>
                <button class="quick-add-btn" onclick="quickAddToCart('bamboo-knee-sleeves')">+</button>
                <img src="https://m.media-amazon.com/images/I/71qY+2x3jXL._SL1500_.jpg" alt="Bamboo Knee Sleeves (Pair)" class="product-image">
             </div>
             <div class="product-info">
                <h3 class="product-title">Bamboo Knee Sleeves (Pair)</h3>
                <div class="price-container">
                    <span class="current-price">₹699.00</span>
                    <span class="original-price">₹1,499.00</span>
                </div>
                <button class="btn-atc-mock">ADD TO CART</button>
             </div>
             <a href="/products/bamboo-knee-sleeves" class="product-link-overlay"></a>
        </div>

        <!-- Product 3: Austrian Diamond Necklace -->
        <div class="product-card animate-on-scroll" data-animation="scale-in" style="animation-delay: 0.2s">
             <div class="product-image-wrapper">
                 <span class="badge-sale">PREMIUM</span>
                <button class="quick-add-btn" onclick="quickAddToCart('austrian-diamond-necklace')">+</button>
                <img src="https://m.media-amazon.com/images/I/71Wj+Zc2b+L._UY695_.jpg" alt="Austrian Diamond Necklace Set" class="product-image">
             </div>
             <div class="product-info">
                <h3 class="product-title">Austrian Diamond Necklace Set</h3>
                <div class="price-container">
                    <span class="current-price">₹1,299.00</span>
                    <span class="original-price">₹2,999.00</span>
                </div>
                <button class="btn-atc-mock">ADD TO CART</button>
             </div>
             <a href="/products/austrian-diamond-necklace" class="product-link-overlay"></a>
        </div>

        <!-- Product 4: RC Stunt Car -->
        <div class="product-card animate-on-scroll" data-animation="scale-in" style="animation-delay: 0.3s">
             <div class="product-image-wrapper">
                <span class="badge-sale">KIDS LOVE</span>
                <button class="quick-add-btn" onclick="quickAddToCart('rc-stunt-car')">+</button>
                <img src="https://m.media-amazon.com/images/I/61N+0n8kLpL._SL1000_.jpg" alt="RC Stunt Car 360°" class="product-image">
             </div>
             <div class="product-info">
                <h3 class="product-title">RC Stunt Car 360° Drift</h3>
                <div class="price-container">
                    <span class="current-price">₹1,499.00</span>
                    <span class="original-price">₹3,499.00</span>
                </div>
                <button class="btn-atc-mock">ADD TO CART</button>
             </div>
              <a href="/products/rc-stunt-car" class="product-link-overlay"></a>
        </div>

      </div>
  </div>
</section>

<style>
    .featured-products-mock {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
        padding: 0 15px;
    }
    .product-card {
        background: white;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #eee;
        position: relative;
    }
    .product-image-wrapper {
        position: relative;
        padding-top: 100%; /* 1:1 Aspect Ratio */
        background: #f4f4f4;
    }
    .product-image {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;
    }
    .product-info { padding: 10px; text-align: left; }
    .product-title {
        font-size: 0.9rem;
        font-weight: 500;
        margin-bottom: 5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .price-container {
        display: flex; gap: 8px; align-items: center; margin-bottom: 8px;
    }
    .current-price { font-weight: bold; color: #333; }
    .original-price { text-decoration: line-through; color: #999; font-size: 0.85rem; }
    
    .badge-sale {
        position: absolute; top: 8px; left: 8px;
        background: #d32f2f; color: white;
        font-size: 0.7rem; font-weight: bold;
        padding: 2px 6px; border-radius: 4px;
        z-index: 2;
    }
    .btn-atc-mock {
        width: 100%;
        background: #ff6f00; color: white;
        border: none; padding: 8px;
        font-weight: bold; border-radius: 4px;
        font-size: 0.8rem;
    }
    .product-link-overlay {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 10;
    }
    
    /* Quick Add Plus Button */
    .quick-add-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #FF6F00 0%, #FF8F00 100%);
        color: white;
        border: none;
        font-size: 24px;
        font-weight: bold;
        cursor: pointer;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        box-shadow: 0 2px 8px rgba(255, 111, 0, 0.4);
        transition: all 0.3s ease;
    }
    
    .quick-add-btn:hover {
        transform: scale(1.1) rotate(90deg);
        box-shadow: 0 4px 12px rgba(255, 111, 0, 0.6);
    }
    
    .quick-add-btn:active {
        transform: scale(0.95);
    }
</style>

<script>
function quickAddToCart(productHandle) {
  // Prevent link click
  event.stopPropagation();
  event.preventDefault();
  
  // Show loading feedback
  const btn = event.target;
  const originalText = btn.textContent;
  btn.textContent = '⏳';
  btn.disabled = true;
  
  // First, get the product to find its variant ID
  fetch(`/products/${productHandle}.js`)
    .then(response => {
      if (!response.ok) {
        throw new Error('Product not found');
      }
      return response.json();
    })
    .then(product => {
      // Get the first available variant
      const variant = product.variants.find(v => v.available) || product.variants[0];
      
      if (!variant) {
        throw new Error('No variants available');
      }
      
      // Add to cart using variant ID
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          items: [{
            id: variant.id,
            quantity: 1
          }]
        })
      });
    })
    .then(response => response.json())
    .then(data => {
      // Success! Show checkmark
      btn.textContent = '✓';
      btn.style.background = '#00C853';
      
      // Update cart count
      fetch('/cart.js')
        .then(r => r.json())
        .then(cart => {
          const cartCount = document.querySelector('.cart-count');
          if (cartCount) {
            cartCount.textContent = cart.item_count;
            cartCount.style.display = cart.item_count > 0 ? 'flex' : 'none';
          }
          
          // Automatically open cart drawer
          setTimeout(() => {
            const cartDrawer = document.getElementById('cart-drawer');
            const cartBackdrop = document.getElementById('cart-backdrop');
            if (cartDrawer && cartBackdrop) {
              cartDrawer.classList.add('open');
              cartBackdrop.classList.add('open');
              // Trigger cart reload
              if (window.loadCartItems) {
                window.loadCartItems();
              }
            }
          }, 300);
        });
      
      // Reset button after 1.5 seconds
      setTimeout(() => {
        btn.textContent = originalText;
        btn.style.background = 'linear-gradient(135deg, #FF6F00 0%, #FF8F00 100%)';
        btn.disabled = false;
      }, 1500);
    })
    .catch((error) => {
      console.error('Error adding to cart:', error);
      // Product doesn't exist in Shopify yet - redirect to product page
      btn.textContent = '→';
      setTimeout(() => {
        window.location.href = `/products/${productHandle}`;
      }, 500);
    });
}
</script>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
