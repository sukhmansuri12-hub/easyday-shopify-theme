{% comment %}
  Header Section - FIXED Hamburger Menu
{% endcomment %}

<header class="site-header">
  <div class="container header-container">
    
    {% comment %} Mobile Menu Toggle (Hamburger) - LEFT {% endcomment %}
    <div class="mobile-menu-toggle" id="hamburger-btn">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </div>

    {% comment %} Logo - CENTER {% endcomment %}
    <div class="header-logo">
      <a href="{{ routes.root_url }}">
          <img src="{{ 'brand-logo.png' | asset_url }}" alt="{{ shop.name }}" width="100%" height="auto" loading="eager">
      </a>
    </div>

    {% comment %} Icons - RIGHT {% endcomment %}
    <div class="header-icons">
      <a href="{{ routes.search_url }}" class="header-icon search-icon" aria-label="Search">
        {% render 'icon-search' %}
      </a>
      
      {%- if shop.customer_accounts_enabled -%}
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header-icon account-icon" aria-label="Account">
          {% render 'icon-account' %}
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="header-icon cart-icon" id="cart-icon-bubble" aria-label="Cart">
        {% render 'icon-cart' %}
        <span class="cart-count" style="display: {% if cart.item_count > 0 %}flex{% else %}none{% endif %};">{{ cart.item_count }}</span>
      </a>
    </div>

  </div>
</header>

{% comment %} Backdrop Overlay {% endcomment %}
<div id="menu-backdrop" style="position: fixed; top: 0; left: 0; width: 100%; height: 100vh; background: rgba(0,0,0,0.6); z-index: 999998; opacity: 0; pointer-events: none; transition: opacity 0.3s ease;"></div>

{% comment %} Mobile Menu Drawer - SLIDE FROM RIGHT {% endcomment %}
<div id="mobile-drawer" style="position: fixed; top: 0; right: -100%; width: 300px; max-width: 85%; height: 100vh; background: white; z-index: 999999; box-shadow: -2px 0 20px rgba(0,0,0,0.15); transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1); overflow-y: auto;">
    {% comment %} Header with Close Button {% endcomment %}
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 25px 20px; border-bottom: 1px solid #f0f0f0;">
        <h3 style="margin: 0; font-size: 1.3rem; font-weight: 700; color: #222;">Menu</h3>
        <button id="close-drawer" style="background: none; border: none; font-size: 2.5rem; cursor: pointer; line-height: 1; color: #666; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 50%; transition: all 0.2s ease;" onmouseover="this.style.background='#f5f5f5'; this.style.color='#ff6f00';" onmouseout="this.style.background='none'; this.style.color='#666';">&times;</button>
    </div>
    
    {% comment %} Menu Links {% endcomment %}
    <nav style="padding: 10px 0;">
      <a href="{{ routes.root_url }}" style="display: block; padding: 16px 24px; text-decoration: none; color: #333; font-size: 1rem; font-weight: 500; border-bottom: 1px solid #f8f8f8; transition: all 0.2s ease;" onmouseover="this.style.background='#fff5ec'; this.style.color='#ff6f00'; this.style.paddingLeft='32px';" onmouseout="this.style.background='white'; this.style.color='#333'; this.style.paddingLeft='24px';">🏠 Home</a>
      
      <a href="/#featured-products" id="featured-link" style="display: block; padding: 16px 24px; text-decoration: none; color: #333; font-size: 1rem; font-weight: 500; border-bottom: 1px solid #f8f8f8; transition: all 0.2s ease;" onmouseover="this.style.background='#fff5ec'; this.style.color='#ff6f00'; this.style.paddingLeft='32px';" onmouseout="this.style.background='white'; this.style.color='#333'; this.style.paddingLeft='24px';">⭐ Featured Products</a>
      
      <a href="/pages/toys-gifts" style="display: block; padding: 16px 24px; text-decoration: none; color: #333; font-size: 1rem; font-weight: 500; border-bottom: 1px solid #f8f8f8; transition: all 0.2s ease;" onmouseover="this.style.background='#fff5ec'; this.style.color='#ff6f00'; this.style.paddingLeft='32px';" onmouseout="this.style.background='white'; this.style.color='#333'; this.style.paddingLeft='24px';">🎁 Toys & Gifts</a>
      
      <a href="/pages/home-kitchen" style="display: block; padding: 16px 24px; text-decoration: none; color: #333; font-size: 1rem; font-weight: 500; border-bottom: 1px solid #f8f8f8; transition: all 0.2s ease;" onmouseover="this.style.background='#fff5ec'; this.style.color='#ff6f00'; this.style.paddingLeft='32px';" onmouseout="this.style.background='white'; this.style.color='#333'; this.style.paddingLeft='24px';">🏡 Home & Kitchen</a>
      
      <a href="/pages/clothing-accessories" style="display: block; padding: 16px 24px; text-decoration: none; color: #333; font-size: 1rem; font-weight: 500; border-bottom: 1px solid #f8f8f8; transition: all 0.2s ease;" onmouseover="this.style.background='#fff5ec'; this.style.color='#ff6f00'; this.style.paddingLeft='32px';" onmouseout="this.style.background='white'; this.style.color='#333'; this.style.paddingLeft='24px';">👕 Clothing & Accessories</a>
      
      <a href="/pages/personal-care-wellness" style="display: block; padding: 16px 24px; text-decoration: none; color: #333; font-size: 1rem; font-weight: 500; border-bottom: 1px solid #f8f8f8; transition: all 0.2s ease;" onmouseover="this.style.background='#fff5ec'; this.style.color='#ff6f00'; this.style.paddingLeft='32px';" onmouseout="this.style.background='white'; this.style.color='#333'; this.style.paddingLeft='24px';">💆 Personal Care & Wellness</a>
      
      <a href="/collections/all" style="display: block; padding: 16px 24px; text-decoration: none; color: #333; font-size: 1rem; font-weight: 600; background: linear-gradient(135deg, #fff5ec 0%, #ffe8d6 100%); color: #ff6f00; border-bottom: none;">📦 View All Products</a>
    </nav>
</div>

<script>
  // Global cart count update function
  window.updateCartCount = function() {
    fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        const cartCount = document.querySelector('.cart-count');
        if (cartCount) {
          cartCount.textContent = cart.item_count;
          cartCount.style.display = cart.item_count > 0 ? 'flex' : 'none';
        }
      })
      .catch(error => console.error('Error updating cart count:', error));
  };

  window.addEventListener('load', function() {
    const hamburger = document.getElementById('hamburger-btn');
    const drawer = document.getElementById('mobile-drawer');
    const closeBtn = document.getElementById('close-drawer');
    const backdrop = document.getElementById('menu-backdrop');
    const featuredLink = document.getElementById('featured-link');
    
    function openDrawer() {
      if (drawer && backdrop) {
        drawer.style.right = '0';
        backdrop.style.opacity = '1';
        backdrop.style.pointerEvents = 'auto';
      }
    }
    
    function closeDrawer() {
      if (drawer && backdrop) {
        drawer.style.right = '-100%';
        backdrop.style.opacity = '0';
        backdrop.style.pointerEvents = 'none';
      }
    }
    
    if (hamburger) {
      hamburger.addEventListener('click', openDrawer);
    }
    
    if (closeBtn) {
      closeBtn.addEventListener('click', closeDrawer);
    }
    
    // Close when clicking backdrop
    if (backdrop) {
      backdrop.addEventListener('click', closeDrawer);
    }
    
    // Handle Featured Products link
    if (featuredLink) {
      featuredLink.addEventListener('click', function(e) {
        const isHomepage = window.location.pathname === '/' || window.location.pathname === '';
        
        if (isHomepage) {
          e.preventDefault();
          const target = document.querySelector('#featured-products');
          if (target) {
            closeDrawer();
            setTimeout(function() {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 300);
          }
        } else {
          closeDrawer();
        }
      });
    }
  });
  
  // Update cart count on browser back/forward
  window.addEventListener('pageshow', function(event) {
    if (event.persisted || performance.getEntriesByType("navigation")[0].type === "back_forward") {
      // Update cart count when user navigates back
      if (window.updateCartCount) {
        window.updateCartCount();
      }
    }
  });
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 150,
      "unit": "px",
      "label": "Custom logo width"
    }
  ]
}
{% endschema %}
