{% comment %}
  Header Section - FIXED Hamburger Menu
{% endcomment %}

<header class="site-header">
  <div class="container header-container">
    
    {% comment %} Mobile Menu Toggle (Hamburger) - LEFT {% endcomment %}
    <div class="mobile-menu-toggle" id="hamburger-btn">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </div>

    {% comment %} Logo - CENTER {% endcomment %}
    <div class="header-logo">
      <a href="{{ routes.root_url }}">
          <img src="{{ 'brand-logo.png' | asset_url }}" alt="{{ shop.name }}" width="100%" height="auto" loading="eager">
      </a>
    </div>

    {% comment %} Icons - RIGHT {% endcomment %}
    <div class="header-icons">
      <a href="{{ routes.search_url }}" class="header-icon search-icon" aria-label="Search">
        {% render 'icon-search' %}
      </a>
      
      {%- if shop.customer_accounts_enabled -%}
        <a href="#" class="header-icon account-icon" aria-label="Account" id="login-icon" onclick="event.preventDefault(); openLoginModal();">
          {% render 'icon-account' %}
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="header-icon cart-icon" id="cart-icon-bubble" aria-label="Cart">
        {% render 'icon-cart' %}
        {%- if cart.item_count > 0 -%}
          <span class="cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>

  </div>
</header>

{% comment %} Backdrop Overlay {% endcomment %}
<div id="menu-backdrop" style="position: fixed; top: 0; left: 0; width: 100%; height: 100vh; background: rgba(0,0,0,0.5); z-index: 999998; opacity: 0; pointer-events: none; transition: opacity 0.3s ease;"></div>

{% comment %} Mobile Menu Drawer {% endcomment %}
<div id="mobile-drawer" style="position: fixed; top: 0; left: -100%; width: auto; max-width: 85%; height: 100vh; background: white; z-index: 999999; box-shadow: 2px 0 10px rgba(0,0,0,0.1); transition: left 0.3s ease;">
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 20px; border-bottom: 1px solid #eee;">
        <h3 style="margin: 0; font-size: 1.2rem; font-weight: 600;">Menu</h3>
        <span id="close-drawer" style="font-size: 2rem; cursor: pointer; line-height: 1; color: #333;">&times;</span>
    </div>
    <div style="padding: 10px 0;">
      <a href="{{ routes.root_url }}" style="display: block; padding: 15px 20px; text-decoration: none; color: #333; font-size: 0.95rem; font-weight: 500; border-bottom: 1px solid #f5f5f5; white-space: nowrap;">HOME PAGE</a>
      <a href="/#featured-products" id="featured-link" style="display: block; padding: 15px 20px; text-decoration: none; color: #333; font-size: 0.95rem; font-weight: 500; border-bottom: 1px solid #f5f5f5; white-space: nowrap;">FEATURED PRODUCTS</a>
      <a href="/pages/toys-gifts" style="display: block; padding: 15px 20px; text-decoration: none; color: #333; font-size: 0.95rem; font-weight: 500; border-bottom: 1px solid #f5f5f5; white-space: nowrap;">TOYS & GIFTS</a>
      <a href="/pages/home-kitchen" style="display: block; padding: 15px 20px; text-decoration: none; color: #333; font-size: 0.95rem; font-weight: 500; border-bottom: 1px solid #f5f5f5; white-space: nowrap;">HOME & KITCHEN</a>
      <a href="/pages/clothing-accessories" style="display: block; padding: 15px 20px; text-decoration: none; color: #333; font-size: 0.95rem; font-weight: 500; border-bottom: 1px solid #f5f5f5; white-space: nowrap;">CLOTHING & ACCESSORIES</a>
      <a href="/pages/personal-care-wellness" style="display: block; padding: 15px 20px; text-decoration: none; color: #333; font-size: 0.95rem; font-weight: 500; border-bottom: 1px solid #f5f5f5; white-space: nowrap;">PERSONAL CARE & WELLNESS</a>
      <a href="/collections/all" style="display: block; padding: 15px 20px; text-decoration: none; color: #333; font-size: 0.95rem; font-weight: 500; white-space: nowrap;">CATALOG</a>
    </div>
</div>

<script>
  window.addEventListener('load', function() {
    const hamburger = document.getElementById('hamburger-btn');
    const drawer = document.getElementById('mobile-drawer');
    const closeBtn = document.getElementById('close-drawer');
    const backdrop = document.getElementById('menu-backdrop');
    const featuredLink = document.getElementById('featured-link');
    
    function openDrawer() {
      if (drawer && backdrop) {
        drawer.style.left = '0';
        backdrop.style.opacity = '1';
        backdrop.style.pointerEvents = 'auto';
      }
    }
    
    function closeDrawer() {
      if (drawer && backdrop) {
        drawer.style.left = '-100%';
        backdrop.style.opacity = '0';
        backdrop.style.pointerEvents = 'none';
      }
    }
    
    if (hamburger) {
      hamburger.addEventListener('click', openDrawer);
    }
    
    if (closeBtn) {
      closeBtn.addEventListener('click', closeDrawer);
    }
    
    // Close when clicking backdrop
    if (backdrop) {
      backdrop.addEventListener('click', closeDrawer);
    }
    
    // Handle Featured Products link
    if (featuredLink) {
      featuredLink.addEventListener('click', function(e) {
        const isHomepage = window.location.pathname === '/' || window.location.pathname === '';
        
        if (isHomepage) {
          e.preventDefault();
          const target = document.querySelector('#featured-products');
          if (target) {
            closeDrawer();
            setTimeout(function() {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 300);
          }
        } else {
          closeDrawer();
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 150,
      "unit": "px",
      "label": "Custom logo width"
    }
  ]
}
{% endschema %}
