{% comment %}
  Sink Splash Guard Product Section - MANUAL BUTTON INJECT
{% endcomment %}

<section class="product-page-rc-car">
  <div class="product-image-gallery">
    <div class="gallery-container">
      {% for image in product.images %}
        <div class="slide">
          <img src="{{ image | img_url: '600x600', crop: 'center' }}" alt="{{ product.title }}" loading="lazy">
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="product-info-section">
    <h1 class="product-title-rc">{{ product.title }}</h1>
    
    <div class="price-section-rc">
      <span class="current-price-rc">{{ product.price | money }}</span>
      <span class="compare-price-rc">{{ product.compare_at_price | money }}</span>
    </div>

    {% form 'product', product, id: 'product-form-splash' %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="variant-id-input">
      
      <div class="buy-buttons-wrapper">
        <button class="btn-buy-prepaid" type="button" onclick="buyNowPrepaid()">
          ADD TO CART - PAY ONLINE 10% OFF
        </button>
        
        <style>
          .btn-buy-now-final {
            display: block;
            width: 100%;
            background: #1a56db;
            color: #fff;
            padding: 16px;
            border: none;
            border-radius: 8px;
            font-size: 1.2rem;
            font-weight: 800;
            margin-top: 15px;
            cursor: pointer;
            text-align: center;
          }
          .payment-logos { margin-top: 5px; display: flex; justify-content: center; gap: 10px; }
          .pay-logo { height: 18px; filter: brightness(0) invert(1); }
        </style>
        
        <button class="btn-buy-now-final" type="button" onclick="buyNowDirect()">
          BUY NOW
          <div class="payment-logos">
             <span style="font-size: 10px;">GPay | UPI | Paytm</span>
          </div>
        </button>

        <script>
          function buyNowDirect() {
            const id = document.getElementById('variant-id-input').value;
            fetch('/cart/clear.js', { method: 'POST' })
              .then(() => fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: id, quantity: 1 })
              }))
              .then(() => { window.location.href = '/checkout'; });
          }
          function buyNowPrepaid() {
             const id = document.getElementById('variant-id-input').value;
             fetch('/cart/add.js', {
               method: 'POST',
               headers: { 'Content-Type': 'application/json' },
               body: JSON.stringify({ id: id, quantity: 1 })
             }).then(() => { window.location.href = '/cart'; });
          }
        </script>
      </div>
    {% endform %}
  </div>

  <style>
    .product-page-rc-car { padding: 20px; font-family: sans-serif; }
    .product-title-rc { font-size: 1.5rem; margin-bottom: 10px; }
    .price-section-rc { margin-bottom: 20px; display: flex; gap: 10px; font-size: 1.2rem; }
    .current-price-rc { color: #d32f2f; font-weight: bold; }
    .compare-price-rc { text-decoration: line-through; color: #777; }
    .btn-buy-prepaid { width: 100%; padding: 12px; background: #000; color: #fff; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; }
  </style>
</section>
