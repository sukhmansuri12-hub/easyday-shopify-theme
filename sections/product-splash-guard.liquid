{% comment %}
  Splash Guard - Product Page  
  Mobile-First Design
{% endcomment %}

<section class="product-page-rc-car">
  {% render 'product-page-desktop.css' %}
  
  {% comment %} Mobile Image Gallery - Swipeable {% endcomment %}
  <div class="product-image-gallery">
    <div class="gallery-container" id="gallery-container">
      {% for image in product.images %}
        <div class="slide"><img src="{{ image | img_url: 'master' }}" alt="{{ product.title }}"></div>
      {% endfor %}
    </div>
    <div class="gallery-dots">
      {% for image in product.images %}
        <span class="dot {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index0 }}"></span>
      {% endfor %}
    </div>
  </div>

  {% comment %} Product Info {% endcomment %}
  <div class="product-info-section">
    
    <h1 class="product-title-rc">{{ product.title }}</h1>
    
    <div class="product-rating-rc">
      <span style="display:inline-flex; align-items:baseline;">⭐⭐⭐⭐<span style="width:14px;overflow:hidden;">⭐</span></span>
      <span class="rating-count">4.8 (520+ Reviews)</span>
    </div>

    {% comment %} Countdown Timer {% endcomment %}
    <div class="countdown-timer-rc">
      <span class="timer-label">⏰ Offer Ends in</span>
      <div class="timer-display">
        <div class="time-box"><span id="days">00</span><span class="label">Days</span></div>
        <div class="time-box"><span id="hours">23</span><span class="label">Hours</span></div>
        <div class="time-box"><span id="mins">59</span><span class="label">Minutes</span></div>
        <div class="time-box"><span id="secs">52</span><span class="label">Seconds</span></div>
      </div>
    </div>

    {% comment %} BUY 1 GET 1 FREE Badge {% endcomment %}
    <div style="background: linear-gradient(135deg, #FF6F00 0%, #FF8F00 100%); color: white; padding: 12px 20px; border-radius: 12px; margin: 15px 0; text-align: center; box-shadow: 0 4px 15px rgba(255,111,0,0.3); animation: pulse 2s ease-in-out infinite;">
      <span style="font-size: 1.4rem; font-weight: 700; display: block; line-height: 1.2;">🎁 BUY 1 GET 1 FREE</span>
      <span style="font-size: 0.9rem; opacity: 0.95; display: block; margin-top: 4px;">Limited Time Offer!</span>
    </div>

    {% comment %} Price {% endcomment %}
    <div class="price-section-rc">
      <div class="current-price-rc">{{ product.price | money }}</div>
      {% if product.compare_at_price > product.price %}
        <div class="compare-price-rc">{{ product.compare_at_price | money }}</div>
        {% assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
        <div class="save-badge-rc">SAVE {{ savings }}%</div>
      {% endif %}
    </div>


    {% comment %} Variant Selector - Only show if multiple variants {% endcomment %}
    {% if product.variants.size > 1 %}
    <div class="variant-selector-rc">
      <div class="variant-options-rc">
        {% for variant in product.variants %}
          <label class="variant-option-rc {% if forloop.first %}active{% endif %}" data-variant-id="{{ variant.id }}" data-variant-price="{{ variant.price }}">
            <input type="radio" name="variant-select" value="{{ variant.id }}" {% if forloop.first %}checked{% endif %}>
            <div class="variant-content">
              <span class="variant-title">{{ variant.title }}</span>
              <span class="variant-price">{{ variant.price | money }}</span>
              {% if variant.compare_at_price > variant.price %}
                <span class="variant-save">Save ₹{{ variant.compare_at_price | minus: variant.price | divided_by: 100 }}</span>
              {% endif %}
            </div>
          </label>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% comment %} Shopify Product Form {% endcomment %}
    {% form 'product', product, id: 'product-form-installment' %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="variant-id-input">
      
      {% comment %} Buy Buttons {% endcomment %}
      <div class="buy-section-rc">
        <button class="btn-buy-prepaid-rc" type="button" onclick="buyNowPrepaid()">
          <span class="main-text-prepaid">Add to cart</span>
          <span class="sub-text-prepaid">PAY ONLINE — SAVE 10%</span>
        </button>
        {% render 'buy-now-button' %}
      </div>
    {% endform %}

  </div>

  {% comment %} Description {% endcomment %}
  <div class="product-description-rc">
    
    <div style="text-align: center; margin-bottom: 30px;">
      <img src="{{ 'trust-badges.png' | asset_url }}" alt="Free Shipping, No-Hassle Returns, Satisfaction Guaranteed, Secure Checkout" style="max-width: 100%; height: auto;">
    </div>
    
    {%- if product.description != blank -%}
      {{ product.description }}
    {%- else -%}
      <div class="desc-block-rc">
        <h3>💦 STOP THE SPLASH. STAY DRY.</h3>
        <p>Tired of wet shirts and messy countertops? This splash guard blocks water right at the sink edge, keeping splashes contained so you can wash dishes, fruit, or your hands without the mess.</p>
      </div>

      <div class="desc-block-rc">
        <h3>⚡ Smart Design, Secure Fit</h3>
        <p>Made from flexible, durable silicone, this splash guard locks into place with strong suction cups and removes just as easily—no tools, no residue, no hassle.</p>
      </div>

      <div class="desc-block-rc">
        <h3>✨ A Cleaner Kitchen, Washroom Every Time</h3>
        <p>A universal fit makes it perfect for kitchen and bathroom sinks, keeping counters dry and splash-free for everyday use or guests.</p>
      </div>
    {%- endif -%}

  </div>

  {% comment %} Reviews {% endcomment %}
  <div class="reviews-section-rc">
    <h2 class="reviews-title">Customer Reviews</h2>
    <div style="display:flex;align-items:center;gap:10px;margin-top:10px;margin-bottom:20px;">
      <span style="display:inline-flex; align-items:baseline; font-size:1.5rem;">⭐⭐⭐⭐<span style="width:12px;overflow:hidden;">⭐</span></span>
      <span style="font-size:1.1rem;color:#666;font-weight:600;">4.8 (520+ Reviews)</span>
    </div>
    
    <div class="review-card">
      <div class="reviewer-info">
        <strong>Priya Sharma</strong> <span class="verified">✓ Verified Purchase</span>
      </div>
      <div class="review-stars">⭐⭐⭐⭐⭐</div>
      <p class="review-text">This splash guard is amazing! No more water all over my counter. Easy to install and stays in place perfectly!</p>
      <div class="review-images">
        <img src="https://cdn.shopify.com/s/files/1/0800/9229/9512/files/Customer_review2.jpg?v=1769981049" alt="Customer review photo" style="width: 100%; max-width: 300px; border-radius: 8px; margin-top: 10px;">
      </div>
    </div>

    <div class="review-card">
      <div class="reviewer-info">
        <strong>Rajesh Kumar</strong> <span class="verified">✓ Verified Purchase</span>
      </div>
      <div class="review-stars">⭐⭐⭐⭐⭐</div>
      <p class="review-text">Very practical! Keeps my kitchen dry. The suction cups are strong and it's easy to clean.</p>
    </div>

    <div class="review-card">
      <div class="reviewer-info">
        <strong>Anjali Desai</strong> <span class="verified">✓ Verified Purchase</span>
      </div>
      <div class="review-stars">⭐⭐⭐⭐⭐</div>
      <p class="review-text">Love it! Perfect for washing vegetables. No more wet clothes!</p>
      <div class="review-images">
        <img src="https://cdn.shopify.com/s/files/1/0800/9229/9512/files/cusotmer_review_5.jpg?v=1769981145" alt="Customer review photo" style="width: 100%; max-width: 300px; border-radius: 8px; margin-top: 10px;">
      </div>
    </div>

    <div class="review-card">
      <div class="reviewer-info">
        <strong>Vikram Patel</strong> <span class="verified">✓ Verified Purchase</span>
      </div>
      <div class="review-stars">⭐⭐⭐⭐⭐</div>
      <p class="review-text">Perfect for a dry countertop, highly recommend! My wife loves it. No more mess around the sink.</p>
    </div>

    <div class="review-card">
      <div class="reviewer-info">
        <strong>Neha Gupta</strong> <span class="verified">✓ Verified Purchase</span>
      </div>
      <div class="review-stars">⭐⭐⭐⭐⭐</div>
      <p class="review-text">Game changer! Fits perfectly on my sink. The water stays where it should. Worth every rupee!</p>
      <div class="review-images">
        <img src="https://cdn.shopify.com/s/files/1/0800/9229/9512/files/Customer_review.jpg?v=1769981048" alt="Customer review photo" style="width: 100%; max-width: 300px; border-radius: 8px; margin-top: 10px;">
      </div>
    </div>

    <div class="review-card">
      <div class="reviewer-info">
        <strong>Arjun Singh</strong> <span class="verified">✓ Verified Purchase</span>
      </div>
      <div class="review-stars">⭐⭐⭐⭐⭐</div>
      <p class="review-text">Excellent product! Easy to remove and clean. Keeps the bathroom and kitchen counters completely dry. Highly satisfied!</p>
    </div>

  </div>

  {% comment %} Final CTA Button {% endcomment %}
  <div style="text-align:center; padding:10px 20px 25px 20px; background:#fff; margin:0;">
    <button onclick="scrollToTop()" class="cta-shake-button" style="background:linear-gradient(135deg, #FF6F00 0%, #FF8F00 100%); color:white; border:none; padding:18px 50px; font-size:1.2rem; font-weight:700; border-radius:50px; cursor:pointer; box-shadow:0 4px 15px rgba(255,111,0,0.4); text-transform:uppercase; margin:0;">
      💦 GET YOURS NOW
    </button>
  </div>

  <style>
    
    /* Variant Selector Styles */
    .variant-selector-rc {
      margin: 20px 0;
    }
    
    .variant-options-rc {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    
    .variant-option-rc {
      position: relative;
      display: block;
      border: 2px solid #e0e0e0;
      border-radius: 12px;
      padding: 15px;
      cursor: pointer;
      transition: all 0.3s;
      background: white;
    }
    
    .variant-option-rc input[type="radio"] {
      position: absolute;
      opacity: 0;
    }
    
    .variant-option-rc:hover {
      border-color: #FF6F00;
      box-shadow: 0 2px 10px rgba(255,111,0,0.2);
    }
    
    .variant-option-rc.active {
      border-color: #FF6F00;
      background: linear-gradient(135deg, #fff5e6 0%, #ffe0cc 100%);
      box-shadow: 0 4px 15px rgba(255,111,0,0.3);
    }
    
    .variant-content {
      display: flex;
      flex-direction: column;
      gap: 5px;
      text-align: center;
    }
    
    .variant-title {
      font-weight: 700;
      font-size: 1.05rem;
      color: #333;
    }
    
    .variant-price {
      font-size: 1.3rem;
      font-weight: 700;
      color: #00C853;
    }
    
    .variant-save {
      font-size: 0.85rem;
      color: #e74c3c;
      font-weight: 600;
    }
    
    
    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.03); }
    }
    
    @keyframes shake {
      0%, 20%, 100% { transform: rotate(0deg); }
      4% { transform: rotate(-5deg); }
      8% { transform: rotate(5deg); }
      12% { transform: rotate(-5deg); }
      16% { transform: rotate(3deg); }
    }
    
    .cta-shake-button {
      animation: shake 2s ease-in-out infinite;
    }
    
    .cta-shake-button:hover {
      transform: scale(1.05);
    }
  </style>

  <script>
    // Variant Selector Logic
    let selectedVariantId = document.querySelector('input[name="variant-select"]:checked')?.value;
    
    document.querySelectorAll('.variant-option-rc').forEach(option => {
      option.addEventListener('click', function() {
        document.querySelectorAll('.variant-option-rc').forEach(opt => opt.classList.remove('active'));
        this.classList.add('active');
        const radio = this.querySelector('input[type="radio"]');
        radio.checked = true;
        selectedVariantId = radio.value;
        const variantInput = document.getElementById('variant-id-input');
        if (variantInput) {
          variantInput.value = selectedVariantId;
        }
      });
    });
    
    // Buy Now Prepaid function
    function buyNowPrepaid() {
      if (!selectedVariantId) {
        selectedVariantId = document.querySelector('input[name="variant-select"]:checked')?.value;
      }
      
      const formData = {
        id: selectedVariantId,
        quantity: 1
      };
      
      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(formData)
      })
      .then(response => response.json())
      .then(data => {
        window.location.href = '/cart';
      })
      .catch((error) => {
        console.error('Error:', error);
        alert('Failed to add to cart. Please try again.');
      });
    }
    
    function scrollToTop() {
      const buySection = document.querySelector('.buy-section-rc');
      if (buySection) {
        buySection.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }
    
    // COUNTDOWN TIMER
    function updateCountdown() {
      const now = new Date().getTime();
      const midnight = new Date();
      midnight.setHours(24, 0, 0, 0);
      const distance = midnight - now;
      
      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const mins = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const secs = Math.floor((distance % (1000 * 60)) / 1000);
      
      document.getElementById('days').textContent = String(days).padStart(2, '0');
      document.getElementById('hours').textContent = String(hours).padStart(2, '0');
      document.getElementById('mins').textContent = String(mins).padStart(2, '0');
      document.getElementById('secs').textContent = String(secs).padStart(2, '0');
    }
    
    updateCountdown();
    setInterval(updateCountdown, 1000);
  </script>

  <!-- Carousel Dots JavaScript -->
  <script>
    const galleryContainer = document.getElementById('gallery-container');
    const dots = document.querySelectorAll('.gallery-dots .dot');
    
    if (galleryContainer && dots.length > 0) {
      galleryContainer.addEventListener('scroll', function() {
        const scrollLeft = this.scrollLeft;
        const slideWidth = this.offsetWidth;
        const currentSlide = Math.round(scrollLeft / slideWidth);
        
        dots.forEach((dot, index) => {
          if (index === currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      });
      
      dots.forEach((dot, index) => {
        dot.addEventListener('click', function() {
          const slideWidth = galleryContainer.offsetWidth;
          galleryContainer.scrollTo({
            left: slideWidth * index,
            behavior: 'smooth'
          });
        });
      });
    }
  </script>

