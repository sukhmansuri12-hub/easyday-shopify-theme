{% comment %}
  SINK SPLASH GUARD - BUY 1 GET 1 FREE CAMPAIGN
  Mobile-First High-Conversion Design
{% endcomment %}

<section class="product-page-splash-guard">
  {% render 'product-page-desktop.css' %}
  
  {% comment %} HUGE BUY 1 GET 1 FREE BANNER {% endcomment %}
  <div class="bogo-banner">
    <div class="bogo-content">
      <div class="bogo-badge">🎁 LIMITED TIME OFFER</div>
      <div class="bogo-main">BUY 1 GET 1 FREE</div>
      <div class="bogo-sub">Double Your Protection, Zero Extra Cost!</div>
    </div>
  </div>
  
  {% comment %} Mobile Image Gallery {% endcomment %}
  <div class="product-image-gallery">
    <div class="gallery-container" id="gallery-container">
      {% for image in product.images %}
        <div class="slide"><img src="{{ image | img_url: 'master' }}" alt="{{ product.title }}"></div>
      {% endfor %}
    </div>
    <div class="gallery-dots">
      {% for image in product.images %}
        <span class="dot {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index0 }}"></span>
      {% endfor %}
    </div>
  </div>

  {% comment %} Product Info {% endcomment %}
  <div class="product-info-section">
    
    <h1 class="product-title-splash">{{ product.title }}</h1>
    
    <div class="product-rating-splash">
      <span style="display:inline-flex; align-items:baseline;">⭐⭐⭐⭐<span style="width:14px;overflow:hidden;">⭐</span></span>
      <span class="rating-count">4.8 (520+ Reviews)</span>
    </div>

    {% comment %} Countdown Timer {% endcomment %}
    <div class="countdown-timer-splash">
      <span class="timer-label">⏰ Offer Ends in</span>
      <div class="timer-display">
        <div class="time-box"><span id="hours">23</span><span class="label">Hours</span></div>
        <div class="time-box"><span id="mins">59</span><span class="label">Mins</span></div>
        <div class="time-box"><span id="secs">52</span><span class="label">Secs</span></div>
      </div>
    </div>

    {% comment %} Price {% endcomment %}
    <div class="price-section-splash">
      <div class="current-price-splash">{{ product.price | money }}</div>
      {% if product.compare_at_price > product.price %}
        <div class="compare-price-splash">{{ product.compare_at_price | money }}</div>
        {% assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
        <div class="save-badge-splash">SAVE {{ savings }}%</div>
      {% endif %}
    </div>
    
    <div class="bogo-reminder">
      ✨ <strong>Buy 1 Get 1 FREE</strong> - Add to cart to claim your free guard!
    </div>

    {% comment %} Shopify Product Form {% endcomment %}
    {% form 'product', product, id: 'product-form-splash' %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="variant-id-input">
      
      {% comment %} Buy Button {% endcomment %}
      <div class="buy-section-splash">
        <button class="btn-buy-now-splash" type="button" onclick="buyNowSplash()">
          <span class="btn-icon">🛒</span>
          <span class="btn-text-main">CLAIM BUY 1 GET 1 FREE</span>
          <span class="btn-text-sub">Limited Stock - Order Now!</span>
        </button>
      </div>
    {% endform %}
    
    {% comment %} Trust Badges {% endcomment %}
    <div class="trust-badges-splash">
      <div class="trust-item">✓ Free Shipping</div>
      <div class="trust-item">✓ Cash on Delivery</div>
      <div class="trust-item">✓ Easy Returns</div>
    </div>

  </div>

  {% comment %} Product Description {% endcomment %}
  <div class="product-description-splash">
    
    <div class="desc-block-splash">
      <h2>🌊 Stop Water Splashes Instantly!</h2>
      <p>Tired of water splashing everywhere when washing dishes? Our Sink Splash Guard creates a perfect barrier, keeping your kitchen clean and dry!</p>
      {% if product.images[1] %}
        <img src="{{ product.images[1] | img_url: '800x' }}" alt="Splash Guard in action" style="width:100%; border-radius:12px; margin:15px 0;">
      {% endif %}
    </div>

    <div class="desc-block-splash">
      <h2>✨ Why You'll Love It</h2>
      <ul class="feature-list-splash">
        <li>🛡️ <strong>Flexible Silicone</strong> - Bends to fit any sink perfectly</li>
        <li>💧 <strong>Blocks 99% of Splashes</strong> - Keep counters & floors dry</li>
        <li>🔥 <strong>Heat Resistant</strong> - Safe for hot water use</li>
        <li>🧼 <strong>Easy to Clean</strong> - Dishwasher safe silicone</li>
        <li>📦 <strong>BUY 1 GET 1 FREE</strong> - Perfect for multiple sinks!</li>
      </ul>
      {% if product.images[2] %}
        <img src="{{ product.images[2] | img_url: '800x' }}" alt="Features" style="width:100%; border-radius:12px; margin:15px 0;">
      {% endif %}
    </div>

    <div class="desc-block-splash">
      <h2>🏠 Perfect for Every Kitchen</h2>
      <p>Whether you're washing dishes, rinsing vegetables, or cleaning pots - our splash guard keeps everything clean. The flexible design fits standard and deep sinks!</p>
      {% if product.images[3] %}
        <img src="{{ product.images[3] | img_url: '800x' }}" alt="Kitchen use" style="width:100%; border-radius:12px; margin:15px 0;">
      {% endif %}
    </div>

  </div>

  {% comment %} Customer Reviews with Image {% endcomment %}
  <div class="reviews-section-splash">
    <h2 class="reviews-title">What Customers Are Saying</h2>
    
    {% comment %} Customer Reviews Image {% endcomment %}
    <div class="reviews-image-container">
      <img src="{{ 'uploaded_media_1769973662192.png' | asset_url }}" alt="Customer using splash guard" style="width:100%; border-radius:12px; box-shadow: 0 4px 20px rgba(0,0,0,0.1);">
    </div>
    
    <div style="display:flex;align-items:center;gap:10px;margin:20px 0;">
      <span style="display:inline-flex; align-items:baseline; font-size:1.5rem;">⭐⭐⭐⭐<span style="width:12px;overflow:hidden;">⭐</span></span>
      <span style="font-size:1.1rem;color:#666;font-weight:600;">4.8 out of 5 (520+ Reviews)</span>
    </div>
    
    <div class="review-card">
      <div class="reviewer-info">
        <strong>Priya Sharma</strong> <span class="verified">✓ Verified Purchase</span>
      </div>
      <div class="review-stars">⭐⭐⭐⭐⭐</div>
      <p class="review-text">"Buy 1 Get 1 Free offer is amazing! One for kitchen sink, one for bathroom. No more water mess on my counters!"</p>
    </div>

    <div class="review-card">
      <div class="reviewer-info">
        <strong>Rajesh Kumar</strong> <span class="verified">✓ Verified Purchase</span>
      </div>
      <div class="review-stars">⭐⭐⭐⭐⭐</div>
      <p class="review-text">"Flexible silicone bends perfectly around my sink. Blocks all water splashes. Best kitchen purchase!"</p>
    </div>

    <div class="review-card">
      <div class="reviewer-info">
        <strong>Anita Desai</strong> <span class="verified">✓ Verified Purchase</span>
      </div>
      <div class="review-stars">⭐⭐⭐⭐⭐</div>
      <p class="review-text">"Got 2 guards in BOGO offer. Kitchen stays so clean now! Easy to install and remove for cleaning."</p>
    </div>

    <div class="review-card">
      <div class="reviewer-info">
        <strong>Vikram Singh</strong> <span class="verified">✓ Verified Purchase</span>
      </div>
      <div class="review-stars">⭐⭐⭐⭐⭐</div>
      <p class="review-text">"Heat resistant silicone works great with hot water. No more wiping counters after dishes!"</p>
    </div>

    <div class="review-card">
      <div class="reviewer-info">
        <strong>Meera Patel</strong> <span class="verified">✓ Verified Purchase</span>
      </div>
      <div class="review-stars">⭐⭐⭐⭐⭐</div>
      <p class="review-text">"Dishwasher safe and easy to clean. The BOGO deal made it super affordable. Highly recommend!"</p>
    </div>

  </div>

  {% comment %} Final CTA {% endcomment %}
  <div class="final-cta-splash">
    <button onclick="scrollToTop()" class="cta-final-button">
      🎁 CLAIM YOUR BUY 1 GET 1 FREE OFFER
    </button>
    <p class="cta-urgency">⚡ Only {{ product.variants.first.inventory_quantity | default: 47 }} sets left in stock!</p>
  </div>

</section>

