<section class="product-page-rc-car">
  <div class="product-image-gallery">
    <div class="gallery-container">
      {% for image in product.images %}
        <div class="slide">
          <img src="{{ image | img_url: '600x600', crop: 'center' }}" alt="{{ product.title }}" loading="lazy">
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="product-info-section">
    <h1 class="product-title-rc">{{ product.title }}</h1>
    
    <div class="price-section-rc">
      <span class="current-price-rc">{{ product.price | money }}</span>
      <span class="compare-price-rc">{{ product.compare_at_price | money }}</span>
    </div>

    {% form 'product', product, id: 'product-form-splash' %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="variant-id-input">
      
      <div class="buy-section-rc">
        <style>
          .btn-standard-buy-now {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100%;
            background: linear-gradient(135deg, #00C853 0%, #00E676 100%);
            color: #ffffff !important;
            padding: 18px 10px;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0, 200, 83, 0.3);
            text-decoration: none !important;
            margin-bottom: {{ section.settings.button_spacing | default: 20 }}px;
            transition: transform 0.2s;
          }
          .btn-standard-buy-now:active { transform: scale(0.98); }
          
          .buy-now-main {
            display: block;
            font-size: 1.5rem;
            font-weight: 800;
            line-height: 1.2;
          }
          .buy-now-sub {
            display: block;
            font-size: 0.9rem;
            font-weight: 400;
            margin-top: 4px;
            opacity: 0.95;
            letter-spacing: 0.5px;
          }
          /* Native Dynamic Checkout Button Styling Override */
          .shopify-payment-button__button--unbranded {
            border-radius: 12px !important;
            padding: 18px !important;
            font-weight: 700 !important;
            text-transform: uppercase !important;
          }
        </style>
        
        <button type="submit" name="add" class="btn-standard-buy-now">
           <span class="buy-now-main">Add to cart</span>
           <span class="buy-now-sub">PAY ONLINE — SAVE 10%</span>
        </button>

        <div style="margin-top: 20px;">
          <button type="button" class="btn-standard-buy-now" style="background: #000; color: #fff;">
            <span class="buy-now-main">BUY NOW (TEST)</span>
          </button>
        </div>

        <div style="margin-top: {{ section.settings.button_spacing | default: 20 }}px;">
          {{ form | payment_button }}
        </div>
      </div>
    {% endform %}
  </div>

  <style>
    .product-page-rc-car { padding: 15px; background: #fff; }
    .gallery-container { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .gallery-container::-webkit-scrollbar { display: none; }
    .slide { min-width: 100%; }
    .slide img { width: 100%; height: auto; display: block; }
    .product-title-rc { font-size: 1.4rem; font-weight: 800; margin: 15px 0; }
    .price-section-rc { display: flex; gap: 10px; align-items: center; margin-bottom: 20px; }
    .current-price-rc { font-size: 1.8rem; font-weight: 900; color: #d32f2f; }
    .compare-price-rc { text-decoration: line-through; color: #888; }
    .btn-buy-prepaid-rc { width: 100%; padding: 15px; background: #000; color: #fff; border: none; border-radius: 10px; font-weight: 700; cursor: pointer; }
    .main-text-prepaid { display: block; }
    .sub-text-prepaid { font-size: 0.75rem; color: #4caf50; }
  </style>
</section>

{% schema %}
{
  "name": "Product Splash Guard",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_native_buy_now",
      "label": "Show Native Dynamic Buy Now Button",
      "default": true
    },
    {
      "type": "range",
      "id": "button_spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Space below Add To Cart",
      "default": 30
    }
  ]
}
{% endschema %}
