<section class="product-page-rc-car">

  <div class="product-info-section">
    <h1 class="product-title-rc">{{ product.title }}</h1>
    
    <div class="price-section-rc">
      <span class="current-price-rc">{{ product.price | money }}</span>
      <span class="compare-price-rc">{{ product.compare_at_price | money }}</span>
    </div>

    {% form 'product', product, id: 'product-form-splash' %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="variant-id-input">
      
      <div class="buy-section-rc">
        <style>
          /* 1. Pill Add to Cart */
          .sds-btn-addtocart-pill {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            background: transparent;
            color: #1a56db !important;
            border: 2px solid #1a56db;
            border-radius: 50px;
            padding: 14px 10px;
            text-align: center;
            cursor: pointer;
            box-sizing: border-box;
            margin-bottom: 15px;
            font-family: 'Inter', sans-serif;
            font-size: 1.15rem;
            font-weight: 700;
            transition: all 0.2s ease;
          }
          .sds-btn-addtocart-pill:active { transform: scale(0.98); }
          .sds-btn-addtocart-pill svg { width: 22px; height: 22px; stroke: #1a56db; }

          /* 2. Prepaid Bar */
          .sds-prepaid-bar-custom {
            background: #000000;
            color: #ffffff !important;
            text-align: center;
            padding: 10px 5px;
            font-size: 0.82rem;
            font-weight: 900;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            border-radius: 4px;
            margin-bottom: 5px;
            width: 100%;
            box-sizing: border-box;
            border: none;
          }

          /* 3. Solid Blue BUY NOW */
          .sds-btn-buynow-sleek {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 4px;
            width: 100%;
            background: linear-gradient(135deg, #1a56db 0%, #2563eb 100%);
            color: #ffffff !important;
            border-radius: 12px;
            padding: 18px 10px;
            text-align: center;
            cursor: pointer;
            box-sizing: border-box;
            margin-bottom: {{ section.settings.button_spacing | default: 20 }}px;
            font-family: 'Inter', sans-serif;
            border: none;
            box-shadow: 0 4px 15px rgba(26, 86, 219, 0.3);
            transition: all 0.2s ease;
            text-decoration: none;
          }
          .sds-btn-buynow-sleek:active { transform: scale(0.98); }
          .sds-buynow-text-custom { font-size: 1.6rem; font-weight: 950; line-height: 1.1; display: block; letter-spacing: 1px; }

          /* Native Override */
          .shopify-payment-button__button--unbranded {
            border-radius: 12px !important;
            padding: 18px !important;
            font-weight: 700 !important;
            text-transform: uppercase !important;
          }
        </style>
        
        <button class="sds-btn-addtocart-pill" type="submit" name="add">
          {% render 'icon-cart' %}
          <span>Add to Cart</span>
        </button>

        <div class="sds-prepaid-bar-custom">
          EXTRA RS 100 OFF ON PREPAID ORDERS
        </div>

        <button class="sds-btn-buynow-sleek" type="button" onclick="sdsBuyNowSplash()">
          <span class="sds-buynow-text-custom">BUY NOW</span>
          <div style="font-size: 14px; margin-top: 2px; opacity: 0.9;">G Pay | UPI | Paytm</div>
        </button>

        {% if section.settings.show_native_buy_now %}
          <div style="margin-top: -10px;">
            {{ form | payment_button }}
          </div>
        {% endif %}
      </div>
      
      <script>
        window.sdsBuyNowSplash = function() {
          const variantId = document.getElementById('variant-id-input')?.value;
          if (!variantId) { window.location.href = '/cart'; return; }
          fetch('/cart/clear.js', { method: 'POST' })
            .then(() => fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: variantId, quantity: 1 })
            }))
            .then(() => { window.location.href = '/checkout'; })
            .catch(() => { window.location.href = '/cart'; });
        };
      </script>
    {% endform %}
  </div>

  <style>
    .product-page-rc-car { padding: 15px; background: #fff; }

    .product-title-rc { font-size: 1.4rem; font-weight: 800; margin: 15px 0; }
    .price-section-rc { display: flex; gap: 10px; align-items: center; margin-bottom: 20px; }
    .current-price-rc { font-size: 1.8rem; font-weight: 900; color: #d32f2f; }
    .compare-price-rc { text-decoration: line-through; color: #888; }
    .btn-buy-prepaid-rc { width: 100%; padding: 15px; background: #000; color: #fff; border: none; border-radius: 10px; font-weight: 700; cursor: pointer; }
    .main-text-prepaid { display: block; }
    .sub-text-prepaid { font-size: 0.75rem; color: #4caf50; }
  </style>
</section>

{% schema %}
{
  "name": "Product Splash Guard",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_native_buy_now",
      "label": "Show Native Dynamic Buy Now Button",
      "default": true
    },
    {
      "type": "range",
      "id": "button_spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Space below Add To Cart",
      "default": 30
    }
  ]
}
{% endschema %}
