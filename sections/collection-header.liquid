{% comment %}
  Collection Header Section
  Displays collection title and description
{% endcomment %}

<section class="section-padding" style="display:none;">
  <div class="container">
    <div class="animate-on-scroll" data-animation="fade-in-up" style="text-align: center; max-width: 800px; margin: 0 auto;">
      <h1>{{ collection.title }}</h1>
      
      {%- if collection.description != blank -%}
        <div style="margin-top: 1rem; color: var(--color-text-light);">
          {{ collection.description }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Header"
}
{% endschema %}
