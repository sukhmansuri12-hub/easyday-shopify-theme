{% comment %}
  RC Stunt Car - Professional Product Page  
  Mobile-First Design
{% endcomment %}

<section class="product-page-rc-car">
  
  {% comment %} Mobile Image Gallery - Swipeable {% endcomment %}
  <div class="product-image-gallery">
    <div class="gallery-container" id="gallery-container">
      {% for image in product.images %}
        <div class="slide"><img src="{{ image | img_url: 'large' }}" alt="{{ product.title }}"></div>
      {% endfor %}
    </div>
    <div class="gallery-dots">
      <span class="dot active" data-slide="0"></span>
      <span class="dot" data-slide="1"></span>
      <span class="dot" data-slide="2"></span>
      <span class="dot" data-slide="3"></span>
    </div>
  </div>

  {% comment %} Product Info {% endcomment %}
  <div class="product-info-section">
    
    <h1 class="product-title-rc">{{ product.title }}</h1>
    
    <div class="product-rating-rc">
      <span class="stars">⭐⭐⭐⭐⭐</span>
      <span class="rating-count">4.8/5 (2,450 Reviews)</span>
    </div>

    {% comment %} Countdown Timer {% endcomment %}
    <div class="countdown-timer-rc">
      <span class="timer-label">⏰ Offer Ends in</span>
      <div class="timer-display">
        <div class="time-box"><span id="days">00</span><span class="label">Days</span></div>
        <div class="time-box"><span id="hours">23</span><span class="label">Hours</span></div>
        <div class="time-box"><span id="mins">59</span><span class="label">Minutes</span></div>
        <div class="time-box"><span id="secs">52</span><span class="label">Seconds</span></div>
      </div>
    </div>

    {% comment %} Price {% endcomment %}
    <div class="price-section-rc">
      <div class="current-price-rc">{{ product.price | money }}</div>
      {% if product.compare_at_price > product.price %}
        <div class="compare-price-rc">{{ product.compare_at_price | money }}</div>
        {% assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
        <div class="save-badge-rc">SAVE {{ savings }}%</div>
      {% endif %}
    </div>

    {% comment %} Buy Buttons {% endcomment %}
    <div class="buy-section-rc">
      <button class="btn-buy-prepaid-rc" onclick="buyNowPrepaid()">
        <span class="main-text-prepaid">Add to cart</span>
        <span class="sub-text-prepaid">PAY ONLINE & SAVE ₹130 (10% OFF)</span>
      </button>
      
      <a href="/rsi-btn-hook" class="btn-buy-cod-simple">
        <span class="main-text-cod">Order Now - Cash on Delivery</span>
        <span class="sub-text-cod">Pay when you receive | Free Shipping</span>
      </a>


    </div>

  </div>

  {% comment %} Description {% endcomment %}
  <div class="product-description-rc">
    
    <div style="text-align: center; margin-bottom: 30px;">
      <img src="{{ 'trust-badges.png' | asset_url }}" alt="Free Shipping, No-Hassle Returns, Satisfaction Guaranteed, Secure Checkout" style="max-width: 100%; height: auto;">
    </div>
    
    <div class="desc-block-rc">
      <h3>🎯 ULTIMATE FUN FOR KIDS!</h3>
      <p>Watch your kids' faces light up as this powerful RC stunt car performs incredible 360° flips, spins, and drifts! Perfect for indoor and outdoor play.</p>
      {%- if product.images[1] -%}
        <img src="{{ product.images[1] | img_url: '800x' }}" alt="{{ product.title }}" style="width:100%; border-radius:12px; margin:15px 0;">
      {%- elsif product.images[0] -%}
        <img src="{{ product.images[0] | img_url: '800x' }}" alt="{{ product.title }}" style="width:100%; border-radius:12px; margin:15px 0;">
      {%- endif -%}
    </div>

    <div class="desc-block-rc">
      <h3>⚡ POWERFUL FEATURES</h3>
      <ul class="feature-list-rc">
        <li><strong>360° Rotation & Drift:</strong> Amazing stunts with one-button control</li>
        <li><strong>High Speed:</strong> Up to 15 km/h</li>
        <li><strong>Long Range:</strong> 50+ meters</li>
        <li><strong>Rechargeable:</strong> 40 minutes playtime</li>
        <li><strong>LED Lights:</strong> Cool night play</li>
      </ul>
      {%- if product.images[2] -%}
        <img src="{{ product.images[2] | img_url: '800x' }}" alt="{{ product.title }}" style="width:100%; border-radius:12px; margin:15px 0;">
      {%- elsif product.images[1] -%}
        <img src="{{ product.images[1] | img_url: '800x' }}" alt="{{ product.title }}" style="width:100%; border-radius:12px; margin:15px 0;">
      {%- endif -%}
    </div>

    <div class="desc-block-rc">
      <h3>💪 BUILT TO LAST</h3>
      <p>Premium ABS plastic with shock-resistant design. Works on concrete, grass, carpet - anywhere!</p>
      {%- if product.images[3] -%}
        <img src="{{ product.images[3] | img_url: '800x' }}" alt="{{ product.title }}" style="width:100%; border-radius:12px; margin:15px 0;">
      {%- elsif product.images[0] -%}
        <img src="{{ product.images[0] | img_url: '800x' }}" alt="{{ product.title }}" style="width:100%; border-radius:12px; margin:15px 0;">
      {%- endif -%}
    </div>

    <div class="desc-block-rc">
      <h3>🎁 PERFECT GIFT</h3>
      <p>Amazing birthday or festival gift for kids aged 6-12 years. Encourages outdoor play!</p>
      {%- if product.images[4] -%}
        <img src="{{ product.images[4] | img_url: '800x' }}" alt="{{ product.title }}" style="width:100%; border-radius:12px; margin:15px 0;">
      {%- elsif product.images[1] -%}
        <img src="{{ product.images[1] | img_url: '800x' }}" alt="{{ product.title }}" style="width:100%; border-radius:12px; margin:15px 0;">
      {%- endif -%}
    </div>

  </div>

  {% comment %} Reviews {% endcomment %}
  <div class="reviews-section-rc">
    <h2 class="reviews-title">Customer Reviews ⭐⭐⭐⭐⭐</h2>
    
    <div class="review-card">
      <div class="reviewer-info">
        <strong>Priya Sharma</strong> <span class="verified">✓ Verified Purchase</span>
      </div>
      <div class="review-stars">⭐⭐⭐⭐⭐</div>
      <p class="review-text">Absolutely love this product! Worth every rupee. Fast delivery too!</p>
      {%- if product.images[0] -%}
        <img src="{{ product.images[0] | img_url: '300x' }}" alt="Customer photo" style="width:150px; border-radius:8px; margin-top:10px;">
      {%- endif -%}
    </div>

    <div class="review-card">
      <div class="reviewer-info">
        <strong>Rajesh Kumar</strong> <span class="verified">✓ Verified Purchase</span>
      </div>
      <div class="review-stars">⭐⭐⭐⭐⭐</div>
      <p class="review-text">Excellent quality! Better than expected. Highly recommended!</p>
    </div>

    <div class="review-card">
      <div class="reviewer-info">
        <strong>Anita Patel</strong> <span class="verified">✓ Verified Purchase</span>
      </div>
      <div class="review-stars">⭐⭐⭐⭐⭐</div>
      <p class="review-text">Very satisfied with this purchase. Great product at this price!</p>
      {%- if product.images[1] -%}
        <img src="{{ product.images[1] | img_url: '300x' }}" alt="Customer photo" style="width:150px; border-radius:8px; margin-top:10px;">
      {%- endif -%}
    </div>

    <div class="review-card">
      <div class="reviewer-info">
        <strong>Vikram Singh</strong> <span class="verified">✓ Verified Purchase</span>
      </div>
      <div class="review-stars">⭐⭐⭐⭐⭐</div>
      <p class="review-text">Amazing! Exactly what I was looking for. Will order again!</p>
    </div>

  </div>


</section>



