<script>
  // Gallery swipe
  const container = document.getElementById('gallery-container');
  const dots = document.querySelectorAll('.dot');
  let currentSlide = 0;

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      currentSlide = i;
      updateGallery();
    });
  });

  let touchStartX = 0;
  container.addEventListener('touchstart', e => {
    touchStartX = e.changedTouches[0].screenX;
  });

  container.addEventListener('touchend', e => {
    const touchEndX = e.changedTouches[0].screenX;
    const maxSlide = dots.length - 1;
    if (touchEndX < touchStartX - 50 && currentSlide < maxSlide) {
      currentSlide++;
      updateGallery();
    }
    if (touchEndX > touchStartX + 50 && currentSlide > 0) {
      currentSlide--;
      updateGallery();
    }
  });

  function updateGallery() {
    container.scrollTo({
      left: container.offsetWidth * currentSlide,
      behavior: 'smooth'
    });
    dots.forEach((d, i) => {
      d.classList.toggle('active', i === currentSlide);
    });
  }

  // Countdown
  function updateCountdown() {
    const now = new Date().getTime();
    const midnight = new Date();
    midnight.setHours(24,0,0,0);
    const distance = midnight - now;
    
    const d = Math.floor(distance / (1000 * 60 * 60 * 24));
    const h = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const m = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const s = Math.floor((distance % (1000 * 60)) / 1000);
    
    document.getElementById('days').textContent = String(d).padStart(2, '0');
    document.getElementById('hours').textContent = String(h).padStart(2, '0');
    document.getElementById('mins').textContent = String(m).padStart(2, '0');
    document.getElementById('secs').textContent = String(s).padStart(2, '0');
  }

  setInterval(updateCountdown, 1000);
  updateCountdown();

  // Review Form Popup
  function openReviewForm() {
    const formHTML = `
      <div id="review-modal" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;">
        <div style="background:white;border-radius:16px;padding:30px;max-width:500px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:0 10px 40px rgba(0,0,0,0.3);">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
            <h3 style="margin:0;font-size:1.5rem;color:#333;">Write a Review</h3>
            <button onclick="closeReviewForm()" style="background:none;border:none;font-size:2rem;cursor:pointer;color:#999;">&times;</button>
          </div>
          <form id="review-form-submit" style="display:flex;flex-direction:column;gap:15px;">
            <div>
              <label style="display:block;margin-bottom:5px;font-weight:600;color:#555;">Your Name</label>
              <input type="text" name="name" required style="width:100%;padding:12px;border:2px solid #ddd;border-radius:8px;font-size:1rem;">
            </div>
            <div>
              <label style="display:block;margin-bottom:5px;font-weight:600;color:#555;">Rating</label>
              <div class="star-rating" style="font-size:2rem;cursor:pointer;">
                <span data-rating="1">â˜†</span>
                <span data-rating="2">â˜†</span>
                <span data-rating="3">â˜†</span>
                <span data-rating="4">â˜†</span>
                <span data-rating="5">â˜†</span>
              </div>
              <input type="hidden" name="rating" id="rating-value" required>
            </div>
            <div>
              <label style="display:block;margin-bottom:5px;font-weight:600;color:#555;">Your Review</label>
              <textarea name="review" required rows="4" style="width:100%;padding:12px;border:2px solid #ddd;border-radius:8px;font-size:1rem;resize:vertical;"></textarea>
            </div>
            <button type="submit" style="background:linear-gradient(135deg,#FF6F00,#FF8F00);color:white;border:none;padding:14px;border-radius:50px;font-size:1.1rem;font-weight:700;cursor:pointer;box-shadow:0 4px 15px rgba(255,111,0,0.3);">
              Submit Review
            </button>
          </form>
        </div>
      </div>
    `;
    document.body.insertAdjacentHTML('beforeend', formHTML);
    
    // Star rating functionality
    const stars = document.querySelectorAll('.star-rating span');
    stars.forEach(star => {
      star.addEventListener('click', function() {
        const rating = this.dataset.rating;
        document.getElementById('rating-value').value = rating;
        stars.forEach((s, i) => {
          s.textContent = i < rating ? 'â˜…' : 'â˜†';
        });
      });
    });
    
    // Form submission
    document.getElementById('review-form-submit').addEventListener('submit', function(e) {
      e.preventDefault();
      const formData = new FormData(this);
      
      // Send to Shopify backend (metafields or customer note)
      fetch('/apps/reviews/submit', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          product_id: '{{ product.id }}',
          name: formData.get('name'),
          rating: formData.get('rating'),
          review: formData.get('review'),
          timestamp: new Date().toISOString()
        })
      }).then(() => {
        alert('Thank you for your review! We appreciate your feedback.');
        closeReviewForm();
      }).catch(() => {
        alert('Thank you for your review! We appreciate your feedback.');
        closeReviewForm();
      });
    });
  }
  
  function closeReviewForm() {
    const modal = document.getElementById('review-modal');
    if (modal) modal.remove();
  }

  // Sticky Buy Bar - Show on scroll
  const stickyBar = document.querySelector('.sticky-buy-bar-rc');
  if (stickyBar) {
    window.addEventListener('scroll', function() {
      if (window.scrollY > 300) {
        stickyBar.classList.add('visible');
      } else {
        stickyBar.classList.remove('visible');
      }
    });
  }

  // Bundle Selector
  let selectedVariantId = {{ product.selected_or_first_available_variant.id }};
  
  function selectBundle(button, variantId, price) {
    // Update selected variant
    selectedVariantId = variantId;
    
    // Update active state
    document.querySelectorAll('.bundle-option').forEach(opt => opt.classList.remove('active'));
    button.classList.add('active');
    
    // Update URL without reload
    const url = new URL(window.location);
    url.searchParams.set('variant', variantId);
    window.history.replaceState({}, '', url);
  }

  // Prepaid Checkout - Add to cart and redirect to Shopify checkout with Razorpay
  function buyNowPrepaid() {
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id: selectedVariantId,
        quantity: 1,
        properties: {
          '_payment_method': 'Prepaid - Razorpay',
          '_discount': '10% OFF'
        }
      })
    })
    .then(response => response.json())
    .then(data => {
      console.log('Added to cart:', data);
      
      // Update cart count using global function
      if (window.updateCartCount) {
        window.updateCartCount();
      }
      
      // Redirect to cart
      setTimeout(() => {
        window.location.href = '/cart';
      }, 200);
    })
    .catch(error => {
      console.error('Error adding to cart:', error);
      alert('Error processing order. Please try again.');
    });
  }
  
  // COD Checkout
  function orderCOD() {
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id: {{ product.selected_or_first_available_variant.id }},
        quantity: 1,
        properties: {
          '_payment_method': 'COD'
        }
      })
    })
    .then(response => response.json())
    .then(data => {
      window.location.href = '/checkout';
    })
    .catch(error => {
      console.error('Error:', error);
      alert('Error processing order. Please try again.');
    });
  }

  // Releasit COD Form will automatically handle clicks on links to /rs-bin-hook
</script>

