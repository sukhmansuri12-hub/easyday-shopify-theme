  </style>

  <script>
    // Variant Selector Logic
    let selectedVariantId = document.querySelector('input[name="variant-select"]:checked')?.value;
    
    document.querySelectorAll('.variant-option-rc').forEach(option => {
      option.addEventListener('click', function() {
        // Remove active class from all options
        document.querySelectorAll('.variant-option-rc').forEach(opt => opt.classList.remove('active'));
        
        // Add active class to clicked option
        this.classList.add('active');
        
        // Check the radio button
        const radio = this.querySelector('input[type="radio"]');
        radio.checked = true;
        selectedVariantId = radio.value;
        
        // Update Shopify form variant input for ReleaseIt
        const variantInput = document.getElementById('variant-id-input');
        if (variantInput) {
          variantInput.value = selectedVariantId;
        }
        
        // Update COD form if it exists
        updateCODForm();
      });
    });
    
    // Update COD form with selected variant
    function updateCODForm() {
      // Update the RSI COD form if it exists
      if (window.rsi_btn_hook) {
        const selectedOption = document.querySelector('.variant-option-rc.active');
        const variantQuantity = selectedOption?.querySelector('.variant-title')?.textContent.includes('2') ? 2 : 1;
        
        // Store variant info for COD form
        window.selectedBundleQuantity = variantQuantity;
        window.selectedVariantId = selectedVariantId;
      }
    }
    
    // Buy Now Prepaid function
    function buyNowPrepaid() {
      if (!selectedVariantId) {
        selectedVariantId = document.querySelector('input[name="variant-select"]:checked')?.value;
      }
      
      const formData = {
        id: selectedVariantId,
        quantity: 1
      };
      
      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(formData)
      })
      .then(response => response.json())
      .then(data => {
        window.location.href = '/cart';
      })
      .catch((error) => {
        console.error('Error:', error);
        alert('Failed to add to cart. Please try again.');
      });
    }
    
    // Handle COD button click with variant selection
    function handleCODClick(event) {
      event.preventDefault();
      
      // Get selected variant ID
      const variantId = selectedVariantId || document.querySelector('input[name="variant-select"]:checked')?.value;
      
      if (!variantId) {
        alert('Please select a variant');
        return;
      }
      
      // Update the COD link with variant ID
      const codLink = '/rsi-btn-hook?variant=' + variantId;
      window.location.href = codLink;
    }
    
    // Quick Add to Cart for You May Also Like products
    function quickAddToCart(variantId) {
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: variantId,
          quantity: 1
        })
      })
      .then(response => response.json())
      .then(data => {
        // Show success message
        alert('âœ… Added to cart!');
        // Optionally update cart count in header
        if (window.updateCartCount) window.updateCartCount();
      })
      .catch(error => {
        console.error('Error:', error);
        alert('Failed to add to cart. Please try again.');
      });
    }
    
    function scrollToTop() {
      // Scroll to buy buttons section
      const buySection = document.querySelector('.buy-section-rc');
      if (buySection) {
        buySection.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }
    
    // COUNTDOWN TIMER - Updates every second
    function updateCountdown() {
      const now = new Date().getTime();
      const midnight = new Date();
      midnight.setHours(24, 0, 0, 0);
      const distance = midnight - now;
      
      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const mins = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const secs = Math.floor((distance % (1000 * 60)) / 1000);
      
      document.getElementById('days').textContent = String(days).padStart(2, '0');
      document.getElementById('hours').textContent = String(hours).padStart(2, '0');
      document.getElementById('mins').textContent = String(mins).padStart(2, '0');
      document.getElementById('secs').textContent = String(secs).padStart(2, '0');
    }
    
    // Run countdown immediately and then every second
    updateCountdown();
    setInterval(updateCountdown, 1000);
  </script>


