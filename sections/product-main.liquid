<script>
  // Gallery swipe
  const container = document.getElementById('gallery-container');
  const dots = document.querySelectorAll('.dot');
  let currentSlide = 0;

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      currentSlide = i;
      updateGallery();
    });
  });

  let touchStartX = 0;
  container.addEventListener('touchstart', e => {
    touchStartX = e.changedTouches[0].screenX;
  });

  container.addEventListener('touchend', e => {
    const touchEndX = e.changedTouches[0].screenX;
    if (touchEndX < touchStartX - 50 && currentSlide < 3) {
      currentSlide++;
      updateGallery();
    }
    if (touchEndX > touchStartX + 50 && currentSlide > 0) {
      currentSlide--;
      updateGallery();
    }
  });

  function updateGallery() {
    container.scrollTo({
      left: container.offsetWidth * currentSlide,
      behavior: 'smooth'
    });
    dots.forEach((d, i) => {
      d.classList.toggle('active', i === currentSlide);
    });
  }

  // Countdown
  function updateCountdown() {
    const now = new Date().getTime();
    const midnight = new Date();
    midnight.setHours(24,0,0,0);
    const distance = midnight - now;
    
    const d = Math.floor(distance / (1000 * 60 * 60 * 24));
    const h = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const m = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const s = Math.floor((distance % (1000 * 60)) / 1000);
    
    document.getElementById('days').textContent = String(d).padStart(2, '0');
    document.getElementById('hours').textContent = String(h).padStart(2, '0');
    document.getElementById('mins').textContent = String(m).padStart(2, '0');
    document.getElementById('secs').textContent = String(s).padStart(2, '0');
  }

  setInterval(updateCountdown, 1000);
  updateCountdown();

  // Sticky Buy Bar - Show on scroll
  const stickyBar = document.querySelector('.sticky-buy-bar-rc');
  if (stickyBar) {
    window.addEventListener('scroll', function() {
      if (window.scrollY > 300) {
        stickyBar.classList.add('visible');
      } else {
        stickyBar.classList.remove('visible');
      }
    });
  }

  // Prepaid Checkout - Add to cart and redirect to Shopify checkout with Razorpay
  function buyNowPrepaid() {
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id: {{ product.selected_or_first_available_variant.id }},
        quantity: 1,
        properties: {
          '_payment_method': 'Prepaid - Razorpay',
          '_discount': '10% OFF'
        }
      })
    })
    .then(response => response.json())
    .then(data => {
      console.log('Added to cart:', data);
      
      // Update cart count using global function
      if (window.updateCartCount) {
        window.updateCartCount();
      }
      
      // Redirect to cart
      setTimeout(() => {
        window.location.href = '/cart';
      }, 200);
    })
    .catch(error => {
      console.error('Error adding to cart:', error);
      alert('Error processing order. Please try again.');
    });
  }
  
  // COD Checkout
  function orderCOD() {
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id: {{ product.selected_or_first_available_variant.id }},
        quantity: 1,
        properties: {
          '_payment_method': 'COD'
        }
      })
    })
    .then(response => response.json())
    .then(data => {
      window.location.href = '/checkout';
    })
    .catch(error => {
      console.error('Error:', error);
      alert('Error processing order. Please try again.');
    });
  }

  // Releasit COD Form will automatically handle clicks on links to /rs-bin-hook
</script>

