<footer class="site-footer" style="background:#1a56db !important; padding: 50px 20px 40px 20px; text-align: left; border-top: none; margin:0; color: #ffffff !important;">
  <div class="container" style="max-width: 1200px; margin: 0 auto;">
    
    {% comment %} 0. BRAND HEADING {% endcomment %}
    <div style="margin-bottom: 40px;">
        <h2 style="font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 2.5rem; color: #ffffff; margin: 0; letter-spacing: -1px;">EasyDay</h2>
    </div>

    {% comment %} 1. ABOUT US {% endcomment %}
    <div style="margin-bottom: 35px;">
        <h4 style="text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; margin-bottom: 12px; color: #ffffff; font-weight: 700;">About Us</h4>
        <p style="color: #ffffff; font-size: 0.95rem; line-height: 1.6; opacity: 0.95; margin: 0; max-width: 500px;">
            We make things that work better and last longer. Our products solve real problems with clean design and honest materials, improving your everyday life with smart, simple innovations.
        </p>
    </div>

    {% comment %} 2. QUICK LINKS - VERTICAL LIST {% endcomment %}
    <div style="margin-bottom: 35px;">
        <h4 style="text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; margin-bottom: 18px; color: #ffffff; font-weight: 700;">QUICK LINKS</h4>
        <ul class="footer-links" style="list-style:none; padding:0; margin: 0;">
          <li style="margin-bottom: 12px;"><a href="/pages/contact" style="color: #ffffff; text-decoration:none; font-size: 1rem;">Contact Us</a></li>
          <li style="margin-bottom: 12px;"><a href="/pages/shipping-returns" style="color: #ffffff; text-decoration:none; font-size: 1rem;">Shipping & Returns</a></li>
          <li style="margin-bottom: 12px;"><a href="/pages/about-us" style="color: #ffffff; text-decoration:none; font-size: 1rem;">Terms of Service</a></li>
          <li style="margin-bottom: 12px;"><a href="/pages/privacy-policy" style="color: #ffffff; text-decoration:none; font-size: 1rem;">Privacy Policy</a></li>
        </ul>
    </div>

    {% comment %} 3. PROFESSIONAL PAYMENT LOGOS - CENTERED & SPREAD {% endcomment %}
    <div style="margin: 40px 0 30px; display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; align-items: center;">
        <div style="background: white; border-radius: 3px; padding: 4px 8px; height: 24px; display: flex; align-items: center; justify-content: center; width: 44px; box-sizing: border-box;">
            <img src="https://cdn.shopify.com/s/assets/payment_icons/google_pay.svg" alt="Google Pay" style="width: 100%; height: auto;">
        </div>
        <div style="background: white; border-radius: 3px; padding: 4px 8px; height: 24px; display: flex; align-items: center; justify-content: center; width: 44px; box-sizing: border-box;">
            <img src="https://cdn.shopify.com/s/assets/payment_icons/visa.svg" alt="Visa" style="width: 100%; height: auto;">
        </div>
        <div style="background: white; border-radius: 3px; padding: 4px 8px; height: 24px; display: flex; align-items: center; justify-content: center; width: 44px; box-sizing: border-box;">
            <img src="https://cdn.shopify.com/s/assets/payment_icons/master.svg" alt="Mastercard" style="width: 100%; height: auto;">
        </div>
        <div style="background: white; border-radius: 3px; padding: 4px 6px; height: 24px; display: flex; align-items: center; justify-content: center; width: 44px; box-sizing: border-box;">
            <img src="https://cdn.shopify.com/s/assets/payment_icons/american_express.svg" alt="Amex" style="width: 100%; height: auto;">
        </div>
        <div style="background: white; border-radius: 3px; padding: 4px 6px; height: 24px; display: flex; align-items: center; justify-content: center; width: 44px; box-sizing: border-box;">
            <img src="https://cdn.shopify.com/s/assets/payment_icons/paypal.svg" alt="PayPal" style="width: 100%; height: auto;">
        </div>
        <div style="background: white; border-radius: 3px; padding: 4px 8px; height: 24px; display: flex; align-items: center; justify-content: center; width: 44px; box-sizing: border-box;">
            <img src="https://cdn.shopify.com/s/assets/payment_icons/discover.svg" alt="Discover" style="width: 100%; height: auto;">
        </div>
        <div style="background: white; border-radius: 3px; padding: 4px 8px; height: 24px; display: flex; align-items: center; justify-content: center; width: 44px; box-sizing: border-box;">
            <img src="https://cdn.shopify.com/s/assets/payment_icons/maestro.svg" alt="Maestro" style="width: 100%; height: auto;">
        </div>
    </div>

    {% comment %} 4. COPYRIGHT & FOOTER LINKS - CENTERED {% endcomment %}
    <div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 25px; text-align: center;">
         <p style="color: #ffffff; font-size: 0.82rem; font-weight: 600; margin-bottom: 12px; opacity: 0.9;">&copy; 2026 EasyDay All Rights Reserved</p>
         <div style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.8rem; color: #ffffff; opacity: 0.85; line-height: 1.5; justify-content: center;">
            <a href="/pages/contact" style="color: #ffffff; text-decoration: none;">Contact information</a>
            <span style="opacity: 0.3;">&middot;</span>
            <a href="/pages/shipping-returns" style="color: #ffffff; text-decoration: none;">Shipping & Returns</a>
            <span style="opacity: 0.3;">&middot;</span>
            <a href="/pages/about-us" style="color: #ffffff; text-decoration: none;">Terms of Service</a>
            <span style="opacity: 0.3;">&middot;</span>
            <a href="/pages/privacy-policy" style="color: #ffffff; text-decoration: none;">Privacy policy</a>
         </div>
    </div>

  </div>
</footer>

<style>
    .footer-links a { transition: opacity 0.2s; }
    .footer-links a:hover { opacity: 0.7; }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
