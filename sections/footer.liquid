{% comment %}
  Footer Section
  Main site footer with links and policies
{% endcomment %}

<footer class="site-footer" style="background:#1a56db !important; padding: 40px 20px 100px 20px; text-align: left; border-top: none; margin:0; color: #ffffff !important;">
  <div class="container">
    
    {% comment %} 1. ABOUT US (Top) {% endcomment %}
    <div style="margin-bottom: 25px;">
        <h4 style="text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; margin-bottom: 10px; color: #ffffff;">About Us</h4>
        <p style="color: #ffffff; font-size: 0.9rem; line-height: 1.6; opacity: 0.9;">
            We make things that work better and last longer. Our products solve real problems with clean design and honest materials, improving your everyday life with smart, simple innovations.
        </p>
    </div>

    {% comment %} 2. QUICK LINKS {% endcomment %}
    <div style="margin-bottom: 20px;">
        <h4 style="text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; margin-bottom: 15px; color: #ffffff;">QUICK LINKS</h4>
        <ul class="footer-links" style="list-style:none; padding:0;">
          <li style="margin-bottom: 8px;"><a href="/pages/contact" style="color: #ffffff; text-decoration:none;">Contact Us</a></li>
          <li style="margin-bottom: 8px;"><a href="/pages/shipping-returns" style="color: #ffffff; text-decoration:none;">Shipping & Returns</a></li>
          <li style="margin-bottom: 8px;"><a href="/pages/about-us" style="color: #ffffff; text-decoration:none;">Terms of Service</a></li>
          <li style="margin-bottom: 8px;"><a href="/pages/privacy-policy" style="color: #ffffff; text-decoration:none;">Privacy Policy</a></li>
        </ul>
        
        <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid rgba(255,255,255,0.1);">
          <h4 style="text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; margin-bottom: 5px; color: #ffffff;">Registered Address</h4>
          <p style="color: #ffffff; font-size: 0.85rem; line-height: 1.5; margin: 0; opacity: 0.9;">
            <strong>Sukhman Suri</strong><br>
            Uniworld Gardens 1, Uniworld Gardens Road Sector 47<br>
            1104, T-5, Gurugram, Haryana, 122018
          </p>
        </div>
    </div>

    {% comment %} 3. PAYMENT LOGOS {% endcomment %}
    <div style="margin-bottom: 20px; display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-start; align-items: center;">
        <div style="background: white; border-radius: 2px; padding: 4px 6px; height: 24px; display: flex; align-items: center;">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/google_pay-129690197d66002f1a301a3554e2f9d6ba19d9b62fcefa30df2b97c8d76ae5f0.svg" alt="Google Pay" style="height: 12px;">
        </div>
        <div style="background: white; border-radius: 2px; padding: 4px 6px; height: 24px; display: flex; align-items: center;">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/visa-319d545c6fd255c9aad515a443695ca5b0606f8c652e071c35626a5ae9df3634.svg" alt="Visa" style="height: 10px;">
        </div>
        <div style="background: white; border-radius: 2px; padding: 4px 6px; height: 24px; display: flex; align-items: center;">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/master-173035bc8124581ca3d9681816cae3650f003c9a782647466fb8d1964bc3e82d.svg" alt="Mastercard" style="height: 14px;">
        </div>
        <div style="background: white; border-radius: 2px; padding: 4px 6px; height: 24px; display: flex; align-items: center;">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/american_express-7fc79998ccf32e92c6c21e65CC56A350cc836f86ca8e7a0980fa54f248f2197f.svg" alt="Amex" style="height: 10px;">
        </div>
        <div style="background: white; border-radius: 2px; padding: 4px 6px; height: 24px; display: flex; align-items: center;">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/diners_club-397261d76534563a45c7E37475c87a5FE2591E6ca1FE7a2168FE43E632FE418.svg" alt="Diners Club" style="height: 12px;">
        </div>
        <div style="background: white; border-radius: 2px; padding: 4px 6px; height: 24px; display: flex; align-items: center;">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/discover-10a4731F2A7E35E47487A4F2E225A1EF9A3A3B43A1EF7a1A15984A2341A5A5AA.svg" alt="Discover" style="height: 10px;">
        </div>
    </div>

    {% comment %} 4. COPYRIGHT (Bottom) {% endcomment %}
    <div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 20px; text-align: center; margin-top: 10px;">
         <p style="color: #ffffff; font-size: 0.75rem; opacity: 0.7;">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    </div>

  </div>
</footer>

<style>
    /* Footer Grid Layout */
    .footer-content-grid {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    
    .footer-row-1 {
        display: grid;
        grid-template-columns: 1fr 1fr; /* Side by side */
        gap: 20px;
        text-align: left;
    }
    
    .footer-row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr; /* Side by side */
        gap: 20px;
        text-align: left;
        border-top: 1px solid #444;
        padding-top: 20px;
    }
    
    .footer-section h4 {
        margin-bottom: 10px;
        font-size: 1.1rem;
        color: #ff6f00; /* EasyDay Orange Highlight */
    }
    
    .footer-links { list-style: none; padding: 0; margin: 0; }
    .footer-links li { margin-bottom: 12px; }
    .footer-links a { color: #ffffff; text-decoration: none; font-size: 1rem; transition: opacity 0.2s; }
    .footer-links a:hover { opacity: 0.7; }
    
    /* Socials */
    .social-links { display: flex; gap: 10px; flex-wrap: wrap; }
    .social-icon { color: white; text-decoration: none; font-size: 0.9rem; background: rgba(255,255,255,0.1); padding: 5px 8px; border-radius: 4px; }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact Email",
      "default": "support@easyday.com"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Contact Phone",
      "default": "+91 XXXXXXXXXX"
    }
  ]
}
{% endschema %}
