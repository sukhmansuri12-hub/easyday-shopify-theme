{% comment %}
  Footer Section
  Main site footer with links and policies
{% endcomment %}

<footer class="site-footer" style="background:#1a56db !important; padding: 60px 20px 40px 20px; text-align: left; border-top: none; margin:0; color: #ffffff !important;">
  <div class="container" style="max-width: 1200px; margin: 0 auto;">
    
    {% comment %} 1. BRAND NAME {% endcomment %}
    <div style="margin-bottom: 40px;">
        <h2 style="font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 2.2rem; color: #ffffff; margin: 0; letter-spacing: -1px; text-transform: lowercase;">{{ shop.name }}</h2>
    </div>

    {% comment %} 2. POLICIES {% endcomment %}
    <div style="margin-bottom: 40px;">
        <h4 style="font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1.15rem; margin-bottom: 20px; color: #ffffff;">Our policies</h4>
        <ul class="footer-links" style="list-style:none; padding:0; display: flex; flex-direction: column; gap: 14px;">
          <li><a href="/pages/contact" style="color: #ffffff; text-decoration:none; font-size: 0.95rem; opacity: 1;">Contact Information</a></li>
          <li><a href="/pages/privacy-policy" style="color: #ffffff; text-decoration:none; font-size: 0.95rem; opacity: 1;">Privacy Policy</a></li>
          <li><a href="/pages/refund-policy" style="color: #ffffff; text-decoration:none; font-size: 0.95rem; opacity: 1;">Refund Policy</a></li>
          <li><a href="/pages/shipping-policy" style="color: #ffffff; text-decoration:none; font-size: 0.95rem; opacity: 1;">Shipping Policy</a></li>
          <li><a href="/pages/terms-of-service" style="color: #ffffff; text-decoration:none; font-size: 0.95rem; opacity: 1;">Terms of Service</a></li>
        </ul>
    </div>

    {% comment %} 3. PAYMENT LOGOS {% endcomment %}
    <div style="margin-bottom: 40px; display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-start; align-items: center;">
        <div style="background: white; border-radius: 4px; padding: 6px 10px; height: 32px; display: flex; align-items: center; box-sizing: border-box;">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/google_pay-129690197d66002f1a301a3554e2f9d6ba19d9b62fcefa30df2b97c8d76ae5f0.svg" alt="Google Pay" style="height: 16px;">
        </div>
        <div style="background: white; border-radius: 4px; padding: 6px 10px; height: 32px; display: flex; align-items: center; box-sizing: border-box;">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/visa-319d545c6fd255c9aad515a443695ca5b0606f8c652e071c35626a5ae9df3634.svg" alt="Visa" style="height: 12px;">
        </div>
        <div style="background: white; border-radius: 4px; padding: 6px 10px; height: 32px; display: flex; align-items: center; box-sizing: border-box;">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/master-173035bc8124581ca3d9681816cae3650f003c9a782647466fb8d1964bc3e82d.svg" alt="Mastercard" style="height: 20px;">
        </div>
        <div style="background: white; border-radius: 4px; padding: 6px 10px; height: 32px; display: flex; align-items: center; box-sizing: border-box;">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/american_express-7fc79998ccf32e92c6c21e65CC56A350cc836f86ca8e7a0980fa54f248f2197f.svg" alt="Amex" style="height: 14px;">
        </div>
        <div style="background: white; border-radius: 4px; padding: 6px 10px; height: 32px; display: flex; align-items: center; box-sizing: border-box;">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/diners_club-397261d76534563a45c7E37475c87a5FE2591E6ca1FE7a2168FE43E632FE418.svg" alt="Diners Club" style="height: 16px;">
        </div>
        <div style="background: white; border-radius: 4px; padding: 6px 10px; height: 32px; display: flex; align-items: center; box-sizing: border-box;">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/discover-10a4731F2A7E35E47487A4F2E225A1EF9A3A3B43A1EF7a1A15984A2341A5A5AA.svg" alt="Discover" style="height: 14px;">
        </div>
        <div style="background: white; border-radius: 4px; padding: 6px 10px; height: 32px; display: flex; align-items: center; box-sizing: border-box;">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/maestro-05cBC7EE4A7EE21FE7a9A4A1A1FE2591A9A3A3B43A1EF7a1A15984A2341A5A5AA.svg" alt="Maestro" style="height: 20px;">
        </div>
    </div>

    {% comment %} 4. COPYRIGHT & LINKS (Bottom) {% endcomment %}
    <div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 30px; text-align: left;">
         <div style="display: flex; flex-wrap: wrap; gap: 20px; font-size: 0.82rem; color: #ffffff; opacity: 0.85; line-height: 1.5; font-family: 'Poppins', sans-serif;">
            <span>&copy; {{ 'now' | date: '%Y' }}, {{ shop.name }} All Rights Reserved</span>
            <div style="display: flex; flex-wrap: wrap; gap: 15px;">
              <a href="/pages/refund-policy" style="color: #ffffff; text-decoration: none;">Refund policy</a>
              <span>&middot;</span>
              <a href="/pages/privacy-policy" style="color: #ffffff; text-decoration: none;">Privacy policy</a>
              <span>&middot;</span>
              <a href="/pages/terms-of-service" style="color: #ffffff; text-decoration: none;">Terms of service</a>
              <span>&middot;</span>
              <a href="/pages/shipping-policy" style="color: #ffffff; text-decoration: none;">Shipping policy</a>
              <span>&middot;</span>
              <a href="/pages/contact" style="color: #ffffff; text-decoration: none;">Contact information</a>
            </div>
         </div>
    </div>

  </div>
</footer>

<style>
    /* Footer Grid Layout */
    .footer-content-grid {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    
    .footer-row-1 {
        display: grid;
        grid-template-columns: 1fr 1fr; /* Side by side */
        gap: 20px;
        text-align: left;
    }
    
    .footer-row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr; /* Side by side */
        gap: 20px;
        text-align: left;
        border-top: 1px solid #444;
        padding-top: 20px;
    }
    
    .footer-section h4 {
        margin-bottom: 10px;
        font-size: 1.1rem;
        color: #ff6f00; /* EasyDay Orange Highlight */
    }
    
    .footer-links { list-style: none; padding: 0; margin: 0; }
    .footer-links li { margin-bottom: 12px; }
    .footer-links a { color: #ffffff; text-decoration: none; font-size: 1rem; transition: opacity 0.2s; }
    .footer-links a:hover { opacity: 0.7; }
    
    /* Socials */
    .social-links { display: flex; gap: 10px; flex-wrap: wrap; }
    .social-icon { color: white; text-decoration: none; font-size: 0.9rem; background: rgba(255,255,255,0.1); padding: 5px 8px; border-radius: 4px; }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact Email",
      "default": "support@easyday.com"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Contact Phone",
      "default": "+91 XXXXXXXXXX"
    }
  ]
}
{% endschema %}
