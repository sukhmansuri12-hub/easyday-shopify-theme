<footer class="site-footer" style="background:#1a56db !important; padding: 60px 20px 40px 20px; text-align: left; border-top: none; margin:0; color: #ffffff !important;">
  <div class="container" style="max-width: 1200px; margin: 0 auto;">
    
    {% comment %} 0. BRAND HEADING {% endcomment %}
    <div style="margin-bottom: 40px;">
        <h2 style="font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 2.5rem; color: #ffffff; margin: 0; letter-spacing: -1px;">EasyDay</h2>
    </div>

    {% comment %} 1. ABOUT US {% endcomment %}
    <div style="margin-bottom: 35px;">
        <h4 style="text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; margin-bottom: 15px; color: #ffffff; font-weight: 700;">About Us</h4>
        <p style="color: #ffffff; font-size: 0.95rem; line-height: 1.6; opacity: 0.95; margin: 0; max-width: 500px;">
            We make things that work better and last longer. Our products solve real problems with clean design and honest materials, improving your everyday life with smart, simple innovations.
        </p>
    </div>

    {% comment %} 2. QUICK LINKS - SIDE BY SIDE ON MOBILE {% endcomment %}
    <div style="margin-bottom: 40px;">
        <h4 style="text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; margin-bottom: 20px; color: #ffffff; font-weight: 700;">QUICK LINKS</h4>
        <ul class="footer-links" style="list-style:none; padding:0; display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
          <li><a href="/pages/contact" style="color: #ffffff; text-decoration:none; font-size: 1rem;">Contact Us</a></li>
          <li><a href="/pages/shipping-returns" style="color: #ffffff; text-decoration:none; font-size: 1rem;">Shipping & Returns</a></li>
          <li><a href="/pages/about-us" style="color: #ffffff; text-decoration:none; font-size: 1rem;">Terms of Service</a></li>
          <li><a href="/pages/privacy-policy" style="color: #ffffff; text-decoration:none; font-size: 1rem;">Privacy Policy</a></li>
        </ul>
    </div>

    {% comment %} 3. PAYMENT LOGOS STRIP {% endcomment %}
    <div style="margin-bottom: 40px; display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-start; align-items: center;">
        <div style="background: white; border-radius: 4px; padding: 6px 12px; height: 32px; display: flex; align-items: center; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/google_pay-129690197d66002f1a301a3554e2f9d6ba19d9b62fcefa30df2b97c8d76ae5f0.svg" alt="GPay" style="height: 14px; width: auto;">
        </div>
        <div style="background: white; border-radius: 4px; padding: 6px 12px; height: 32px; display: flex; align-items: center; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/visa-319d545c6fd255c9aad515a443695ca5b0606f8c652e071c35626a5ae9df3634.svg" alt="Visa" style="height: 10px; width: auto;">
        </div>
        <div style="background: white; border-radius: 4px; padding: 6px 12px; height: 32px; display: flex; align-items: center; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/master-173035bc8124581ca3d9681816cae3650f003c9a782647466fb8d1964bc3e82d.svg" alt="Mastercard" style="height: 18px; width: auto;">
        </div>
        <div style="background: white; border-radius: 4px; padding: 6px 12px; height: 32px; display: flex; align-items: center; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/american_express-7fc79998ccf32e92c6c21e65CC56A350cc836f86ca8e7a0980fa54f248f2197f.svg" alt="Amex" style="height: 12px; width: auto;">
        </div>
        <div style="background: white; border-radius: 4px; padding: 6px 12px; height: 32px; display: flex; align-items: center; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/diners_club-397261d76534563a45c7E37475c87a5FE2591E6ca1FE7a2168FE43E632FE418.svg" alt="Diners" style="height: 16px; width: auto;">
        </div>
        <div style="background: white; border-radius: 4px; padding: 6px 12px; height: 32px; display: flex; align-items: center; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/discover-10a4731F2A7E35E47487A4F2E225A1EF9A3A3B43A1EF7a1A15984A2341A5A5AA.svg" alt="Discover" style="height: 12px; width: auto;">
        </div>
        <div style="background: white; border-radius: 4px; padding: 6px 12px; height: 32px; display: flex; align-items: center; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
            <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment_icons/maestro-05cBC7EE4A7EE21FE7a9A4A1A1FE2591A9A3A3B43A1EF7a1A15984A2341A5A5AA.svg" alt="Maestro" style="height: 18px; width: auto;">
        </div>
    </div>

    {% comment %} 4. COPYRIGHT & FOOTER LINKS {% endcomment %}
    <div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 30px; text-align: left;">
         <p style="color: #ffffff; font-size: 0.85rem; font-weight: 600; margin-bottom: 15px;">&copy; 2026 EasyDay All Rights Reserved</p>
         <div style="display: flex; flex-wrap: wrap; gap: 15px; font-size: 0.82rem; color: #ffffff; opacity: 0.85; line-height: 1.5;">
            <a href="/pages/contact" style="color: #ffffff; text-decoration: none;">Contact information</a>
            <span style="opacity: 0.3;">&middot;</span>
            <a href="/pages/shipping-returns" style="color: #ffffff; text-decoration: none;">Shipping & Returns</a>
            <span style="opacity: 0.3;">&middot;</span>
            <a href="/pages/about-us" style="color: #ffffff; text-decoration: none;">Terms of Service</a>
            <span style="opacity: 0.3;">&middot;</span>
            <a href="/pages/privacy-policy" style="color: #ffffff; text-decoration: none;">Privacy policy</a>
         </div>
    </div>

  </div>
</footer>

<style>
    .footer-links a { transition: opacity 0.2s; }
    .footer-links a:hover { opacity: 0.7; }
</style>

