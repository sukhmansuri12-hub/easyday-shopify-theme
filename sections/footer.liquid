{% comment %}
  Footer Section
  Main site footer with links and policies
{% endcomment %}

<footer class="site-footer" style="background:white; padding: 5px 20px 40px 20px; text-align: left; border-top: 1px solid #f0f0f0;">
  <div class="container">
    
    {% comment %} 1. ABOUT US (Top) {% endcomment %}
    <div style="margin-bottom: 25px;">
        <h4 style="text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; margin-bottom: 10px; color: #333;">About Us</h4>
        <p style="color: #666; font-size: 0.9rem; line-height: 1.6;">
            We make things that work better and last longer. Our products solve real problems with clean design and honest materials, improving your everyday life with smart, simple innovations.
        </p>
    </div>

    {% comment %} 2. QUICK LINKS & SOCIALS (Side by Side) {% endcomment %}
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
        
        <div>
            <h4 style="text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; margin-bottom: 15px; color: #333;">QUICK LINKS</h4>
            <ul class="footer-links" style="list-style:none; padding:0;">
              <li style="margin-bottom: 8px;"><a href="/pages/contact" style="color: #666; text-decoration:none;">Contact Us</a></li>
              <li style="margin-bottom: 8px;"><a href="/pages/shipping" style="color: #666; text-decoration:none;">Shipping Policy</a></li>
              <li style="margin-bottom: 8px;"><a href="/pages/returns" style="color: #666; text-decoration:none;">Return Policy</a></li>
              <li style="margin-bottom: 8px;"><a href="/pages/terms" style="color: #666; text-decoration:none;">Terms & Conditions</a></li>
              <li style="margin-bottom: 8px;"><a href="/pages/privacy" style="color: #666; text-decoration:none;">Privacy Policy</a></li>
            </ul>
        </div>

        <div>
           <h4 style="text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; margin-bottom: 15px; color: #333;">Follow Us</h4>
            <div style="display: flex; gap: 15px; flex-direction: column;">
                 <a href="https://facebook.com" target="_blank" style="text-decoration:none; display:flex; align-items:center; gap:8px; color:#555;">
                    <img src="https://cdn-icons-png.flaticon.com/512/733/733547.png" width="20" height="20" alt="Facebook"> Facebook
                 </a>
                 <a href="https://instagram.com" target="_blank" style="text-decoration:none; display:flex; align-items:center; gap:8px; color:#555;">
                     <img src="https://cdn-icons-png.flaticon.com/512/2111/2111463.png" width="20" height="20" alt="Instagram"> Instagram
                 </a>
             </div>
        </div>
    </div>

    {% comment %} 3. COPYRIGHT (Bottom) - NO EMOJIS {% endcomment %}
    <div style="border-top: 1px solid #eee; padding-top: 20px; text-align: center; margin-top: 10px;">
         <p style="color: #bbb; font-size: 0.75rem;">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    </div>

  </div>
</footer>

<style>
    /* Footer Grid Layout */
    .footer-content-grid {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    
    .footer-row-1 {
        display: grid;
        grid-template-columns: 1fr 1fr; /* Side by side */
        gap: 20px;
        text-align: left;
    }
    
    .footer-row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr; /* Side by side */
        gap: 20px;
        text-align: left;
        border-top: 1px solid #444;
        padding-top: 20px;
    }
    
    .footer-section h4 {
        margin-bottom: 10px;
        font-size: 1.1rem;
        color: #ff6f00; /* EasyDay Orange Highlight */
    }
    
    .footer-links { list-style: none; padding: 0; margin: 0; }
    .footer-links li { margin-bottom: 8px; }
    .footer-links a { color: #ccc; text-decoration: none; font-size: 0.9rem; }
    
    /* Socials */
    .social-links { display: flex; gap: 10px; flex-wrap: wrap; }
    .social-icon { color: white; text-decoration: none; font-size: 0.9rem; background: #333; padding: 5px 8px; border-radius: 4px; }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact Email",
      "default": "support@easyday.com"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Contact Phone",
      "default": "+91 XXXXXXXXXX"
    }
  ]
}
{% endschema %}
