{% comment %}
  Trust Signals Section
  Displays trust badges like Free Shipping, COD, etc.
{% endcomment %}

<section class="section-padding">
  <div class="container">
    <div class="trust-signals animate-on-scroll" data-animation="fade-in-up">
      <div class="trust-badge">
        <div class="trust-icon">🚚</div>
        <h4 class="trust-title">Free Shipping</h4>
        <p class="trust-text">All Over India</p>
      </div>

      <div class="trust-badge">
        <div class="trust-icon">💰</div>
        <h4 class="trust-title">Cash on Delivery</h4>
        <p class="trust-text">Pay when you receive</p>
      </div>

      <div class="trust-badge">
        <div class="trust-icon">🔄</div>
        <h4 class="trust-title">Easy Returns</h4>
        <p class="trust-text">No hassle returns</p>
      </div>

      <div class="trust-badge">
        <div class="trust-icon">🔒</div>
        <h4 class="trust-title">Secure Checkout</h4>
        <p class="trust-text">100% Safe & Secure</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Signals",
  "presets": [
    {
      "name": "Trust Signals"
    }
  ]
}
{% endschema %}
