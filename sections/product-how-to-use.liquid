{% comment %}
  Product How To Use Section
  Explains how to use the product
{% endcomment %}

{%- if section.settings.content != blank or section.blocks.size > 0 -%}
<section class="product-how-to-use">
  <div class="container">
    <h2 class="section-title animate-on-scroll" data-animation="fade-in-up">
      {{ section.settings.heading | default: 'How to Use' }}
    </h2>

    {%- if section.settings.content != blank -%}
      <div class="animate-on-scroll" data-animation="fade-in-up" style="max-width: 800px; margin: 0 auto 2rem;">
        {{ section.settings.content }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="benefits-list">
        {%- for block in section.blocks -%}
          <div class="benefit-item animate-on-scroll delay-{{ forloop.index }}" data-animation="scale-in" {{ block.shopify_attributes }}>
            <div class="benefit-icon" style="background-color: var(--color-primary-nav);">
              {{ forloop.index }}
            </div>
            <div class="benefit-content">
              <h4>{{ block.settings.step_title }}</h4>
              <p>{{ block.settings.step_description }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product How To Use",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "How to Use"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Main Content (Optional)"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "step_title",
          "label": "Step Title",
          "default": "Step 1"
        },
        {
          "type": "textarea",
          "id": "step_description",
          "label": "Step Description",
          "default": "Follow this simple step"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product How To Use"
    }
  ]
}
{% endschema %}
