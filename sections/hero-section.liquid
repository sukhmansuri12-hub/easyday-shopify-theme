{% comment %}
  Hero Section - Premium Background Image & New Text
{% endcomment %}

<section class="hero-section scroll-reveal" style="background-image: url({% if section.settings.bg_image %}{{ section.settings.bg_image | image_url }}{% else %}{{ 'easyday-hero-bg.jpg' | asset_url }}{% endif %});">
  <div class="hero-overlay"></div>
  <div class="container">
    <div class="hero-content scroll-reveal">
      {%- if section.settings.heading != blank -%}
        <h1 class="hero-title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      
      {%- if section.settings.subheading != blank -%}
        <!-- Subheading Hidden for V25 Minimalism -->
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <!-- Description Hidden for V25 Minimalism -->
      {%- endif -%}
      
      <div class="hero-buttons">
         {%- if section.settings.show_sale_btn -%}
            <button class="btn btn-sale" onclick="document.querySelector('.featured-products-mock').scrollIntoView({behavior: 'smooth'})">SALE 50% OFF</button>
         {%- endif -%}

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Smart Solutions for Everyday Life"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover problem-solving products that make your day easier"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We make things that work better and last longer. Our products solve real problems with clean design and honest materials."
    },
    {
      "type": "checkbox",
      "id": "show_sale_btn",
      "label": "Show 50% Sale Button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Section"
    }
  ]
}
{% endschema %}
