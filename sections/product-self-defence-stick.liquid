{% comment %}
  Self Defence Stick - Premium Product Page
  Mobile-First | Blue Brand Color | Prepaid Conversion Optimized
{% endcomment %}

{% render 'product-page-desktop.css' %}

<section class="sds-page">

  <!-- ═══════════════════════════════════════════
       PREPAID ANNOUNCEMENT BAR (sticky top)
  ═══════════════════════════════════════════ -->
  <div class="sds-prepaid-bar">
    <div class="sds-prepaid-bar__marquee">
      <span>🎉 15% OFF on Prepaid Orders&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;🎉 15% OFF on Prepaid Orders&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;🎉 15% OFF on Prepaid Orders&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       IMAGE GALLERY WITH ARROW NAVIGATION
  ═══════════════════════════════════════════ -->
  <div class="sds-gallery" id="sds-gallery">
    <div class="sds-gallery__track" id="sds-track">
      {% for image in product.images %}
        <div class="sds-gallery__slide">
          <img
            src="{{ image | img_url: 'master' }}"
            alt="{{ product.title }} - Image {{ forloop.index }}"
            loading="{{ forloop.first | default: 'eager' }}"
          >
        </div>
      {% endfor %}
    </div>

    <!-- Arrow Buttons -->
    <button class="sds-gallery__arrow sds-gallery__arrow--prev" id="sds-prev" aria-label="Previous image">&#8249;</button>
    <button class="sds-gallery__arrow sds-gallery__arrow--next" id="sds-next" aria-label="Next image">&#8250;</button>

    <!-- Counter Badge -->
    <div class="sds-gallery__counter" id="sds-counter">1 / {{ product.images.size }}</div>
  </div>

  <!-- ═══════════════════════════════════════════
       PRODUCT INFO SECTION
  ═══════════════════════════════════════════ -->
  <div class="sds-info">

    <!-- Rating (immediately below gallery, like screenshot) -->
    <div class="sds-rating">
      <span class="sds-rating__stars">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="#1a56db" xmlns="http://www.w3.org/2000/svg"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32-3.87-3.77 5.34-.78L10 1z"/></svg>
        <svg width="16" height="16" viewBox="0 0 20 20" fill="#1a56db" xmlns="http://www.w3.org/2000/svg"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32-3.87-3.77 5.34-.78L10 1z"/></svg>
        <svg width="16" height="16" viewBox="0 0 20 20" fill="#1a56db" xmlns="http://www.w3.org/2000/svg"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32-3.87-3.77 5.34-.78L10 1z"/></svg>
        <svg width="16" height="16" viewBox="0 0 20 20" fill="#1a56db" xmlns="http://www.w3.org/2000/svg"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32-3.87-3.77 5.34-.78L10 1z"/></svg>
        <svg width="16" height="16" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="hg"><stop offset="80%" stop-color="#1a56db"/><stop offset="80%" stop-color="#e0e0e0"/></linearGradient></defs><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32-3.87-3.77 5.34-.78L10 1z" fill="url(#hg)"/></svg>
      </span>
      <span class="sds-rating__text">Rated 4.8/5 by <strong>329+ Customers</strong></span>
    </div>

    <!-- Title -->
    <h1 class="sds-title">{{ product.title }}</h1>

    <!-- Price Row -->
    <div class="sds-price-row">
      <span class="sds-price__current">{{ product.price | money }}</span>
      {% if product.compare_at_price > product.price %}
        <span class="sds-price__compare">{{ product.compare_at_price | money }}</span>
        {% assign savings_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
        <span class="sds-price__badge">💙 SAVE {{ savings_pct }}%</span>
      {% endif %}
    </div>

    <!-- 3 Benefit Bullets (like screenshot) -->
    <div class="sds-benefits">
      <p class="sds-benefits__headline">Feel Safe. Move Confidently.</p>
      <ul class="sds-benefits__list">
        <li>
          <span class="sds-benefit-icon">🛡️</span>
          Instant snap expansion — ready in less than a second
        </li>
        <li>
          <span class="sds-benefit-icon">🔩</span>
          Solid industrial steel — no batteries, no plastic parts
        </li>
        <li>
          <span class="sds-benefit-icon">🚗</span>
          Built-in glass breaker tip for emergency car escapes
        </li>
      </ul>
    </div>

    <!-- Bundle Pack Selector -->
    <div class="sds-bundle">
      <p class="sds-bundle__title">— BUNDLE OFFER —</p>
      <label class="sds-bundle__option sds-bundle__option--selected" id="sds-bundle-1" onclick="sdsSelectBundle(1, this)">
        <span class="sds-bundle__radio" id="sds-radio-1">●</span>
        <span class="sds-bundle__details">
          <span class="sds-bundle__pack">Pack of 1</span>
          <span class="sds-bundle__sub">Perfect for yourself</span>
        </span>
        <span class="sds-bundle__price">Rs. 799 <span class="sds-bundle__compare">Rs. 1,599</span></span>
      </label>
      <label class="sds-bundle__option" id="sds-bundle-2" onclick="sdsSelectBundle(2, this)">
        <span class="sds-bundle__radio" id="sds-radio-2">○</span>
        <span class="sds-bundle__details">
          <span class="sds-bundle__pack">Pack of 2</span>
          <span class="sds-bundle__sub">Share with family</span>
        </span>
        <span class="sds-bundle__price">Rs. 1,499 <span class="sds-bundle__compare">Rs. 3,198</span></span>
      </label>
    </div>

    <!-- Shopify Form (variant hidden input for checkout) -->
    {% form 'product', product, id: 'sds-product-form' %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="sds-variant-id">

      <!-- CTAs: Add to Cart first, then Buy Now -->
      <div class="sds-buy-section" id="sds-buy-section">
        <!-- Add to Cart -->
        <button class="sds-btn-addtocart" type="submit" name="add" id="sds-addtocart-btn">
          <span class="sds-btn__main">🛒 Add to Cart</span>
        </button>

        <!-- Buy Now (Prepaid) -->
        <div class="sds-prepaid-badge">🎉 EXTRA 15% OFF — Pay Online & Save More</div>
        <button class="sds-btn-buynow" type="button" id="sds-buynow-btn" onclick="sdsBuyNow()">
          <span class="sds-btn__main">⚡ BUY NOW — Pay Online</span>
          <span class="sds-btn__sub">
            GPay &bull; PhonePe &bull; UPI &bull; Cards
          </span>
        </button>
      </div>
    {% endform %}

    <!-- Delivery Estimator (below CTAs) -->
    <div class="sds-delivery">
      <span class="sds-delivery__icon">📦</span>
      <div class="sds-delivery__text">
        <span class="sds-delivery__label">Estimated Delivery</span>
        <span class="sds-delivery__date" id="sds-delivery-date">Calculating...</span>
      </div>
      <span class="sds-delivery__badge">FREE</span>
    </div>

    <!-- Trust Strip -->
    <div class="sds-trust-strip">
      <div class="sds-trust-item">
        <span class="sds-trust-icon">🚀</span>
        <span>Free Shipping</span>
      </div>
      <div class="sds-trust-item">
        <span class="sds-trust-icon">🔄</span>
        <span>7 Day Easy Return</span>
      </div>
      <div class="sds-trust-item">
        <span class="sds-trust-icon">🛡️</span>
        <span>Secure Checkout</span>
      </div>
    </div>

  </div><!-- /sds-info -->

  <!-- ═══════════════════════════════════════════
       PRODUCT DESCRIPTION (from Shopify product)
  ═══════════════════════════════════════════ -->
  <div class="sds-description">
    {%- if product.description != blank -%}
      {{ product.description }}
    {%- else -%}
      <div class="desc-block-rc">
        <h3>🛡️ Strong Build. Instant Action.</h3>
        <p>The Expandable Tactical Defense Stick is designed for real-world situations — for late-night walks, solo travel, emergencies, and everyday peace of mind. Feel safe. Move confidently.</p>
      </div>
      <div class="desc-block-rc">
        <h3>👜 Protection That Fits in Her Bag</h3>
        <p>Heavy-duty steel protection that fits in her purse/bag, plus a built-in tip to break glass if needed for emergency escapes.</p>
      </div>
      <div class="desc-block-rc">
        <h3>💪 Unbreakable Quality.</h3>
        <p>No batteries. No plastic parts. Built to survive anything. Drive a car over it — it still works perfectly.</p>
      </div>
    {%- endif -%}
  </div>

  <!-- ═══════════════════════════════════════════
       REVIEWS — HORIZONTAL SCROLL CAROUSEL
  ═══════════════════════════════════════════ -->
  <div class="sds-reviews">
    <div class="sds-reviews__header">
      <h2 class="sds-reviews__title">Customer Reviews</h2>
      <div class="sds-reviews__summary">
        <span class="sds-reviews__avg">4.8</span>
        <span class="sds-reviews__stars-sm">⭐⭐⭐⭐⭐</span>
        <span class="sds-reviews__count">329+ reviews</span>
      </div>
    </div>

    <!-- Horizontal scroll track -->
    <div class="sds-reviews__track" id="sds-reviews-track">

      <div class="sds-review-card">
        <div class="sds-review-card__top">
          <span class="sds-review-card__name">Meera K.</span>
          <span class="sds-review-card__verified">✓ Verified</span>
        </div>
        <div class="sds-review-card__stars">⭐⭐⭐⭐⭐</div>
        <p class="sds-review-card__text">"This is a must-have for every woman! Feels solid and safe. I carry it everywhere now. Highly recommend!"</p>
        <img src="https://cdn.shopify.com/s/files/1/0800/9229/9512/files/customerreview1.webp?v=1770330151" alt="Customer review" class="sds-review-card__img" loading="lazy">
      </div>

      <div class="sds-review-card">
        <div class="sds-review-card__top">
          <span class="sds-review-card__name">Rahul M.</span>
          <span class="sds-review-card__verified">✓ Verified</span>
        </div>
        <div class="sds-review-card__stars">⭐⭐⭐⭐⭐</div>
        <p class="sds-review-card__text">"The metal is incredibly strong! I use it for hiking now. It's perfect on rough terrain. Best purchase ever!"</p>
      </div>

      <div class="sds-review-card">
        <div class="sds-review-card__top">
          <span class="sds-review-card__name">Priya S.</span>
          <span class="sds-review-card__verified">✓ Verified</span>
        </div>
        <div class="sds-review-card__stars">⭐⭐⭐⭐⭐</div>
        <p class="sds-review-card__text">"Amazing product! The snap sound is loud and intimidating. Compact and easy to carry. Feel much safer now!"</p>
        <img src="https://cdn.shopify.com/s/files/1/0800/9229/9512/files/Customer_review12123.png?v=1770332744" alt="Customer review" class="sds-review-card__img" loading="lazy">
      </div>

      <div class="sds-review-card">
        <div class="sds-review-card__top">
          <span class="sds-review-card__name">Amit S.</span>
          <span class="sds-review-card__verified">✓ Verified</span>
        </div>
        <div class="sds-review-card__stars">⭐⭐⭐⭐⭐</div>
        <p class="sds-review-card__text">"Got it for my wife and daughter. Very sturdy build. The glass breaker tip is a great feature. Excellent purchase!"</p>
      </div>

      <div class="sds-review-card">
        <div class="sds-review-card__top">
          <span class="sds-review-card__name">Sneha R.</span>
          <span class="sds-review-card__verified">✓ Verified</span>
        </div>
        <div class="sds-review-card__stars">⭐⭐⭐⭐⭐</div>
        <p class="sds-review-card__text">"Best self-defense tool! Compact, powerful, and easy to use. Every girl should have this. 100% recommended!"</p>
        <img src="https://cdn.shopify.com/s/files/1/0800/9229/9512/files/ChatGPT_Image_Feb_6_2026_04_36_50_AM.png?v=1770332824" alt="Customer review" class="sds-review-card__img" loading="lazy">
      </div>

      <div class="sds-review-card">
        <div class="sds-review-card__top">
          <span class="sds-review-card__name">Vikram P.</span>
          <span class="sds-review-card__verified">✓ Verified</span>
        </div>
        <div class="sds-review-card__stars">⭐⭐⭐⭐⭐</div>
        <p class="sds-review-card__text">"Unbreakable quality! Tested it myself. Very impressed. Great for personal safety and emergency situations."</p>
      </div>

    </div><!-- /sds-reviews__track -->

    <!-- Write a Review Button -->
    <div class="sds-write-review-wrap">
      <button class="sds-write-review-btn" id="sds-write-review-btn" type="button">✍️ Write a Review</button>
    </div>

    <!-- Write a Review Form (hidden by default) -->
    <div class="sds-review-form" id="sds-review-form" style="display:none;">
      <h3 class="sds-review-form__title">Share Your Experience</h3>
      <div class="sds-review-form__stars" id="sds-star-picker">
        <span class="sds-star-pick" data-val="1">★</span>
        <span class="sds-star-pick" data-val="2">★</span>
        <span class="sds-star-pick" data-val="3">★</span>
        <span class="sds-star-pick" data-val="4">★</span>
        <span class="sds-star-pick" data-val="5">★</span>
      </div>
      <input type="text" class="sds-review-form__input" id="sds-review-name" placeholder="Your Name" maxlength="50">
      <textarea class="sds-review-form__textarea" id="sds-review-text" placeholder="Tell us about your experience..." maxlength="500" rows="4"></textarea>
      <button class="sds-review-form__submit" type="button" onclick="sdsSubmitReview()">Submit Review</button>
      <p class="sds-review-form__note">Your review helps others make a confident choice.</p>
    </div>

  </div><!-- /sds-reviews -->

  <!-- ═══════════════════════════════════════════
       FINAL SHAKE CTA (bottom of long scroll)
  ═══════════════════════════════════════════ -->
  <div class="sds-final-cta">
    <button class="sds-final-cta__btn" type="button" onclick="sdsScrollToBuy()">
      🛡️ GET YOURS NOW — 15% OFF PREPAID
    </button>
  </div>

  <!-- ═══════════════════════════════════════════
       STICKY BOTTOM BAR
  ═══════════════════════════════════════════ -->
  <div class="sds-sticky-bar" id="sds-sticky-bar">
    <div class="sds-sticky-bar__price">
      <span class="sds-sticky-bar__current">{{ product.price | money }}</span>
      {% if product.compare_at_price > product.price %}
        <span class="sds-sticky-bar__compare">{{ product.compare_at_price | money }}</span>
      {% endif %}
    </div>
    <button class="sds-sticky-bar__btn" type="button" onclick="sdsBuyNow()">
      ⚡ BUY NOW
    </button>
  </div>

</section><!-- /sds-page -->

<!-- ═══════════════════════════════════════════
     STYLES
═══════════════════════════════════════════ -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap');

  /* ── Brand Color Variables ── */
  :root {
    --sds-blue: #1a56db;
    --sds-blue-dark: #1340a8;
    --sds-blue-light: #e8f0fe;
    --sds-blue-mid: #2563eb;
    --sds-text: #111827;
    --sds-text-muted: #6b7280;
    --sds-border: #e5e7eb;
    --sds-bg: #ffffff;
    --sds-bg-subtle: #f8faff;
  }

  .sds-page {
    font-family: 'Poppins', sans-serif;
    background: var(--sds-bg);
    color: var(--sds-text);
    padding-bottom: 80px; /* space for sticky bar */
  }

  /* ── PREPAID ANNOUNCEMENT BAR ── */
  .sds-prepaid-bar {
    background: var(--sds-blue);
    color: #fff;
    padding: 8px 0;
    font-size: 0.82rem;
    font-weight: 600;
    overflow: hidden;
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(26,86,219,0.25);
    /* NOT sticky — only the site header is sticky */
  }
  .sds-prepaid-bar__marquee {
    display: inline-block;
    animation: sdsMarquee 14s linear infinite;
    white-space: nowrap;
  }
  @keyframes sdsMarquee {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-33.33%); }
  }

  /* ── GALLERY ── */
  .sds-gallery {
    position: relative;
    overflow: hidden;
    background: var(--sds-bg-subtle);
  }
  .sds-gallery__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    transition: transform 0.3s ease;
  }
  .sds-gallery__track::-webkit-scrollbar { display: none; }
  .sds-gallery__slide {
    min-width: 100%;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sds-gallery__slide img {
    width: 100%;
    height: 360px;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  /* Arrow buttons — small, transparent */
  .sds-gallery__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.25);
    border: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    font-size: 1.1rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: rgba(255,255,255,0.85);
    font-weight: 700;
    z-index: 10;
    transition: background 0.2s;
    padding: 0;
    backdrop-filter: blur(2px);
  }
  .sds-gallery__arrow:hover { background: rgba(255,255,255,0.45); }
  .sds-gallery__arrow--prev { left: 8px; }
  .sds-gallery__arrow--next { right: 8px; }

  /* Counter */
  .sds-gallery__counter {
    position: absolute;
    top: 12px;
    right: 14px;
    background: rgba(0,0,0,0.5);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 20px;
    z-index: 10;
  }

  /* ── PRODUCT INFO ── */
  .sds-info {
    padding: 16px 16px 0;
  }

  /* Rating */
  .sds-rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
  .sds-rating__stars {
    display: flex;
    gap: 2px;
  }
  .sds-rating__text {
    font-size: 0.82rem;
    color: var(--sds-text-muted);
  }
  .sds-rating__text strong { color: var(--sds-text); }

  /* Title */
  .sds-title {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 12px;
    color: var(--sds-text);
  }

  /* Price */
  .sds-price-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .sds-price__current {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--sds-blue);
  }
  .sds-price__compare {
    text-decoration: line-through;
    color: #9ca3af;
    font-size: 0.82rem;
  }
  .sds-price__badge {
    background: var(--sds-blue);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;
    letter-spacing: 0.03em;
  }

  /* Benefits */
  .sds-benefits {
    background: var(--sds-blue-light);
    border-radius: 12px;
    padding: 14px 16px;
    margin-bottom: 16px;
    border-left: 3px solid var(--sds-blue);
  }
  .sds-benefits__headline {
    font-weight: 700;
    font-size: 0.92rem;
    margin: 0 0 10px;
    color: var(--sds-blue-dark);
  }
  .sds-benefits__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sds-benefits__list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--sds-text);
    line-height: 1.4;
  }
  .sds-benefit-icon {
    font-size: 1rem;
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* Bundle Pack Selector */
  .sds-bundle {
    margin-bottom: 16px;
  }
  .sds-bundle__title {
    text-align: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--sds-text-muted);
    letter-spacing: 0.08em;
    margin: 0 0 10px;
  }
  .sds-bundle__option {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1.5px solid var(--sds-border);
    border-radius: 10px;
    padding: 12px 14px;
    margin-bottom: 8px;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    background: #fff;
  }
  .sds-bundle__option--selected {
    border-color: var(--sds-blue);
    background: var(--sds-blue-light);
  }
  .sds-bundle__radio {
    font-size: 1.1rem;
    color: var(--sds-border);
    flex-shrink: 0;
    transition: color 0.2s;
  }
  .sds-bundle__option--selected .sds-bundle__radio {
    color: var(--sds-blue);
  }
  .sds-bundle__details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sds-bundle__pack {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--sds-text);
  }
  .sds-bundle__sub {
    font-size: 0.75rem;
    color: var(--sds-text-muted);
  }
  .sds-bundle__price {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--sds-blue);
    text-align: right;
    white-space: nowrap;
  }
  .sds-bundle__compare {
    display: block;
    font-size: 0.72rem;
    font-weight: 400;
    text-decoration: line-through;
