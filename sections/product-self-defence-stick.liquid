  }
</style>

<!-- ═══════════════════════════════════════════
     SCRIPTS
═══════════════════════════════════════════ -->
<script>
(function() {
  // ── GALLERY ARROWS + DOTS ──
  const track = document.getElementById('sds-track');
  const dots = document.querySelectorAll('.sds-dot');
  const counter = document.getElementById('sds-counter');
  const totalSlides = {{ product.images.size }};
  let currentSlide = 0;

  function goToSlide(index) {
    if (index < 0) index = totalSlides - 1;
    if (index >= totalSlides) index = 0;
    currentSlide = index;
    const slideWidth = track.parentElement.offsetWidth;
    track.scrollTo({ left: slideWidth * currentSlide, behavior: 'smooth' });
    dots.forEach((d, i) => d.classList.toggle('active', i === currentSlide));
    if (counter) counter.textContent = (currentSlide + 1) + ' / ' + totalSlides;
  }

  document.getElementById('sds-prev')?.addEventListener('click', () => goToSlide(currentSlide - 1));
  document.getElementById('sds-next')?.addEventListener('click', () => goToSlide(currentSlide + 1));

  // Remove dots sync (dots removed from HTML)
  // dots array kept for backward compat but is empty

  // Sync dots on swipe
  if (track) {
    track.addEventListener('scroll', function() {
      const slideWidth = track.parentElement.offsetWidth || 1;
      const idx = Math.round(track.scrollLeft / slideWidth);
      if (idx !== currentSlide) {
        currentSlide = idx;
        dots.forEach((d, i) => d.classList.toggle('active', i === currentSlide));
        if (counter) counter.textContent = (currentSlide + 1) + ' / ' + totalSlides;
      }
    });
  }

  dots.forEach((dot, i) => dot.addEventListener('click', () => goToSlide(i)));

  // ── DELIVERY DATE ESTIMATOR ──
  function calcDelivery() {
    const today = new Date();
    const minDays = 3, maxDays = 4;
    const from = new Date(today); from.setDate(today.getDate() + minDays);
    const to = new Date(today); to.setDate(today.getDate() + maxDays);
    const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    const days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    const fmt = (d) => days[d.getDay()] + ', ' + d.getDate() + ' ' + months[d.getMonth()];
    const el = document.getElementById('sds-delivery-date');
    if (el) el.textContent = fmt(from) + ' – ' + fmt(to);
  }
  calcDelivery();

  // ── BUNDLE SELECTOR ──
  window.sdsSelectBundle = function(pack, el) {
    document.querySelectorAll('.sds-bundle__option').forEach(o => {
      o.classList.remove('sds-bundle__option--selected');
    });
    document.getElementById('sds-radio-1').textContent = '○';
    document.getElementById('sds-radio-2').textContent = '○';
    el.classList.add('sds-bundle__option--selected');
    document.getElementById('sds-radio-' + pack).textContent = '●';
  };

  // ── SCROLL TO BUY SECTION ──
  window.sdsScrollToBuy = function() {
    const buySection = document.getElementById('sds-buy-section');
    if (buySection) buySection.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  // ── BUY NOW (prepaid → direct Shopify checkout) ──
  window.sdsBuyNow = function() {
    const variantId = document.getElementById('sds-variant-id')?.value;
    if (!variantId) { window.location.href = '/cart'; return; }
    fetch('/cart/clear.js', { method: 'POST' })
      .then(() => fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: 1 })
      }))
      .then(() => { window.location.href = '/checkout'; })
      .catch(() => { window.location.href = '/cart'; });
  };

  // ── WRITE A REVIEW TOGGLE ──
  const writeBtn = document.getElementById('sds-write-review-btn');
  const reviewForm = document.getElementById('sds-review-form');
  if (writeBtn && reviewForm) {
    writeBtn.addEventListener('click', function() {
      const isOpen = reviewForm.style.display !== 'none';
      reviewForm.style.display = isOpen ? 'none' : 'block';
      writeBtn.textContent = isOpen ? '✍️ Write a Review' : '✕ Cancel';
      if (!isOpen) reviewForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  }

  // ── STAR PICKER ──
  const stars = document.querySelectorAll('.sds-star-pick');
  let selectedRating = 0;
  stars.forEach(star => {
    star.addEventListener('mouseover', function() {
      const val = parseInt(this.dataset.val);
      stars.forEach((s, i) => s.style.color = i < val ? '#f59e0b' : '#d1d5db');
    });
    star.addEventListener('click', function() {
      selectedRating = parseInt(this.dataset.val);
      stars.forEach((s, i) => {
        s.style.color = i < selectedRating ? '#f59e0b' : '#d1d5db';
        s.classList.toggle('selected', i < selectedRating);
      });
    });
  });
  document.getElementById('sds-star-picker')?.addEventListener('mouseleave', function() {
    stars.forEach((s, i) => s.style.color = i < selectedRating ? '#f59e0b' : '#d1d5db');
  });

  // ── SUBMIT REVIEW ──
  window.sdsSubmitReview = function() {
    const name = document.getElementById('sds-review-name')?.value.trim();
    const text = document.getElementById('sds-review-text')?.value.trim();
    if (!name || !text || selectedRating === 0) {
      alert('Please fill in your name, rating, and review before submitting.');
      return;
    }
    // Add the new review card to the track
    const track = document.getElementById('sds-reviews-track');
    if (track) {
      const card = document.createElement('div');
      card.className = 'sds-review-card';
      const stars = '⭐'.repeat(selectedRating);
      card.innerHTML = `
        <div class="sds-review-card__top">
          <span class="sds-review-card__name">${name.substring(0,20)}</span>
          <span class="sds-review-card__verified">✓ Verified</span>
        </div>
        <div class="sds-review-card__stars">${stars}</div>
        <p class="sds-review-card__text">"${text.substring(0,300)}"</p>
      `;
      track.appendChild(card);
      card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
    // Reset form
    if (reviewForm) reviewForm.style.display = 'none';
    if (writeBtn) writeBtn.textContent = '✍️ Write a Review';
    document.getElementById('sds-review-name').value = '';
    document.getElementById('sds-review-text').value = '';
    selectedRating = 0;
    alert('✅ Thank you for your review!');
  };
})();
</script>
