{% comment %}
  Self Defence Stick - Premium Product Page
  Mobile-First | Blue Brand Color | Prepaid Conversion Optimized
{% endcomment %}

{% render 'product-page-desktop.css' %}

<section class="sds-page">

  <!-- Removed prepaid bar per request -->

  <!-- ═══════════════════════════════════════════
       IMAGE GALLERY WITH ARROW NAVIGATION
  ═══════════════════════════════════════════ -->
  <div class="sds-gallery" id="sds-gallery">
    <div class="sds-gallery__track" id="sds-track">
      {% for image in product.images %}
        <div class="sds-gallery__slide">
          <img
            src="{{ image | img_url: 'master' }}"
            alt="{{ product.title }} - Image {{ forloop.index }}"
            loading="{{ forloop.first | default: 'eager' }}"
          >
        </div>
      {% endfor %}
    </div>

    <!-- Arrow Buttons -->
    <button class="sds-gallery__arrow sds-gallery__arrow--prev" id="sds-prev" aria-label="Previous image">&#8249;</button>
    <button class="sds-gallery__arrow sds-gallery__arrow--next" id="sds-next" aria-label="Next image">&#8250;</button>

    <!-- Counter Badge -->
    <div class="sds-gallery__counter" id="sds-counter">1 / {{ product.images.size }}</div>
  </div>

  <!-- ═══════════════════════════════════════════
       PRODUCT INFO SECTION
  ═══════════════════════════════════════════ -->
  <div class="sds-info">

    <!-- Rating (immediately below gallery, like screenshot) -->
    <div class="sds-reviews__header" style="padding:0;">
      <div class="sds-rating" style="margin-bottom:0;">
        <span class="sds-rating__stars">
          <span class="sds-star-badge">★</span>
          <span class="sds-star-badge">★</span>
          <span class="sds-star-badge">★</span>
          <span class="sds-star-badge">★</span>
          <span class="sds-star-badge">★</span>
        </span>
        <span class="sds-rating__text" style="font-size: 0.85rem;">Rated 4.8/5 by <strong>329+ Customers</strong></span>
      </div>
    </div>

    <!-- Title -->
    <h1 class="sds-title">{{ product.title }}</h1>

    <!-- Price Row -->
    <div class="sds-price-row">
      <span class="sds-price__current">{{ product.price | money }}</span>
      {% if product.compare_at_price > product.price %}
        <span class="sds-price__compare">{{ product.compare_at_price | money }}</span>
        {% assign savings_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
        <span class="sds-price__badge"><svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="14" height="14" style="flex-shrink:0"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg> SAVE {{ savings_pct }}%</span>
      {% endif %}
    </div>

    <!-- 3 Benefit Bullets (like screenshot) -->
    <div class="sds-benefits">
      <p class="sds-benefits__headline">Feel Safe. Move Confidently.</p>
      <ul class="sds-benefits__list">
        <li>
          <span class="sds-benefit-icon">🛡️</span>
          Instant snap expansion — ready in 1 second
        </li>
        <li>
          <span class="sds-benefit-icon">🔩</span>
          Solid industrial steel — no plastic parts
        </li>
        <li>
          <span class="sds-benefit-icon">🚗</span>
          Built-in glass breaker for car escapes
        </li>
      </ul>
    </div>

    <!-- Bundle Pack Selector -->
    <div class="sds-bundle">
      <div class="sds-bundle__title-wrapper">
        <span class="sds-bundle__title-line"></span>
        <span class="sds-bundle__title-text">BUNDLE OFFER</span>
        <span class="sds-bundle__title-line"></span>
      </div>
      <label class="sds-bundle__option sds-bundle__option--selected" id="sds-bundle-1" onclick="sdsSelectBundle(1, this)">
        <span class="sds-bundle__radio" id="sds-radio-1">●</span>
        <span class="sds-bundle__details">
          <span class="sds-bundle__pack">Pack of 1</span>
          <span class="sds-bundle__sub">Perfect for everyday use</span>
        </span>
        <span class="sds-bundle__price">Rs. 799 <span class="sds-bundle__compare">Rs. 1,599</span></span>
      </label>
      <label class="sds-bundle__option" id="sds-bundle-2" onclick="sdsSelectBundle(2, this)">
        <span class="sds-bundle__radio" id="sds-radio-2">○</span>
        <span class="sds-bundle__details">
          <span class="sds-bundle__pack">Pack of 2</span>
          <span class="sds-bundle__sub">Perfect for family</span>
        </span>
        <span class="sds-bundle__price">Rs. 1,499 <span class="sds-bundle__compare">Rs. 3,198</span></span>
      </label>
    </div>

    <!-- Shopify Form (variant hidden input for checkout) -->
    {% form 'product', product, id: 'sds-product-form' %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="sds-variant-id">

      <!-- CTAs: Add to Cart first, then Buy Now -->
      <div class="sds-buy-section" id="sds-buy-section">
        <!-- Add to Cart -->
        <button class="sds-btn-addtocart" type="submit" name="add" id="sds-addtocart-btn">
          <svg class="sds-cart-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          Add to Cart
        </button>

        <!-- Buy Now (Prepaid) -->
        <div class="sds-prepaid-badge">EXTRA Rs 100 OFF on PREPAID ORDERS</div>
        <button class="sds-btn-buynow" type="button" id="sds-buynow-btn" onclick="sdsBuyNow()">
          <span class="sds-buynow-text">BUY NOW</span>
          <span class="sds-payment-logos">
            <!-- GPay -->
            <svg class="sds-pay-logo" viewBox="0 0 48 20" xmlns="http://www.w3.org/2000/svg"><text y="15" font-size="14" font-family="Arial" font-weight="700" fill="white">G Pay</text></svg>
            <!-- PhonePe -->
            <svg class="sds-pay-logo" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="12" fill="#5f259f"/><path d="M16.5 7.5h-3.75L9 12l3.75 5.25h3.75L12.75 12z" fill="white"/></svg>
            <!-- UPI -->
            <svg class="sds-pay-logo" viewBox="0 0 48 20" xmlns="http://www.w3.org/2000/svg"><text y="15" font-size="13" font-family="Arial" font-weight="700" fill="white">UPI</text></svg>
            <!-- Paytm -->
            <svg class="sds-pay-logo" viewBox="0 0 48 20" xmlns="http://www.w3.org/2000/svg"><text y="15" font-size="11" font-family="Arial" font-weight="700" fill="#00BAF2">Paytm</text></svg>
          </span>
        </button>
      </div>
    {% endform %}

    <!-- Delivery Estimator (below CTAs) -->
    <div class="sds-delivery">
      <span class="sds-delivery__icon">📦</span>
      <div class="sds-delivery__text">
        <span class="sds-delivery__label">Estimated Delivery</span>
        <span class="sds-delivery__date" id="sds-delivery-date">Calculating...</span>
      </div>
      <span class="sds-delivery__badge">FREE</span>
    </div>

    <!-- Trust Strip -->
    <div class="sds-trust-strip">
      <div class="sds-trust-item">
        <div class="sds-trust-icon-circle">
          <svg viewBox="0 0 24 24" fill="none" class="sds-trust-svg"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle><path d="M-3 9h4M-2 13h3"></path></svg>
        </div>
        <span>Free Shipping</span>
      </div>
      <div class="sds-trust-item">
        <div class="sds-trust-icon-circle">
          <svg viewBox="0 0 24 24" fill="none" class="sds-trust-svg"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v12m-2-9a2 2 0 114 0c0 1.5-4 2.5-4 4a2 2 0 104 0"></path></svg>
        </div>
        <span>Secure Checkout</span>
      </div>
      <div class="sds-trust-item">
        <div class="sds-trust-icon-circle">
          <svg viewBox="0 0 24 24" fill="none" class="sds-trust-svg"><path d="M21 8l-9 5-9-5 9-5 9 5zM21 8v8l-9 5v-8m-9 5v-8"></path></svg>
        </div>
        <span>7-Day Easy<br>Returns</span>
      </div>
    </div>

  </div><!-- /sds-info -->

  <!-- ═══════════════════════════════════════════
       PRODUCT DESCRIPTION (from Shopify product)
  ═══════════════════════════════════════════ -->
  <div class="sds-description">
    {%- if product.description != blank -%}
      {{ product.description }}
    {%- else -%}
      <div class="desc-block-rc">
        <h3>🛡️ Strong Build. Instant Action.</h3>
        <p>The Expandable Tactical Defense Stick is designed for real-world situations — for late-night walks, solo travel, emergencies, and everyday peace of mind. Feel safe. Move confidently.</p>
      </div>
      <div class="desc-block-rc">
        <h3>👜 Protection That Fits in Her Bag</h3>
        <p>Heavy-duty steel protection that fits in her purse/bag, plus a built-in tip to break glass if needed for emergency escapes.</p>
      </div>
      <div class="desc-block-rc">
        <h3>💪 Unbreakable Quality.</h3>
        <p>No batteries. No plastic parts. Built to survive anything. Drive a car over it — it still works perfectly.</p>
      </div>
    {%- endif -%}
  </div>

  <!-- ═══════════════════════════════════════════
       ACCORDION (Collapsible Rows)
  ═══════════════════════════════════════════ -->
  <div class="sds-accordion">
    <div class="sds-accordion__item">
      <button class="sds-accordion__btn" onclick="sdsToggleAccordion(this)">
        <span class="sds-accordion__icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
        <span class="sds-accordion__title">Quality Assurance</span>
        <span class="sds-accordion__plus">+</span>
      </button>
      <div class="sds-accordion__content">
        <p>Every order undergoes a rigorous quality and assurance check before being shipped out. We pride ourselves on delivering premium quality accessories that you will absolutely love.</p>
      </div>
    </div>
    <div class="sds-accordion__item">
      <button class="sds-accordion__btn" onclick="sdsToggleAccordion(this)">
        <span class="sds-accordion__icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="M16 8h-4a2 2 0 100 4h4a2 2 0 110 4h-4m-2-6v8"/></svg></span>
        <span class="sds-accordion__title">Moneyback Guarantee</span>
        <span class="sds-accordion__plus">+</span>
      </button>
      <div class="sds-accordion__content">
        <p>Not happy with your order? Get in touch with our support team via email and we'll make it right. Every order is tracked and insured during transit for your peace of mind. You can also read our return policy for more details.</p>
      </div>
    </div>
    <div class="sds-accordion__item">
      <button class="sds-accordion__btn" onclick="sdsToggleAccordion(this)">
        <span class="sds-accordion__icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg></span>
        <span class="sds-accordion__title">Product specifications</span>
        <span class="sds-accordion__plus">+</span>
      </button>
      <div class="sds-accordion__content">
        <ul style="padding-left: 20px; list-style-type: disc; margin: 0; line-height: 1.6;">
          <li><strong>Material:</strong> Military-grade solid steel equipment</li>
          <li><strong>Length:</strong> 2.2 feet fully expanded</li>
          <li><strong>Weight:</strong> 500g</li>
          <li><strong>Grip:</strong> Anti-slip rubber handle</li>
          <li><strong>Color:</strong> Matte Black</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       REVIEWS — MASONRY 2-COLUMN GRID
  ═══════════════════════════════════════════ -->
  <div class="sds-reviews">

    <!-- Header: stars + count only (like Glimmi) -->
    <div class="sds-reviews__header">
      <div class="sds-rating" style="margin-bottom: 0;">
        <span class="sds-rating__stars">
          <span class="sds-star-badge">★</span>
          <span class="sds-star-badge">★</span>
          <span class="sds-star-badge">★</span>
          <span class="sds-star-badge">★</span>
          <span class="sds-star-badge">★</span>
        </span>
        <span class="sds-rating__text" style="font-size: 0.85rem;">Rated 4.8/5 by <strong>329+ Customers</strong></span>
      </div>
    </div>

    <!-- Masonry 2-column grid — image reviews first, then text-only -->
    <div class="sds-reviews__masonry" id="sds-reviews-track">

      <!-- IMAGE REVIEWS (top of grid) -->
      <div class="sds-mcard sds-mcard--img">
        <img src="https://cdn.shopify.com/s/files/1/0800/9229/9512/files/customerreview1.webp?v=1770330151" alt="Meera K. review" class="sds-mcard__img" loading="lazy">
        <div class="sds-mcard__name">Meera K.</div>
        <div class="sds-mcard__stars">⭐⭐⭐⭐⭐</div>
        <p class="sds-mcard__text">"Must-have for every woman! Feels solid and safe."</p>
      </div>

      <div class="sds-mcard sds-mcard--img">
        <img src="https://cdn.shopify.com/s/files/1/0800/9229/9512/files/Customer_review12123.png?v=1770332744" alt="Priya S. review" class="sds-mcard__img" loading="lazy">
        <div class="sds-mcard__name">Priya S.</div>
        <div class="sds-mcard__stars">⭐⭐⭐⭐⭐</div>
        <p class="sds-mcard__text">"Snap sound is intimidating. Compact and easy to carry!"</p>
      </div>

      <div class="sds-mcard sds-mcard--img">
        <img src="https://cdn.shopify.com/s/files/1/0800/9229/9512/files/ChatGPT_Image_Feb_6_2026_04_36_50_AM.png?v=1770332824" alt="Sneha R. review" class="sds-mcard__img" loading="lazy">
        <div class="sds-mcard__name">Sneha R.</div>
        <div class="sds-mcard__stars">⭐⭐⭐⭐⭐</div>
        <p class="sds-mcard__text">"Best self-defense tool! Every girl should have this."</p>
      </div>

      <!-- TEXT-ONLY REVIEWS (below image reviews, same grid) -->
      <div class="sds-mcard">
        <div class="sds-mcard__name">Rahul M.</div>
        <div class="sds-mcard__stars">⭐⭐⭐⭐⭐</div>
        <p class="sds-mcard__text">"The metal is incredibly strong! I use it for hiking now. Perfect on rough terrain. Best purchase ever!"</p>
        <span class="sds-mcard__verified">✓ Verified</span>
      </div>

      <div class="sds-mcard">
        <div class="sds-mcard__name">Amit S.</div>
        <div class="sds-mcard__stars">⭐⭐⭐⭐⭐</div>
        <p class="sds-mcard__text">"Got it for my wife and daughter. Very sturdy build. The glass breaker tip is a great feature!"</p>
        <span class="sds-mcard__verified">✓ Verified</span>
      </div>

      <div class="sds-mcard">
        <div class="sds-mcard__name">Vikram P.</div>
        <div class="sds-mcard__stars">⭐⭐⭐⭐⭐</div>
        <p class="sds-mcard__text">"Unbreakable quality! Tested it myself. Very impressed. Great for personal safety and emergencies."</p>
        <span class="sds-mcard__verified">✓ Verified</span>
      </div>

    </div><!-- /sds-reviews__masonry -->

    <!-- Write a Review Button -->
    <div class="sds-write-review-wrap">
      <button class="sds-write-review-btn" id="sds-write-review-btn" type="button">✍️ Write a Review</button>
    </div>

    <!-- Write a Review Form (hidden by default) -->
    <div class="sds-review-form" id="sds-review-form" style="display:none;">
      <h3 class="sds-review-form__title">Share Your Experience</h3>
      <div class="sds-review-form__stars" id="sds-star-picker">
        <span class="sds-star-pick" data-val="1">★</span>
        <span class="sds-star-pick" data-val="2">★</span>
        <span class="sds-star-pick" data-val="3">★</span>
        <span class="sds-star-pick" data-val="4">★</span>
        <span class="sds-star-pick" data-val="5">★</span>
      </div>
      <input type="text" class="sds-review-form__input" id="sds-review-name" placeholder="Your Name" maxlength="50">
      <textarea class="sds-review-form__textarea" id="sds-review-text" placeholder="Tell us about your experience..." maxlength="500" rows="4"></textarea>
      <button class="sds-review-form__submit" type="button" onclick="sdsSubmitReview()">Submit Review</button>
      <p class="sds-review-form__note">Your review helps others make a confident choice.</p>
    </div>

  </div><!-- /sds-reviews -->

  <!-- ═══════════════════════════════════════════
       FINAL SHAKE CTA (bottom of long scroll)
  ═══════════════════════════════════════════ -->
  <div class="sds-final-cta">
    <button class="sds-final-cta__btn" type="button" onclick="sdsScrollToBuy()">
      🛡️ GET YOURS NOW — FLAT Rs 100 OFF
    </button>
  </div>

  <!-- ═══════════════════════════════════════════
       STICKY BOTTOM BAR
  ═══════════════════════════════════════════ -->
  <div class="sds-sticky-bar" id="sds-sticky-bar">
    <div class="sds-sticky-bar__price">
      <span class="sds-sticky-bar__current">{{ product.price | money }}</span>
      {% if product.compare_at_price > product.price %}
        <span class="sds-sticky-bar__compare">{{ product.compare_at_price | money }}</span>
      {% endif %}
    </div>
    <button class="sds-sticky-bar__btn" type="button" onclick="sdsBuyNow()">
      BUY NOW
      <span class="sds-sticky-pay-logos">
        <svg viewBox="0 0 38 16" xmlns="http://www.w3.org/2000/svg" height="14"><text y="12" font-size="12" font-family="Arial" font-weight="700" fill="white">G Pay</text></svg>
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" height="16"><circle cx="12" cy="12" r="12" fill="#5f259f"/><path d="M16.5 7.5h-3.75L9 12l3.75 5.25h3.75L12.75 12z" fill="white"/></svg>
        <svg viewBox="0 0 34 16" xmlns="http://www.w3.org/2000/svg" height="14"><text y="12" font-size="12" font-family="Arial" font-weight="700" fill="white">UPI</text></svg>
      </span>
    </button>
  </div>

</section><!-- /sds-page -->

<!-- ═══════════════════════════════════════════
     STYLES
═══════════════════════════════════════════ -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap');

  /* ── Brand Color Variables ── */
  :root {
    --sds-blue: #1a56db;
    --sds-blue-dark: #1340a8;
    --sds-blue-light: #e8f0fe;
    --sds-blue-mid: #2563eb;
    --sds-text: #111827;
    --sds-text-muted: #6b7280;
    --sds-border: #e5e7eb;
    --sds-bg: #ffffff;
    --sds-bg-subtle: #f8faff;
  }

  .sds-page {
    font-family: 'Poppins', sans-serif;
    background: var(--sds-bg);
    color: var(--sds-text);
    padding-bottom: 65px; /* space for sticky bar */
  }

  /* Prepaid bar removed per request */

  /* ── GALLERY ── */
  .sds-gallery {
    position: relative;
    overflow: hidden;
    background: var(--sds-bg-subtle);
  }
  .sds-gallery__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    transition: transform 0.3s ease;
  }
  .sds-gallery__track::-webkit-scrollbar { display: none; }
  .sds-gallery__slide {
    min-width: 100%;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sds-gallery__slide img {
    width: 100%;
    height: 360px;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  /* Arrow buttons — pure white text, fully transparent background */
  .sds-gallery__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    font-size: 1.5rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #ffffff;
    font-weight: 300;
    z-index: 10;
    padding: 0;
    text-shadow: 0 1px 4px rgba(0,0,0,0.6);
  }
  .sds-gallery__arrow:hover { color: #ffffff; }
  .sds-gallery__arrow--prev { left: 6px; }
  .sds-gallery__arrow--next { right: 6px; }

  /* Counter */
  .sds-gallery__counter {
    position: absolute;
    top: 12px;
    right: 14px;
    background: rgba(0,0,0,0.5);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 20px;
    z-index: 10;
  }

  /* ── PRODUCT INFO ── */
  .sds-info {
    padding: 16px 16px 0;
  }

  /* Rating */
  .sds-rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
  .sds-rating__stars {
    display: flex;
    gap: 3px;
  }
  .sds-star-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 17px;
    height: 17px;
    background: var(--sds-blue);
    color: #fff;
    font-size: 0.7rem;
    border-radius: 3px;
  }
  .sds-rating__text {
    font-size: 0.82rem;
    color: var(--sds-text-muted);
  }
  .sds-rating__text strong { color: var(--sds-text); }

  /* Title */
  .sds-title {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 12px;
