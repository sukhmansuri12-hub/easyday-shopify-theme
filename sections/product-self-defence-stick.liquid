{% comment %}
  Self Defence Stick - Premium Product Page
  Mobile-First | Blue Brand Color | Prepaid Conversion Optimized
{% endcomment %}

{% render 'product-page-desktop.css' %}

<section class="sds-page">

  <!-- Removed prepaid bar per request -->

  <!-- ═══════════════════════════════════════════
       IMAGE GALLERY WITH ARROW NAVIGATION
  ═══════════════════════════════════════════ -->
  <div class="sds-gallery-container" style="margin-top: 0; padding-top: 0;">
    <div class="sds-gallery" id="sds-gallery" style="border-top: none;">
      <div class="sds-gallery__track" id="sds-track">
        {% for image in product.images %}
          <div class="sds-gallery__slide">
            <img
              src="{{ image | img_url: 'master' }}"
              alt="{{ product.title }} - Image {{ forloop.index }}"
              loading="{{ forloop.first | default: 'eager' }}"
            >
          </div>
        {% endfor %}
      </div>
      <!-- NO arrows or counter on main image — Glitterbabe style: clean & minimal -->
    </div>

    <!-- ── THUMBNAIL TRACK (navigation only at bottom) ── -->
    <div class="sds-thumbnails-wrapper">
      <button class="sds-thumb-arrow sds-thumb-arrow--prev" id="sds-thumb-prev">‹</button>
      <div class="sds-thumbnails" id="sds-thumbnails">
        {% for image in product.images %}
          <div class="sds-thumb-item {% if forloop.first %}is-active{% endif %}" onclick="sdsJumpToSlide({{ forloop.index0 }})">
            <img src="{{ image | img_url: '140x140', crop: 'center' }}" alt="Thumb {{ forloop.index }}">
          </div>
        {% endfor %}
      </div>
      <button class="sds-thumb-arrow sds-thumb-arrow--next" id="sds-thumb-next">›</button>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       PRODUCT INFO SECTION
  ═══════════════════════════════════════════ -->
  <div class="sds-info">

    <!-- Rating (Static Summary) -->
    <div class="sds-reviews__header" style="padding:0;">
      <div class="sds-rating" style="margin-bottom:0;">
        <span class="sds-rating__stars">
          <span class="sds-star-badge">★</span>
          <span class="sds-star-badge">★</span>
          <span class="sds-star-badge">★</span>
          <span class="sds-star-badge">★</span>
          <span class="sds-star-badge">★</span>
        </span>
        <span class="sds-rating__text" style="font-size: 0.85rem;">Rated 4.7/5 by <strong>329+ Customers</strong></span>
      </div>
    </div>

    <!-- Title -->
    <h1 class="sds-title">{{ product.title }}</h1>

    <!-- Price Row -->
    <div class="sds-price-row">
      <span class="sds-price__current">{{ product.price | money }}</span>
      {% if product.compare_at_price > product.price %}
        <span class="sds-price__compare">{{ product.compare_at_price | money }}</span>
        {% assign savings_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
        <span class="sds-price__badge"><svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="14" height="14" style="flex-shrink:0"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg> SAVE {{ savings_pct }}%</span>
      {% endif %}
    </div>

    <!-- 3 Benefit Bullets with full text, single-line -->
    <div class="sds-benefits">
      <p class="sds-benefits__headline">Feel Safe. Move Confidently.</p>
      <ul class="sds-benefits__list">
        <li>
          <span class="sds-benefit-icon">🛡️</span>
          <span class="sds-benefit-text">Instant snap expansion — ready in 1 second</span>
        </li>
        <li>
          <span class="sds-benefit-icon">🔩</span>
          <span class="sds-benefit-text">Solid industrial steel — no plastic parts</span>
        </li>
        <li>
          <span class="sds-benefit-icon">🚗</span>
          <span class="sds-benefit-text">Built-in glass breaker for car escapes</span>
        </li>
      </ul>
    </div>

    <!-- Bundle Pack Selector -->
    <div class="sds-bundle">
      <div class="sds-bundle__title-wrapper">
        <span class="sds-bundle__title-line"></span>
        <span class="sds-bundle__title-text">BUNDLE OFFER</span>
        <span class="sds-bundle__title-line"></span>
      </div>
      
      {% assign v1 = product.variants[0] %}
      {% assign v2 = product.variants[1] %}

      <label class="sds-bundle__option sds-bundle__option--selected" id="sds-bundle-1" onclick="sdsSelectBundle(1, this, {{ v1.id | default: 'null' }}, '{{ v1.price | money_without_trailing_zeros | default: 'Rs. 799' }}', '{{ v1.compare_at_price | money_without_trailing_zeros | default: 'Rs. 1,599' }}')">
        <span class="sds-bundle__custom-radio" id="sds-radio-1"></span>
        <span class="sds-bundle__details">
          <span class="sds-bundle__pack">Pack of 1</span>
          <span class="sds-bundle__sub">Perfect for everyday use</span>
        </span>
        <span class="sds-bundle__price">
          {{ v1.price | money_without_trailing_zeros | default: 'Rs. 799' }}
          <span class="sds-bundle__compare">{{ v1.compare_at_price | money_without_trailing_zeros | default: 'Rs. 1,599' }}</span>
        </span>
      </label>

      <label class="sds-bundle__option" id="sds-bundle-2" onclick="sdsSelectBundle(2, this, {{ v2.id | default: 'null' }}, '{{ v2.price | money_without_trailing_zeros | default: 'Rs. 1,499' }}', '{{ v2.compare_at_price | money_without_trailing_zeros | default: 'Rs. 3,198' }}')">
        <span class="sds-bundle__custom-radio" id="sds-radio-2"></span>
        <span class="sds-bundle__details">
          <span class="sds-bundle__pack">Pack of 2</span>
          <span class="sds-bundle__sub">Perfect for family</span>
        </span>
        <span class="sds-bundle__price">
          {{ v2.price | money_without_trailing_zeros | default: 'Rs. 1,499' }}
          <span class="sds-bundle__compare">{{ v2.compare_at_price | money_without_trailing_zeros | default: 'Rs. 3,198' }}</span>
        </span>
      </label>
    </div>

    <!-- Shopify Form -->
    {% form 'product', product, id: 'sds-product-form' %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="sds-variant-id">
      <input type="hidden" name="quantity" value="1" id="sds-quantity">

      <div class="sds-buy-section" id="sds-buy-section">
        <!-- 1. Pill Add to Cart -->
        <button class="sds-btn-addtocart" type="submit" name="add" id="sds-addtocart-btn">
          {% render 'icon-cart' %}
          <span>Add to Cart</span>
        </button>

        <!-- 2. Extra Savings Bar -->
        <div class="sds-prepaid-bar-custom">
          EXTRA RS 100 OFF ON PREPAID ORDERS
        </div>

        {% if section.settings.show_native_buy_now %}
          <div style="margin-top: 15px;">
            <style>
              .shopify-payment-button__button--unbranded {
                background-color: #1a56db !important;
                color: #ffffff !important;
                border-radius: 50px !important;
                padding: 18px !important;
                font-size: 0 !important; /* Hide original text "Buy it now" */
                font-weight: 700 !important;
                text-transform: uppercase !important;
                transition: transform 0.2s ease !important;
                width: 100% !important;
                position: relative !important;
              }
              .shopify-payment-button__button--unbranded::before {
                content: "BUY NOW" !important;
                font-size: 1.2rem !important;
                visibility: visible !important;
              }
              .shopify-payment-button__button--unbranded:active {
                transform: scale(0.98) !important;
              }
            </style>
            {{ form | payment_button }}
          </div>
        {% endif %}
      </div>
    {% endform %}

    <!-- Delivery Estimator (below CTAs) -->
    <div class="sds-delivery">
      <span class="sds-delivery__icon">📦</span>
      <div class="sds-delivery__text">
        <span class="sds-delivery__label">Estimated Delivery</span>
        <span class="sds-delivery__date" id="sds-delivery-date">Calculating...</span>
      </div>
      <span class="sds-delivery__badge">FREE</span>
    </div>

    <!-- Trust Strip -->
    <div class="sds-trust-strip">
      <div class="sds-trust-item">
        <div class="sds-trust-icon-circle">
          <!-- Ribbon with Star (7-Day Easy Returns) -->
          <svg viewBox="0 0 24 24" class="sds-trust-svg">
            <path d="M6 14 v9 l6 -3 l6 3 v-9 z" fill="var(--sds-blue)"/>
            <circle cx="12" cy="10" r="8" fill="#ffffff" stroke="var(--sds-blue)" stroke-width="2"/>
            <path d="M12 4.5 l1.8 3.6 4 .6 -2.9 2.8 .7 4 -3.6 -1.9 -3.6 1.9 .7 -4 -2.9 -2.8 4 -.6 z" fill="var(--sds-blue)"/>
          </svg>
        </div>
        <span>7-Day Easy<br>Returns</span>
      </div>
      <div class="sds-trust-item">
        <div class="sds-trust-icon-circle">
          <!-- Truck / Free Shipping -->
          <svg viewBox="0 0 24 24" class="sds-trust-svg">
            <path d="M20 8h-3V4H3C1.9 4 1 4.9 1 6v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" fill="var(--sds-blue)"/>
          </svg>
        </div>
        <span>Free<br>Shipping</span>
      </div>
      <div class="sds-trust-item">
        <div class="sds-trust-icon-circle">
          <!-- Bank with check / Secure Checkout -->
          <svg viewBox="0 0 24 24" class="sds-trust-svg">
            <!-- Bank Roof -->
            <path d="M2 9 L12 2 L22 9 H2 Z" fill="var(--sds-blue)"/>
            <rect x="4" y="10" width="16" height="2" fill="var(--sds-blue)"/>
            <!-- Pillars -->
            <rect x="5" y="13" width="2" height="6" fill="var(--sds-blue)"/>
            <rect x="11" y="13" width="2" height="6" fill="var(--sds-blue)"/>
            <rect x="17" y="13" width="2" height="6" fill="var(--sds-blue)"/>
            <!-- Base -->
            <rect x="3" y="20" width="18" height="2" fill="var(--sds-blue)"/>
            
            <!-- Shield Background Cutout -->
            <path d="M14 14 l5 -2 l5 2 v4.5 c0 2.5 -2.5 5.5 -5 7.5 c-2.5 -2 -5 -5 -5 -7.5 z" fill="#ffffff"/>
            <!-- Shield Foreground -->
            <path d="M14 14 l5 -2 l5 2 v4.5 c0 2.5 -2.5 5.5 -5 7.5 c-2.5 -2 -5 -5 -5 -7.5 z" fill="var(--sds-blue)"/>
            <!-- Checkmark inside shield -->
            <path d="M16 18 l2 2 l3 -4" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <span>Secure<br>checkout</span>
      </div>
    </div>
  </div><!-- /sds-info -->

  <!-- ═══════════════════════════════════════════
       WAVE MARQUEE (SCROLLING ANNOUNCEMENT)
  ═══════════════════════════════════════════ -->
  <div class="sds-wave-marquee">
    <div class="sds-marquee-track">
      <div class="sds-marquee-content">
        <span>Trusted by 25,000+ Customers</span>
        <span class="sds-marquee-dot">•</span>
        <span>Recommended by Experts</span>
        <span class="sds-marquee-dot">•</span>
        <span>Trusted by 25,000+ Customers</span>
        <span class="sds-marquee-dot">•</span>
        <span>Recommended by Experts</span>
        <span class="sds-marquee-dot">•</span>
        <span>Trusted by 25,000+ Customers</span>
        <span class="sds-marquee-dot">•</span>
        <span>Recommended by Experts</span>
        <span class="sds-marquee-dot">•</span>
      </div>
      <div class="sds-marquee-content">
        <span>Trusted by 25,000+ Customers</span>
        <span class="sds-marquee-dot">•</span>
        <span>Recommended by Experts</span>
        <span class="sds-marquee-dot">•</span>
        <span>Trusted by 25,000+ Customers</span>
        <span class="sds-marquee-dot">•</span>
        <span>Recommended by Experts</span>
        <span class="sds-marquee-dot">•</span>
        <span>Trusted by 25,000+ Customers</span>
        <span class="sds-marquee-dot">•</span>
        <span>Recommended by Experts</span>
        <span class="sds-marquee-dot">•</span>
      </div>
    </div>
    <!-- Wavy Bottom SVG Overlay -->
    <div class="sds-wave-overlay">
       <svg viewBox="0 0 1440 120" fill="#ffffff" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="display:block; width:100%; height:40px; vertical-align:bottom;">
         <path d="M0,64L48,69.3C96,75,192,85,288,85.3C384,85,480,75,576,64C672,53,768,43,864,48C960,53,1056,75,1152,80C1248,85,1344,75,1392,69.3L1440,64L1440,120L1392,120C1344,120,1248,120,1152,120C1056,120,960,120,864,120C768,120,672,120,576,120C480,120,384,120,288,120C192,120,96,120,48,120L0,120Z"></path>
       </svg>
    </div>
  </div>
  <div class="sds-description sds-section-spacing">
    {%- if product.description != blank -%}
      {{ product.description }}
    {%- else -%}
      <p style="text-align:center; padding:20px; color:var(--sds-text-muted);">Please add a product description in Shopify Admin.</p>
    {%- endif -%}
  </div>

  <!-- ═══════════════════════════════════════════
       ACCORDION (Collapsible Rows)
  ═══════════════════════════════════════════ -->
  <div class="sds-accordion sds-section-spacing">
    <div class="sds-accordion__item">
      <button class="sds-accordion__btn" onclick="sdsToggleAccordion(this)">
        <span class="sds-accordion__icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
        <span class="sds-accordion__title">Quality Assurance</span>
        <span class="sds-accordion__plus">+</span>
      </button>
      <div class="sds-accordion__content">
        <p>Every order undergoes a rigorous quality and assurance check before being shipped out. We pride ourselves on delivering premium quality accessories that you will absolutely love.</p>
      </div>
    </div>
    <div class="sds-accordion__item">
      <button class="sds-accordion__btn" onclick="sdsToggleAccordion(this)">
        <span class="sds-accordion__icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/><path d="M12 6v6l4 2"/></svg></span>
        <span class="sds-accordion__title">Moneyback Guarantee</span>
        <span class="sds-accordion__plus">+</span>
      </button>
      <div class="sds-accordion__content">
        <p>Not happy with your order? Get in touch with our support team via email and we'll make it right. Every order is tracked and insured during transit for your peace of mind. You can also read our return policy for more details.</p>
      </div>
    </div>
    <div class="sds-accordion__item">
      <button class="sds-accordion__btn" onclick="sdsToggleAccordion(this)">
        <span class="sds-accordion__icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg></span>
        <span class="sds-accordion__title">Product Specifications</span>
        <span class="sds-accordion__plus">+</span>
      </button>
      <div class="sds-accordion__content">
        <ul style="padding-left: 20px; list-style-type: disc; margin: 0; line-height: 1.6;">
          <li><strong>Material:</strong> Military-grade solid steel equipment</li>
          <li><strong>Length:</strong> 2.2 feet fully expanded</li>
          <li><strong>Weight:</strong> 500g</li>
          <li><strong>Grip:</strong> Anti-slip rubber handle</li>
          <li><strong>Color:</strong> Matte Black</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       REVIEWS — MASONRY 2-COLUMN GRID
  ═══════════════════════════════════════════ -->
  <div class="sds-reviews sds-section-spacing" id="sds-reviews-section">

    <!-- Header: Review Dropdown with score visible — 4.7 left of stars -->
    <div class="sds-reviews__dropdown" style="padding: 0 16px 20px;">
      <p style="text-align: center; color: var(--sds-text); font-family: 'Poppins', sans-serif; font-size: 1rem; margin: 0 0 15px; font-weight: 700; letter-spacing: 0.3px;">Recent reviews from our happy customers</p>
      <div class="sds-reviews__summary" onclick="sdsToggleReviewDropdown()">
        <div class="sds-rating">
          <span class="sds-rating__score-inline">4.7</span>
          <span class="sds-rating__stars">
            <span class="sds-star-badge">★</span>
            <span class="sds-star-badge">★</span>
            <span class="sds-star-badge">★</span>
            <span class="sds-star-badge">★</span>
            <span class="sds-star-badge">★</span>
          </span>
          <span class="sds-rating__text" style="font-weight:600; color:var(--sds-text);">329 Reviews</span>
          <svg class="sds-chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:14px; height:14px; margin-left:2px;"><path d="M19 9l-7 7-7-7"></path></svg>
        </div>
      </div>
      
      <div class="sds-reviews__details" id="sds-review-dropdown-content">
        <div class="sds-reviews__stats">
          <div class="sds-stats-main">
            <span class="sds-stats-score">4.7</span>
            <div class="sds-stats-stars">★★★★★</div>
          </div>
          <div class="sds-stats-bars">
            <div class="sds-stats-row">
              <span class="sds-stats-label">5 ★</span>
              <div class="sds-stats-bar-bg"><div class="sds-stats-bar-fill" style="width: 88%;"></div></div>
              <span class="sds-stats-count">(291)</span>
            </div>
            <div class="sds-stats-row">
              <span class="sds-stats-label">4 ★</span>
              <div class="sds-stats-bar-bg"><div class="sds-stats-bar-fill" style="width: 6%;"></div></div>
              <span class="sds-stats-count">(19)</span>
            </div>
            <div class="sds-stats-row">
              <span class="sds-stats-label">3 ★</span>
              <div class="sds-stats-bar-bg"><div class="sds-stats-bar-fill" style="width: 3%;"></div></div>
              <span class="sds-stats-count">(11)</span>
            </div>
            <div class="sds-stats-row">
              <span class="sds-stats-label">2 ★</span>
              <div class="sds-stats-bar-bg"><div class="sds-stats-bar-fill" style="width: 1.5%;"></div></div>
              <span class="sds-stats-count">(5)</span>
            </div>
            <div class="sds-stats-row">
              <span class="sds-stats-label">1 ★</span>
              <div class="sds-stats-bar-bg"><div class="sds-stats-bar-fill" style="width: 1%;"></div></div>
              <span class="sds-stats-count">(3)</span>
            </div>
          </div>
          <button class="sds-btn-write-inline" type="button" onclick="sdsOpenWriteReview()">Write a review</button>
        </div>
      </div>
    </div>

    <!-- Masonry 2-column grid — image reviews first, then text-only -->
    <div class="sds-reviews__masonry" id="sds-reviews-track">

      <!-- IMAGE REVIEWS (top of grid) -->
      <div class="sds-mcard sds-mcard--img">
        <img src="https://cdn.shopify.com/s/files/1/0800/9229/9512/files/customerreview1.webp?v=1770330151" alt="Meera K. review" class="sds-mcard__img" loading="lazy">
        <div class="sds-mcard__name">Meera K.</div>
        <div class="sds-mcard__stars">⭐⭐⭐⭐⭐</div>
        <p class="sds-mcard__text">"Must-have for every woman! Feels solid and safe."</p>
      </div>

      <div class="sds-mcard sds-mcard--img">
        <img src="https://cdn.shopify.com/s/files/1/0800/9229/9512/files/Customer_review12123.png?v=1770332744" alt="Priya S. review" class="sds-mcard__img" loading="lazy">
        <div class="sds-mcard__name">Priya S.</div>
        <div class="sds-mcard__stars">⭐⭐⭐⭐⭐</div>
        <p class="sds-mcard__text">"Snap sound is intimidating. Compact and easy to carry!"</p>
      </div>

      <div class="sds-mcard sds-mcard--img">
        <img src="https://cdn.shopify.com/s/files/1/0800/9229/9512/files/ChatGPT_Image_Feb_6_2026_04_36_50_AM.png?v=1770332824" alt="Sneha R. review" class="sds-mcard__img" loading="lazy">
        <div class="sds-mcard__name">Sneha R.</div>
        <div class="sds-mcard__stars">⭐⭐⭐⭐⭐</div>
        <p class="sds-mcard__text">"Best self-defense tool! Every girl should have this."</p>
      </div>

      <!-- TEXT-ONLY REVIEWS (below image reviews, same grid) -->
      <div class="sds-mcard">
        <div class="sds-mcard__name">Rahul M.</div>
        <div class="sds-mcard__stars">⭐⭐⭐⭐⭐</div>
        <p class="sds-mcard__text">"The metal is incredibly strong! I use it for hiking now. Perfect on rough terrain. Best purchase ever!"</p>
        <span class="sds-mcard__verified">✓ Verified</span>
      </div>

      <div class="sds-mcard">
        <div class="sds-mcard__name">Amit S.</div>
        <div class="sds-mcard__stars">⭐⭐⭐⭐⭐</div>
        <p class="sds-mcard__text">"Got it for my wife and daughter. Very sturdy build. The glass breaker tip is a great feature!"</p>
        <span class="sds-mcard__verified">✓ Verified</span>
      </div>

      <div class="sds-mcard">
        <div class="sds-mcard__name">Vikram P.</div>
        <div class="sds-mcard__stars">⭐⭐⭐⭐⭐</div>
