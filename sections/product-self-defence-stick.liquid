    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 12px;
    color: var(--sds-blue);
  }
  .sds-accordion__title {
    flex: 1;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .sds-accordion__plus {
    font-size: 1.6rem;
    font-weight: 300;
    color: var(--sds-text-muted);
    transition: transform 0.2s;
    line-height: 1;
  }
  .sds-accordion__item.active .sds-accordion__plus {
    transform: rotate(45deg);
  }
  .sds-accordion__content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.55s cubic-bezier(0.4, 0, 0.2, 1), padding 0.35s ease;
    font-size: 0.85rem;
    color: var(--sds-text-muted);
    line-height: 1.6;
    padding-bottom: 0;
  }
  .sds-accordion__item.active .sds-accordion__content {
    max-height: 500px;
    padding-bottom: 16px;
  }

  /* ── REVIEWS \u2014 MASONRY GRID ── */
  .sds-reviews {
    background: var(--sds-bg-subtle);
    padding: 20px 0 24px;
    border-top: 8px solid var(--sds-border);
  }
  .sds-reviews__header {
    padding: 0 16px 12px;
  }
  .sds-reviews__summary-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sds-reviews__stars-lg { font-size: 1rem; }
  .sds-reviews__count-lg {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--sds-text);
  }

  /* 2-column masonry grid */
  .sds-reviews__masonry {
    columns: 2;
    column-gap: 10px;
    padding: 0 14px 12px;
  }

  /* Base masonry card */
  .sds-mcard {
    break-inside: avoid;
    background: #fff;
    border-radius: 12px;
    padding: 12px;
    margin-bottom: 10px;
    border: 1px solid var(--sds-border);
    box-shadow: 0 1px 6px rgba(0,0,0,0.06);
    display: block;
  }

  /* Image review card — image is full width, comes first */
  .sds-mcard--img {
    padding: 0;
    overflow: hidden;
  }
  .sds-mcard__img {
    width: 100%;
    display: block;
    border-radius: 12px 12px 0 0;
    object-fit: cover;
  }
  .sds-mcard--img .sds-mcard__name,
  .sds-mcard--img .sds-mcard__stars,
  .sds-mcard--img .sds-mcard__text {
    padding: 0 10px;
  }
  .sds-mcard--img .sds-mcard__name { padding-top: 10px; }
  .sds-mcard--img .sds-mcard__text { padding-bottom: 10px; }

  /* Card elements */
  .sds-mcard__name {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--sds-text);
    margin-bottom: 2px;
  }
  .sds-mcard__stars {
    font-size: 0.78rem;
    margin-bottom: 5px;
  }
  .sds-mcard__text {
    font-size: 0.78rem;
    color: var(--sds-text-muted);
    line-height: 1.5;
    margin: 0 0 6px;
  }
  .sds-mcard__verified {
    font-size: 0.68rem;
    color: #16a34a;
    font-weight: 600;
  }

  /* Write a Review */
  .sds-write-review-wrap {
    padding: 8px 16px 4px;
    text-align: center;
  }
  .sds-write-review-btn {
    background: transparent;
    border: 2px solid var(--sds-blue);
    color: var(--sds-blue);
    font-family: 'Poppins', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    padding: 9px 22px;
    border-radius: 50px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .sds-write-review-btn:hover {
    background: var(--sds-blue);
    color: #fff;
  }

  /* Review Form */
  .sds-review-form {
    margin: 14px 16px 0;
    background: #fff;
    border-radius: 14px;
    padding: 18px;
    border: 1.5px solid var(--sds-blue-light);
    box-shadow: 0 2px 12px rgba(26,86,219,0.08);
  }
  .sds-review-form__title {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 12px;
    color: var(--sds-blue-dark);
  }
  .sds-review-form__stars {
    display: flex;
    gap: 6px;
    margin-bottom: 14px;
  }
  .sds-star-pick {
    font-size: 2rem;
    color: #d1d5db;
    cursor: pointer;
    transition: color 0.15s;
  }
  .sds-star-pick.selected, .sds-star-pick:hover ~ .sds-star-pick,
  .sds-star-pick.selected ~ .sds-star-pick { color: #d1d5db; }
  .sds-star-pick.selected, .sds-review-form__stars:hover .sds-star-pick { color: #f59e0b; }
  .sds-review-form__input,
  .sds-review-form__textarea {
    width: 100%;
    border: 1.5px solid var(--sds-border);
    border-radius: 8px;
    padding: 10px 12px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.88rem;
    color: var(--sds-text);
    background: #fafafa;
    box-sizing: border-box;
    margin-bottom: 10px;
    resize: none;
    outline: none;
    transition: border-color 0.2s;
  }
  .sds-review-form__input:focus,
  .sds-review-form__textarea:focus { border-color: var(--sds-blue); background: #fff; }
  .sds-review-form__submit {
    width: 100%;
    background: var(--sds-blue);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 12px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
  }
  .sds-review-form__submit:hover { background: var(--sds-blue-dark); }
  .sds-review-form__note {
    font-size: 0.72rem;
    color: var(--sds-text-muted);
    text-align: center;
    margin: 8px 0 0;
  }

  /* Final CTA */
  .sds-final-cta {
    text-align: center;
    padding: 16px 16px 10px;
    background: #fff;
  }
  .sds-final-cta__btn {
    background: linear-gradient(135deg, #1a56db 0%, #2563eb 100%);
    color: #fff;
    border: none;
    padding: 16px 14px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    border-radius: 50px;
    cursor: pointer;
    width: 100%;
    max-width: 400px;
    box-shadow: 0 4px 18px rgba(26,86,219,0.35);
    animation: sdsShake 3s ease-in-out infinite;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  @keyframes sdsShake {
    0%, 85%, 100% { transform: rotate(0deg); }
    88% { transform: rotate(-3deg); }
    91% { transform: rotate(3deg); }
    94% { transform: rotate(-2deg); }
    97% { transform: rotate(2deg); }
  }

  /* ── FINAL CTA ── */
  .sds-final-cta {
    padding: 20px 16px 40px;
    background: var(--sds-bg-subtle);
    text-align: center;
  }
  .sds-final-cta__btn {
    width: 100%;
    max-width: 400px;
    background: var(--sds-blue);
    color: #fff;
    border: none;
    border-radius: 50px;
    padding: 18px 30px;
    font-size: 1.1rem;
    font-weight: 700;
    font-family: 'Inter', sans-serif;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(26,86,219,0.3);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    animation: sdsPulse 2.5s infinite;
  }
  .sds-final-cta__btn:active { transform: scale(0.98); }
</style>

<!-- ═══════════════════════════════════════════
     SCRIPTS
═══════════════════════════════════════════ -->
<script>
(function() {
  // ── PREMIUM GALLERY LOGIC ──
  const sdsTrack = document.getElementById('sds-track');
  const sdsThumbs = document.querySelectorAll('.sds-thumb-item');
  const sdsThumbScroll = document.getElementById('sds-thumbnails');
  const sdsThumbPrev = document.getElementById('sds-thumb-prev');
  const sdsThumbNext = document.getElementById('sds-thumb-next');

  let sdsCurrentIndex = 0;
  const sdsSlideCount = {{ product.images.size }};

  function sdsUpdateGallery(index) {
    if (index < 0) index = sdsSlideCount - 1;
    if (index >= sdsSlideCount) index = 0;
    
    sdsCurrentIndex = index;
    const slideWidth = sdsTrack.clientWidth || sdsTrack.parentElement.offsetWidth;
    sdsTrack.scrollTo({ left: slideWidth * sdsCurrentIndex, behavior: 'smooth' });

    // Update Thumbnails
    sdsThumbs.forEach((t, i) => {
      if (i === sdsCurrentIndex) {
        t.classList.add('is-active');
        t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      } else {
        t.classList.remove('is-active');
      }
    });
  }

  window.sdsJumpToSlide = function(index) {
    sdsUpdateGallery(index);
  };

  // Thumbnail Arrows
  if (sdsThumbPrev) sdsThumbPrev.onclick = () => sdsThumbScroll.scrollBy({ left: -200, behavior: 'smooth' });
  if (sdsThumbNext) sdsThumbNext.onclick = () => sdsThumbScroll.scrollBy({ left: 200, behavior: 'smooth' });

  // Sync scroll of track back to current index (for manual swipes)
  let sdsScrollTimeout;
  if (sdsTrack) {
    sdsTrack.addEventListener('scroll', () => {
      clearTimeout(sdsScrollTimeout);
      sdsScrollTimeout = setTimeout(() => {
        const slideWidth = sdsTrack.clientWidth || 1;
        const index = Math.round(sdsTrack.scrollLeft / slideWidth);
        if (index !== sdsCurrentIndex && index >= 0 && index < sdsSlideCount) {
          sdsUpdateGallery(index);
        }
      }, 150);
    });
  }

  // ── DELIVERY DATE ESTIMATOR ──
  function calcDelivery() {
    const today = new Date();
    const minDays = 2, maxDays = 4;
    const from = new Date(today); from.setDate(today.getDate() + minDays);
    const to = new Date(today); to.setDate(today.getDate() + maxDays);
    const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    const days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    const fmt = (d) => days[d.getDay()] + ', ' + d.getDate() + ' ' + months[d.getMonth()];
    const el = document.getElementById('sds-delivery-date');
    if (el) el.textContent = fmt(from) + ' – ' + fmt(to);
  }
  calcDelivery();

  // ── BUNDLE SELECTOR ──
  window.sdsSelectBundle = function(pack, el, variantId, displayPrice, comparePrice) {
    // 1. UI Update for selector
    document.querySelectorAll('.sds-bundle__option').forEach(o => {
      o.classList.remove('sds-bundle__option--selected');
    });
    el.classList.add('sds-bundle__option--selected');

    // 2. Update hidden inputs
    const variantIdInput = document.getElementById('sds-variant-id');
    const quantityInput = document.getElementById('sds-quantity');
    
    // Logic: If variantId is unique to this pack, use it with qty 1.
    // If variantId is null/missing (meaning only 1 variant exists), use the base variant with qty = pack.
    if (variantId) {
      variantIdInput.value = variantId;
      quantityInput.value = 1;
    } else {
      variantIdInput.value = "{{ product.variants[0].id }}";
      quantityInput.value = pack;
    }

    // Trigger 'change' event so native Shopify button knows the variant changed
    variantIdInput.dispatchEvent(new Event('change', { bubbles: true }));

    // 3. Update main price display at top
    const mainPriceEl = document.querySelector('.sds-price__current');
    const mainCompareEl = document.querySelector('.sds-price__compare');
    if (mainPriceEl) mainPriceEl.textContent = displayPrice;
    if (mainCompareEl) mainCompareEl.textContent = comparePrice;

    // 4. Update Save % badge if needed
    const saveBadge = document.querySelector('.sds-price__badge');
    if (saveBadge && displayPrice && comparePrice) {
        const p = parseInt(displayPrice.replace(/[^0-9]/g, ''));
        const cp = parseInt(comparePrice.replace(/[^0-9]/g, ''));
        if (cp > p) {
            const pct = Math.round(((cp - p) / cp) * 100);
            saveBadge.innerHTML = `<svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="14" height="14" style="flex-shrink:0"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg> SAVE ${pct}%`;
        }
    }
  };

  // ── REVIEWS DROPDOWN (Glimmi-Style) ──
  window.sdsToggleReviewDropdown = function() {
    const dropdown = document.querySelector('.sds-reviews__dropdown');
    if (dropdown) dropdown.classList.toggle('is-open');
  };

  window.sdsScrollToReviews = function() {
    const reviewSection = document.getElementById('sds-reviews-section');
    if (reviewSection) {
      reviewSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      // Open the review form if it's not visible
      const reviewForm = document.getElementById('sds-review-form');
      const writeBtn = document.getElementById('sds-write-review-btn');
      if (reviewForm && reviewForm.style.display === 'none') {
        reviewForm.style.display = 'block';
        if (writeBtn) writeBtn.style.display = 'none';
      }
    }
  };

  // ── SCROLL TO BUY SECTION ──
  window.sdsScrollToBuy = function() {
    const buySection = document.getElementById('sds-buy-section');
    if (buySection) buySection.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };


  // ── ACCORDION TOGGLE ──
  window.sdsToggleAccordion = function(btn) {
    const item = btn.closest('.sds-accordion__item');
    item.classList.toggle('active');
  };

  // ── WRITE A REVIEW: open form + scroll to it ──
  window.sdsOpenWriteReview = function() {
    const reviewForm = document.getElementById('sds-review-form');
    const writeBtn = document.getElementById('sds-write-review-btn');
    if (reviewForm) {
      reviewForm.style.display = 'block';
      if (writeBtn) writeBtn.style.display = 'none';
      // Give the browser one frame to render before scrolling
      requestAnimationFrame(() => {
        reviewForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
  };

  // ── STAR PICKER ──
  const stars = document.querySelectorAll('.sds-star-pick');
  let selectedRating = 0;
  stars.forEach(star => {
    star.addEventListener('mouseover', function() {
      const val = parseInt(this.dataset.val);
      stars.forEach((s, i) => s.style.color = i < val ? '#f59e0b' : '#d1d5db');
    });
    star.addEventListener('click', function() {
      selectedRating = parseInt(this.dataset.val);
      stars.forEach((s, i) => {
        s.style.color = i < selectedRating ? '#f59e0b' : '#d1d5db';
        s.classList.toggle('selected', i < selectedRating);
      });
    });
  });
  document.getElementById('sds-star-picker')?.addEventListener('mouseleave', function() {
    stars.forEach((s, i) => s.style.color = i < selectedRating ? '#f59e0b' : '#d1d5db');
  });

  // ── SUBMIT REVIEW ──
  window.sdsSubmitReview = function() {
    const name = document.getElementById('sds-review-name')?.value.trim();
    const text = document.getElementById('sds-review-text')?.value.trim();
    if (!name || !text || selectedRating === 0) {
      alert('Please fill in your name, rating, and review before submitting.');
      return;
    }
    // Add the new review card to the masonry grid
    const track = document.getElementById('sds-reviews-track');
    if (track) {
      const card = document.createElement('div');
      card.className = 'sds-mcard';
      const starsHtml = '⭐'.repeat(selectedRating);
      card.innerHTML = `
        <div class="sds-mcard__name">${name.substring(0,20)}</div>
        <div class="sds-mcard__stars">${starsHtml}</div>
        <p class="sds-mcard__text">"${text.substring(0,300)}"</p>
        <span class="sds-mcard__verified">✓ Verified</span>
      `;
      track.appendChild(card);
      card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
    // Reset form
    if (reviewForm) reviewForm.style.display = 'none';
    if (writeBtn) writeBtn.textContent = '✍️ Write a Review';
    document.getElementById('sds-review-name').value = '';
    document.getElementById('sds-review-text').value = '';
    selectedRating = 0;
    alert('✅ Thank you for your review!');
  };
})();
</script>

