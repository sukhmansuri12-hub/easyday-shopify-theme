{% schema %}
{
  "name": "Featured Products Mock",
  "settings": [],
  "presets": [{ "name": "Featured Products Mock" }]
}
{% endschema %}

<section class="featured-products-mock section-padding scroll-reveal" style="position: relative; overflow: hidden;">
  <div class="container">
    
    <div class="section-header text-center scroll-reveal" style="position: relative; z-index: 1;">
      <h2>Featured Products</h2>
    </div>

    <div class="mock-product-grid scroll-reveal" id="featured-products">
        
        {%- assign featured_collection = collections.all -%}
        {%- if featured_collection.products.size > 0 -%}
          {%- comment %} First, show Self Defence Stick if it exists {%endcomment -%}
          {%- assign defence_stick_product = all_products['self-defence-tactical-rod-heavy-metal-and-extendable'] -%}
          
          {%- if defence_stick_product and defence_stick_product.available -%}
            <div class="product-card animate-on-scroll delay-0" data-animation="scale-in" data-product-handle="{{ defence_stick_product.handle }}">
              <div class="product-image-wrapper homepage-carousel">
                <a href="{{ defence_stick_product.url }}" class="product-link">
                  {%- if defence_stick_product.images.size > 1 -%}
                    {%- for image in defence_stick_product.images limit: 4 -%}
                      <div class="mock-image carousel-image {% if forloop.first %}active{% endif %}" style="background-image: url('{{ image | img_url: '600x' }}');" data-index="{{ forloop.index0 }}"></div>
                    {%- endfor -%}
                  {%- elsif defence_stick_product.featured_image -%}
                    <div class="mock-image carousel-image active" style="background-image: url('{{ defence_stick_product.featured_image | img_url: '600x' }}');"></div>
                  {%- else -%}
                    <div class="mock-image carousel-image active" style="background: #f4f4f4;"></div>
                  {%- endif -%}
                </a>
                <button class="add-btn" onclick="quickAddToCart('{{ defence_stick_product.handle }}')">+</button>
              </div>
              <div class="product-content">
                <h3 class="product-title"><a href="{{ defence_stick_product.url }}">{{ defence_stick_product.title }}</a></h3>
                <div class="product-price">
                  <span class="sale-price">Rs. {{ defence_stick_product.price | money_without_currency }}</span>
                  {%- if defence_stick_product.compare_at_price > defence_stick_product.price -%}
                    {%- assign discount = defence_stick_product.compare_at_price | minus: defence_stick_product.price | times: 100 | divided_by: defence_stick_product.compare_at_price -%}
                    <span class="compare-price">Rs. {{ defence_stick_product.compare_at_price | money_without_currency }}</span>
                    <div class="save-text">Save {{ discount }}%</div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
          
          {%- comment %} Second, show Splash Guard if it exists {%endcomment -%}
          {%- assign splash_guard_product = all_products['silicone-splash-guard-buy-1-get-1-free'] -%}
          
          {%- if splash_guard_product and splash_guard_product.available -%}
            <div class="product-card animate-on-scroll delay-1" data-animation="scale-in" data-product-handle="{{ splash_guard_product.handle }}">
              <div class="product-image-wrapper homepage-carousel">
                <span class="mock-sale-badge" style="background: #1a56db;">🎁 BUY 1 GET 1 FREE</span>
                <a href="{{ splash_guard_product.url }}" class="product-link">
                  {%- if splash_guard_product.images.size > 1 -%}
                    {%- for image in splash_guard_product.images limit: 4 -%}
                      <div class="mock-image carousel-image {% if forloop.first %}active{% endif %}" style="background-image: url('{{ image | img_url: '600x' }}');" data-index="{{ forloop.index0 }}"></div>
                    {%- endfor -%}
                  {%- elsif splash_guard_product.featured_image -%}
                    <div class="mock-image carousel-image active" style="background-image: url('{{ splash_guard_product.featured_image | img_url: '600x' }}');"></div>
                  {%- else -%}
                    <div class="mock-image carousel-image active" style="background: #f4f4f4;"></div>
                  {%- endif -%}
                </a>
                <button class="add-btn" onclick="quickAddToCart('{{ splash_guard_product.handle }}')">+</button>
              </div>
              <div class="product-content">
                <h3 class="product-title"><a href="{{ splash_guard_product.url }}">{{ splash_guard_product.title }}</a></h3>
                <div class="product-price">
                  <span class="sale-price">Rs. {{ splash_guard_product.price | money_without_currency }}</span>
                  {%- if splash_guard_product.compare_at_price > splash_guard_product.price -%}
                    {%- assign discount = splash_guard_product.compare_at_price | minus: splash_guard_product.price | times: 100 | divided_by: splash_guard_product.compare_at_price -%}
                    <span class="compare-price">Rs. {{ splash_guard_product.compare_at_price | money_without_currency }}</span>
                    <div class="save-text">Save {{ discount }}%</div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
          
          {%- comment %} Third, show Pet Hair Removal Gloves if it exists {%endcomment -%}
          {%- assign pet_hair_product = null -%}
          {%- for product in featured_collection.products -%}
            {%- if product.handle == 'pet-hair-removal-gloves-pack-of-2' -%}
              {%- assign pet_hair_product = product -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          
          {%- if pet_hair_product -%}
            <div class="product-card animate-on-scroll delay-0" data-animation="scale-in" data-product-handle="{{ pet_hair_product.handle }}">
              <div class="product-image-wrapper homepage-carousel">
                {%- if pet_hair_product.compare_at_price > pet_hair_product.price -%}
                  {%- assign discount = pet_hair_product.compare_at_price | minus: pet_hair_product.price | times: 100 | divided_by: pet_hair_product.compare_at_price -%}
                  <span class="mock-sale-badge">SALE {{ discount }}%</span>
                {%- endif -%}
                <a href="{{ pet_hair_product.url }}" class="product-link">
                  {%- if pet_hair_product.images.size > 1 -%}
                    {%- for image in pet_hair_product.images limit: 4 -%}
                      <div class="mock-image carousel-image {% if forloop.first %}active{% endif %}" style="background-image: url('{{ image | img_url: '600x' }}');" data-index="{{ forloop.index0 }}"></div>
                    {%- endfor -%}
                  {%- elsif pet_hair_product.featured_image -%}
                    <div class="mock-image carousel-image active" style="background-image: url('{{ pet_hair_product.featured_image | img_url: '600x' }}');"></div>
                  {%- else -%}
                    <div class="mock-image carousel-image active" style="background: #f4f4f4;"></div>
                  {%- endif -%}
                </a>
                <button class="add-btn" onclick="quickAddToCart('{{ pet_hair_product.handle }}')">+</button>
              </div>
              <div class="product-content">
                <h3 class="product-title"><a href="{{ pet_hair_product.url }}">{{ pet_hair_product.title }}</a></h3>
                <div class="product-price">
                  <span class="sale-price">Rs. {{ pet_hair_product.price | money_without_currency }}</span>
                  {%- if pet_hair_product.compare_at_price > pet_hair_product.price -%}
                    <span class="compare-price">Rs. {{ pet_hair_product.compare_at_price | money_without_currency }}</span>
                    <div class="save-text">Save {{ discount }}%</div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
          
          {%- comment %} Then show other products (excluding the three above and kitchen sink) {%endcomment -%}
          {%- assign shown_count = 0 -%}
          {%- if defence_stick_product -%}{%- assign shown_count = 1 -%}{%- endif -%}
          {%- if splash_guard_product -%}{%- assign shown_count = shown_count | plus: 1 -%}{%- endif -%}
          {%- if pet_hair_product -%}{%- assign shown_count = shown_count | plus: 1 -%}{%- endif -%}
          {%- for product in featured_collection.products limit: 20 -%}
            {%- if product.handle != 'pet-hair-removal-gloves-pack-of-2' and product.handle != 'silicone-splash-guard-buy-1-get-1-free' and product.handle != 'self-defence-tactical-rod-heavy-metal-and-extendable' and product.handle != '3-modes-kitchen-sink-faucet' and shown_count < 4 -%}
              <div class="product-card animate-on-scroll delay-{{ shown_count | modulo: 2 }}" data-animation="scale-in" data-product-handle="{{ product.handle }}">
                <div class="product-image-wrapper homepage-carousel">
                  {%- if product.compare_at_price > product.price -%}
                    {%- assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
                    <span class="mock-sale-badge">SALE {{ discount }}%</span>
                  {%- endif -%}
                  <a href="{{ product.url }}" class="product-link">
                    {%- if product.images.size > 1 -%}
                      {%- for image in product.images limit: 4 -%}
                        <div class="mock-image carousel-image {% if forloop.first %}active{% endif %}" style="background-image: url('{{ image | img_url: '600x' }}');" data-index="{{ forloop.index0 }}"></div>
                      {%- endfor -%}
                    {%- elsif product.featured_image -%}
                      <div class="mock-image carousel-image active" style="background-image: url('{{ product.featured_image | img_url: '600x' }}');"></div>
                    {%- else -%}
                      <div class="mock-image carousel-image active" style="background: #f4f4f4;"></div>
                    {%- endif -%}
                  </a>
                  <button class="add-btn" onclick="quickAddToCart('{{ product.handle }}')">+</button>
                </div>
                <div class="product-content">
                  <h3 class="product-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                  <div class="product-price">
                    <span class="sale-price">Rs. {{ product.price | money_without_currency }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <span class="compare-price">Rs. {{ product.compare_at_price | money_without_currency }}</span>
                      <div class="save-text">Save {{ discount }}%</div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
              {%- assign shown_count = shown_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <p style="text-align: center; grid-column: 1/-1;">No products available yet.</p>
        {%- endif -%}

    </div>
  </div>
</section>

<style>
  .section-header h2 {
    font-size: 2rem;
    font-weight: 800;
    font-family: 'Poppins', sans-serif;
    color: #111827;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin-bottom: 25px;
  }

  .mock-product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px; /* Keep tight gap */
  }

  /* Image Area */
  .product-image-wrapper {
    position: relative;
    border-radius: 12px;
    overflow: visible !important;
    margin-bottom: 10px;
    background: #f4f4f4;
    aspect-ratio: 1 / 1; /* Square images */
  }
  
  .mock-image {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
  }
  
  /* Carousel images for homepage */
  .homepage-carousel .carousel-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }
  
  .homepage-carousel .carousel-image.active {
    opacity: 1;
    position: relative;
  }

  .mock-sale-badge {
    position: absolute;
    top: 10px;
    left: 0;
    background: #d32f2f;
    color: white;
    padding: 4px 8px;
    font-size: 0.7rem;
    font-weight: 700;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    z-index: 2;
  }
  
  .add-btn {
      position: absolute !important;
      top: -12px !important;
      right: -12px !important;
      background: #1a56db !important;
      color: white !important;
      border: none !important;
      width: 24px !important;
      height: 24px !important;
      border-radius: 50% !important;
      font-size: 1rem !important;
      line-height: 1 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      cursor: pointer !important;
      z-index: 9999 !important;
      box-shadow: 0 4px 12px rgba(26, 86, 219, 0.4) !important;
      pointer-events: auto !important;
      transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
  }
  
  .add-btn:hover {
      transform: scale(1.15) !important;
  }

  /* Content */
  .product-content {
    text-align: left;
    padding: 0 5px;
  }

  .product-title {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 5px;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.6em; /* Align cards */
    font-family: 'Poppins', sans-serif;
  }

  .product-title a { color: #333; text-decoration: none; }

  .product-price {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .sale-price {
    font-size: 1rem;
    font-weight: 800;
    color: #1a56db;
    font-family: 'Poppins', sans-serif;
  }

  .compare-price {
    font-size: 0.8rem;
    color: #888;
    text-decoration: line-through;
  }
  
  .save-text {
      color: #d32f2f;
      font-size: 0.95rem;
      font-weight: 700;
  }
  
  @media(min-width: 768px) {
      .mock-product-grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>

<script>
// Homepage carousel auto-rotation
document.addEventListener('DOMContentLoaded', function() {
  const homepageCards = document.querySelectorAll('.homepage-carousel');
  
  homepageCards.forEach(container => {
    const images = container.querySelectorAll('.carousel-image');
    
    if (images.length <= 1) return;
    
    let currentIndex = 0;
    
    function showImage(index) {
      images.forEach((img, i) => {
        if (i === index) {
          img.classList.add('active');
          img.style.opacity = '1';
          img.style.position = 'relative';
        } else {
          img.classList.remove('active');
          img.style.opacity = '0';
          img.style.position = 'absolute';
        }
      });
    }
    
    function nextImage() {
      currentIndex = (currentIndex + 1) % images.length;
      showImage(currentIndex);
    }
    
    setInterval(nextImage, 2000);
  });
});

function quickAddToCart(productHandle) {
  event.stopPropagation();
  event.preventDefault();
  
  const btn = event.target;
  const originalText = btn.textContent;
  btn.textContent = '⏳';
  btn.disabled = true;
  
  // Get product and add to cart
  fetch(`/products/${productHandle}.js`)
    .then(response => {
      if (!response.ok) throw new Error('Product not found');
      return response.json();
    })
    .then(product => {
      const variant = product.variants.find(v => v.available) || product.variants[0];
      if (!variant) throw new Error('No variants');
      
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: variant.id, quantity: 1 }] })
      });
    })
    .then(response => response.json())
    .then(data => {
      btn.textContent = '✓';
      btn.style.background = '#00C853';
      
      // Update cart and open drawer
      fetch('/cart.js')
        .then(r => r.json())
        .then(cart => {
          const cartCount = document.querySelector('.cart-count');
          if (cartCount) {
            cartCount.textContent = cart.item_count;
            cartCount.style.display = cart.item_count > 0 ? 'flex' : 'none';
          }
          
          // Auto-open cart drawer
          setTimeout(() => {
            const cartDrawer = document.getElementById('cart-drawer');
            const cartBackdrop = document.getElementById('cart-backdrop');
            if (cartDrawer && cartBackdrop) {
              cartDrawer.classList.add('open');
              cartBackdrop.classList.add('open');
              if (window.loadCartItems) window.loadCartItems();
            }
          }, 300);
        });
      
      setTimeout(() => {
        btn.textContent = originalText;
        btn.style.background = '#1a56db';
        btn.disabled = false;
      }, 1500);
    })
    .catch(error => {
      console.error('Error:', error);
      // Product doesn't exist - show error
      btn.textContent = '×';
      btn.style.background = '#d32f2f';
      alert('This product is not available yet. Please contact us to order!');
      
      setTimeout(() => {
        btn.textContent = originalText;
        btn.style.background = '#1a56db';
        btn.disabled = false;
      }, 2000);
    });
}
</script>
