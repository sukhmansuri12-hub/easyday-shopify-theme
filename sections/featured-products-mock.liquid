{% schema %}
{
  "name": "Featured Products Mock",
  "settings": [],
  "presets": [{ "name": "Featured Products Mock" }]
}
{% endschema %}

<section class="featured-products-mock section-padding" style="position: relative; overflow: hidden;">
  <div class="container">
    <!-- Decorative Background Lines - Complementary Topographic Pattern -->
    <svg class="decorative-lines" xmlns="http://www.w3.org/2000/svg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; opacity: 0.07; pointer-events: none;">
      <!-- Top Layer - Blue Contours (Different from Categories) -->
      <path d="M 0 70 Q 210 50, 440 75 T 870 68 T 1280 72" stroke="#2196F3" stroke-width="1.4" fill="none"/>
      <path d="M -80 140 Q 160 115, 470 145 T 960 135 T 1320 140" stroke="#2196F3" stroke-width="1.2" fill="none"/>
      <path d="M 40 210 Q 290 185, 590 215 T 1090 205 T 1420 210" stroke="#2196F3" stroke-width="1.1" fill="none"/>
      
      <!-- Mid Layer - Orange Contours -->
      <path d="M -60 30 Q 190 10, 450 35 T 890 28 T 1300 32" stroke="#FF6F00" stroke-width="1.3" fill="none"/>
      <path d="M 70 100 Q 270 75, 560 105 T 1010 95 T 1360 100" stroke="#FF6F00" stroke-width="1.5" fill="none"/>
      <path d="M -10 170 Q 230 145, 510 175 T 990 165 T 1380 170" stroke="#FF6F00" stroke-width="1.2" fill="none"/>
      <path d="M 90 240 Q 360 210, 660 245 T 1160 235 T 1440 240" stroke="#FF6F00" stroke-width="1.1" fill="none"/>
      
      <!-- Deep Layer - Green Contours -->
      <path d="M -90 15 Q 175 0, 455 20 T 910 12 T 1330 16" stroke="#00C853" stroke-width="1" fill="none"/>
      <path d="M 20 55 Q 250 35, 530 60 T 990 52 T 1390 56" stroke="#00C853" stroke-width="1.3" fill="none"/>
      <path d="M -30 125 Q 210 100, 490 130 T 960 120 T 1340 125" stroke="#00C853" stroke-width="1.4" fill="none"/>
      <path d="M 50 195 Q 320 170, 620 200 T 1070 190 T 1400 195" stroke="#00C853" stroke-width="1.2" fill="none"/>
      <path d="M 110 265 Q 390 235, 690 270 T 1190 260 T 1480 265" stroke="#00C853" stroke-width="1" fill="none"/>
      
      <!-- Accent Layers - Mixed Colors for Depth -->
      <path d="M 30 5 Q 200 -10, 470 10 T 930 3 T 1350 7" stroke="#2196F3" stroke-width="0.9" fill="none"/>
      <path d="M -70 85 Q 170 65, 450 90 T 900 82 T 1290 86" stroke="#FF6F00" stroke-width="1.1" fill="none"/>
      <path d="M 80 155 Q 330 130, 630 160 T 1060 150 T 1410 155" stroke="#00C853" stroke-width="1" fill="none"/>
      <path d="M -50 225 Q 240 195, 540 230 T 1030 220 T 1450 225" stroke="#2196F3" stroke-width="1.3" fill="none"/>
      <path d="M 60 285 Q 350 255, 670 290 T 1150 280 T 1490 285" stroke="#FF6F00" stroke-width="1.1" fill="none"/>
      <path d="M 100 320 Q 400 290, 720 325 T 1210 315 T 1530 320" stroke="#00C853" stroke-width="1.2" fill="none"/>
    </svg>
    
    <div class="section-header text-center" style="position: relative; z-index: 1;">
      <h2>Featured Products</h2>
    </div>

    <div class="mock-product-grid" id="featured-products">
        
        {% comment %} Product 1: Necklace {% endcomment %}
        <div class="product-card animate-on-scroll delay-1" data-animation="scale-in">
           <div class="product-image-wrapper">
             <span class="mock-sale-badge">SALE 59%</span>
             <a href="/products/necklace-set" class="product-link">
                <div class="mock-image" style="background-image: url('https://img.freepik.com/free-photo/luxury-necklace-display_23-2150036224.jpg?w=740');"></div>
             </a>
             <button class="add-btn" onclick="quickAddToCart('necklace-set')">+</button>
           </div>
           <div class="product-content">
             <h3 class="product-title"><a href="/products/necklace-set">Austrian Diamond Necklace Set | 🔥SET of 3 Necklace🔥</a></h3>
             <div class="product-price">
               <span class="sale-price">Rs. 899.00</span>
               <span class="compare-price">Rs. 2,199.00</span>
               <div class="save-text">Save 59%</div>
             </div>
           </div>
        </div>

        {% comment %} Product 2: Shoulder Brace {% endcomment %}
        <div class="product-card animate-on-scroll delay-2" data-animation="scale-in">
           <div class="product-image-wrapper">
             <span class="mock-sale-badge">SALE 50%</span>
             <a href="/products/shoulder-brace" class="product-link">
                <div class="mock-image" style="background-image: url('https://img.freepik.com/free-photo/man-wearing-shoulder-brace_23-2149176313.jpg?w=740');"></div>
             </a>
             <button class="add-btn" onclick="quickAddToCart('shoulder-brace')">+</button>
           </div>
           <div class="product-content">
             <h3 class="product-title"><a href="/products/shoulder-brace">Shoulder Brace For Pain Relief | 🔥FLAT 50% OFF SALE🔥</a></h3>
             <div class="product-price">
               <span class="sale-price">Rs. 799.00</span>
               <span class="compare-price">Rs. 1,599.00</span>
               <div class="save-text">Save 50%</div>
             </div>
           </div>
        </div>

        {% comment %} Product 3: Knee Sleeves {% endcomment %}
        <div class="product-card animate-on-scroll delay-1" data-animation="scale-in">
           <div class="product-image-wrapper">
             <span class="mock-sale-badge">SALE 46%</span>
             <a href="/products/knee-sleeves" class="product-link">
                <div class="mock-image" style="background-image: url('https://img.freepik.com/free-photo/knee-brace-support_23-2149234876.jpg?w=740');"></div>
             </a>
             <button class="add-btn" onclick="quickAddToCart('knee-sleeves')">+</button>
           </div>
           <div class="product-content">
             <h3 class="product-title"><a href="/products/knee-sleeves">Bamboo Compression Knee Sleeves- 🔥Buy 1 Get 1 Free🔥</a></h3>
             <div class="product-price">
               <span class="sale-price">Rs. 699.00</span>
               <span class="compare-price">Rs. 1,299.00</span>
               <div class="save-text">Save 46%</div>
             </div>
           </div>
        </div>

        {% comment %} Product 4: Knife {% endcomment %}
        <div class="product-card animate-on-scroll delay-2" data-animation="scale-in">
           <div class="product-image-wrapper">
             <span class="mock-sale-badge">SALE 56%</span>
             <a href="/products/cut-shred-knife" class="product-link">
                 <div class="mock-image" style="background-image: url('https://img.freepik.com/free-photo/chopping-vegetables-kitchen_23-2148535048.jpg?w=740');"></div>
             </a>
             <button class="add-btn" onclick="quickAddToCart('cut-shred-knife')">+</button>
           </div>
           <div class="product-content">
             <h3 class="product-title"><a href="/products/cut-shred-knife">CUT & SHRED KNIFE</a></h3>
             <div class="product-price">
               <span class="sale-price">Rs. 799.00</span>
               <span class="compare-price">Rs. 1,799.00</span>
               <div class="save-text">Save 56%</div>
             </div>
           </div>
        </div>

    </div>
  </div>
</section>

<style>
  .mock-product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px; /* Keep tight gap */
  }

  /* Image Area */
  .product-image-wrapper {
    position: relative;
    border-radius: 12px;
    overflow: visible !important;
    margin-bottom: 10px;
    background: #f4f4f4;
    aspect-ratio: 1 / 1; /* Square images */
  }
  
  .mock-image {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
  }

  .mock-sale-badge {
    position: absolute;
    top: 10px;
    left: 0;
    background: #d32f2f;
    color: white;
    padding: 4px 8px;
    font-size: 0.7rem;
    font-weight: 700;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    z-index: 2;
  }
  
  .add-btn {
      position: absolute !important;
      top: 10px !important;
      right: 10px !important;
      background: #ff6f00 !important;
      color: white !important;
      border: none !important;
      width: 35px !important;
      height: 35px !important;
      border-radius: 50% !important;
      font-size: 1.3rem !important;
      line-height: 1 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      cursor: pointer !important;
      z-index: 9999 !important;
      box-shadow: 0 3px 8px rgba(255, 111, 0, 0.6) !important;
      pointer-events: auto !important;
  }

  /* Content */
  .product-content {
    text-align: left;
    padding: 0 5px;
  }

  .product-title {
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 5px;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.6em; /* Align cards */
  }

  .product-title a { color: #333; text-decoration: none; }

  .product-price {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .sale-price {
    font-size: 1.1rem;
    font-weight: 700;
    color: #333;
  }

  .compare-price {
    font-size: 0.8rem;
    color: #888;
    text-decoration: line-through;
  }
  
  .save-text {
      color: #d32f2f;
      font-size: 0.8rem;
      font-weight: 600;
  }
  
  @media(min-width: 768px) {
      .mock-product-grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>

<script>
function quickAddToCart(productHandle) {
  event.stopPropagation();
  event.preventDefault();
  
  const btn = event.target;
  const originalText = btn.textContent;
  btn.textContent = '⏳';
  btn.disabled = true;
  
  // Get product and add to cart
  fetch(`/products/${productHandle}.js`)
    .then(response => {
      if (!response.ok) throw new Error('Product not found');
      return response.json();
    })
    .then(product => {
      const variant = product.variants.find(v => v.available) || product.variants[0];
      if (!variant) throw new Error('No variants');
      
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: variant.id, quantity: 1 }] })
      });
    })
    .then(response => response.json())
    .then(data => {
      btn.textContent = '✓';
      btn.style.background = '#00C853';
      
      // Update cart and open drawer
      fetch('/cart.js')
        .then(r => r.json())
        .then(cart => {
          const cartCount = document.querySelector('.cart-count');
          if (cartCount) {
            cartCount.textContent = cart.item_count;
            cartCount.style.display = cart.item_count > 0 ? 'flex' : 'none';
          }
          
          // Auto-open cart drawer
          setTimeout(() => {
            const cartDrawer = document.getElementById('cart-drawer');
            const cartBackdrop = document.getElementById('cart-backdrop');
            if (cartDrawer && cartBackdrop) {
              cartDrawer.classList.add('open');
              cartBackdrop.classList.add('open');
              if (window.loadCartItems) window.loadCartItems();
            }
          }, 300);
        });
      
      setTimeout(() => {
        btn.textContent = originalText;
        btn.style.background = '#ff6f00';
        btn.disabled = false;
      }, 1500);
    })
    .catch(error => {
      console.error('Error:', error);
      // Product doesn't exist - show error
      btn.textContent = '×';
      btn.style.background = '#d32f2f';
      alert('This product is not available yet. Please contact us to order!');
      
      setTimeout(() => {
        btn.textContent = originalText;
        btn.style.background = '#ff6f00';
        btn.disabled = false;
      }, 2000);
    });
}
</script>
