<style>
  .mock-product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px; /* Keep tight gap */
  }

  /* Image Area */
  .product-image-wrapper {
    position: relative;
    border-radius: 12px;
    overflow: visible !important;
    margin-bottom: 10px;
    background: #f4f4f4;
    aspect-ratio: 1 / 1; /* Square images */
  }
  
  .mock-image {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
  }

  .mock-sale-badge {
    position: absolute;
    top: 10px;
    left: 0;
    background: #d32f2f;
    color: white;
    padding: 4px 8px;
    font-size: 0.7rem;
    font-weight: 700;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    z-index: 2;
  }
  
  .add-btn {
      position: absolute !important;
      top: 10px !important;
      right: 10px !important;
      background: #ff6f00 !important;
      color: white !important;
      border: none !important;
      width: 35px !important;
      height: 35px !important;
      border-radius: 50% !important;
      font-size: 1.3rem !important;
      line-height: 1 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      cursor: pointer !important;
      z-index: 9999 !important;
      box-shadow: 0 3px 8px rgba(255, 111, 0, 0.6) !important;
      pointer-events: auto !important;
  }

  /* Content */
  .product-content {
    text-align: left;
    padding: 0 5px;
  }

  .product-title {
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 5px;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.6em; /* Align cards */
  }

  .product-title a { color: #333; text-decoration: none; }

  .product-price {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .sale-price {
    font-size: 1.1rem;
    font-weight: 700;
    color: #333;
  }

  .compare-price {
    font-size: 0.8rem;
    color: #888;
    text-decoration: line-through;
  }
  
  .save-text {
      color: #d32f2f;
      font-size: 0.8rem;
      font-weight: 600;
  }
  
  @media(min-width: 768px) {
      .mock-product-grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>

<script>
function quickAddToCart(productHandle) {
  event.stopPropagation();
  event.preventDefault();
  
  const btn = event.target;
  const originalText = btn.textContent;
  btn.textContent = '⏳';
  btn.disabled = true;
  
  // Get product and add to cart
  fetch(`/products/${productHandle}.js`)
    .then(response => {
      if (!response.ok) throw new Error('Product not found');
      return response.json();
    })
    .then(product => {
      const variant = product.variants.find(v => v.available) || product.variants[0];
      if (!variant) throw new Error('No variants');
      
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: variant.id, quantity: 1 }] })
      });
    })
    .then(response => response.json())
    .then(data => {
      btn.textContent = '✓';
      btn.style.background = '#00C853';
      
      // Update cart and open drawer
      fetch('/cart.js')
        .then(r => r.json())
        .then(cart => {
          const cartCount = document.querySelector('.cart-count');
          if (cartCount) {
            cartCount.textContent = cart.item_count;
            cartCount.style.display = cart.item_count > 0 ? 'flex' : 'none';
          }
          
          // Auto-open cart drawer
          setTimeout(() => {
            const cartDrawer = document.getElementById('cart-drawer');
            const cartBackdrop = document.getElementById('cart-backdrop');
            if (cartDrawer && cartBackdrop) {
              cartDrawer.classList.add('open');
              cartBackdrop.classList.add('open');
              if (window.loadCartItems) window.loadCartItems();
            }
          }, 300);
        });
      
      setTimeout(() => {
        btn.textContent = originalText;
        btn.style.background = '#ff6f00';
        btn.disabled = false;
      }, 1500);
    })
    .catch(error => {
      console.error('Error:', error);
      // Product doesn't exist - show error
      btn.textContent = '×';
      btn.style.background = '#d32f2f';
      alert('This product is not available yet. Please contact us to order!');
      
      setTimeout(() => {
        btn.textContent = originalText;
        btn.style.background = '#ff6f00';
        btn.disabled = false;
      }, 2000);
    });
}
</script>
