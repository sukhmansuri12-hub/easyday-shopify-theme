      display: block !important;
    }
    
    .filter-sidebar {
      position: fixed;
      top: 0;
      left: -100%;
      width: 85%;
      max-width: 350px;
      height: 100vh;
      z-index: 999;
      overflow-y: auto;
      transition: left 0.3s ease;
      border-radius: 0;
      box-shadow: 2px 0 15px rgba(0,0,0,0.2);
    }
    
    .filter-sidebar.open {
      left: 0;
    }
    
    .filter-backdrop.open {
      display: block;
    }
    
    .close-filters {
      display: block;
    }
    
    .product-grid-catalog {
      grid-template-columns: repeat(2, 1fr);
