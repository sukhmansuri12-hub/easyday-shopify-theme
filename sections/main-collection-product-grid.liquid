  .btn-pagination:hover {
    transform: translateY(-2px);
  }
  
  .page-info {
    font-weight: 600;
    color: #666;
  }
  
  /* Filter Backdrop */
  .filter-backdrop {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%:
    height: 100%;
    background: rgba(0,0,0,0.5);
    z-index: 998;
  }
  
  /* Mobile Styles */
  @media (max-width: 968px) {
    .collection-page {
      padding: 15px;
    }
    
    .mobile-filter-toggle {
      display: flex;
    }
    
