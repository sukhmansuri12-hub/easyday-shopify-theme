    color: #333;
    font-size: 1.1rem;
  }
  
  .main-filter-container {
    flex: 1;
    max-width: 300px;
  }
  
  .main-filter-dropdown {
    width: 100%;
    padding: 10px 15px;
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    font-size: 0.95rem;
    background: white;
    cursor: pointer;
    transition: all 0.3s;
  }
  
