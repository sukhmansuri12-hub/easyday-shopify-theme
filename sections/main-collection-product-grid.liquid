  }
</style>

<script>
  // Toggle filter drawer on mobile
  function toggleFilterDrawer() {
    const sidebar = document.getElementById('filterSidebar');
    const backdrop = document.getElementById('filterBackdrop');
    sidebar.classList.toggle('open');
    backdrop.classList.toggle('open');
  }
  
  // Price range sliders
  const priceMin = document.getElementById('priceMin');
  const priceMax = document.getElementById('priceMax');
  const priceMinDisplay = document.getElementById('priceMinDisplay');
  const priceMaxDisplay = document.getElementById('priceMaxDisplay');
  
  if (priceMin && priceMax) {
    priceMin.addEventListener('input', function() {
      if (parseInt(this.value) > parseInt(priceMax.value)) {
        this.value = priceMax.value;
      }
      priceMinDisplay.textContent = '₹' + this.value;
      applyFilters();
    });
    
    priceMax.addEventListener('input', function() {
      if (parseInt(this.value) < parseInt(priceMin.value)) {
        this.value = priceMin.value;
      }
      priceMaxDisplay.textContent = '₹' + this.value;
      applyFilters();
    });
  }
  
  // Category filters
  let activeCategories = [];
  
  function toggleCategoryFilter(checkbox) {
    const value = checkbox.value;
    if (checkbox.checked) {
      activeCategories.push(value);
    } else {
      activeCategories = activeCategories.filter(c => c !== value);
    }
    updateActiveFilters();
    applyFilters();
  }
  
  // Update active filters display
  function updateActiveFilters() {
    const container = document.getElementById('activeFilters');
    if (!container) return;
    
    let html = '';
    activeCategories.forEach(cat => {
      html += `
        <div class="filter-chip">
          ${cat}
          <button onclick="removeFilter('${cat}')">×</button>
        </div>
      `;
    });
    
    if (priceMin && (priceMin.value !== '0' || priceMax.value !== '5000')) {
      html += `
        <div class="filter-chip">
          ₹${priceMin.value} - ₹${priceMax.value}
          <button onclick="resetPriceFilter()">×</button>
        </div>
      `;
    }
    
    container.innerHTML = html;
  }
  
  // Remove individual filter
  function removeFilter(category) {
    const checkbox = document.querySelector(`input[value="${category}"]`);
    if (checkbox) {
      checkbox.checked = false;
      toggleCategoryFilter(checkbox);
    }
  }
  
  // Reset price filter
  function resetPriceFilter() {
    if (priceMin && priceMax) {
      priceMin.value = 0;
      priceMax.value = 5000;
      priceMinDisplay.textContent = '₹0';
      priceMaxDisplay.textContent = '₹5000';
      updateActiveFilters();
      applyFilters();
    }
  }
  
  // Clear all filters
  function clearAllFilters() {
    activeCategories = [];
    document.querySelectorAll('.filter-checkbox input').forEach(cb => cb.checked = false);
    resetPriceFilter();
    updateActiveFilters();
    applyFilters();
  }
  
  // Apply filters to products
  function applyFilters() {
    const products = document.querySelectorAll('.product-item');
    const minPrice = parseInt(priceMin?.value || 0);
    const maxPrice = parseInt(priceMax?.value || 999999);
    
    products.forEach(product => {
      const price = parseInt(product.dataset.price);
      const inPriceRange = price >= minPrice && price <= maxPrice;
      
      // For now, just show all products (category filtering would need product tags)
      if (inPriceRange) {
        product.style.display = 'block';
      } else {
        product.style.display = 'none';
      }
    });
  }
  
  // Unified main filter handler
  function handleMainFilter(value) {
    if (!value) return;
    
    // Check if it's a category (starts with /) or a sort option (starts with ?)
    if (value.startsWith('/')) {
      // Navigate to category
      window.location.href = value;
    } else if (value.startsWith('?')) {
      // Apply sorting to current page
      window.location.href = window.location.pathname + value;
    }
  }
  
  // Initialize from URL
  document.addEventListener('DOMContentLoaded', function() {
    const params = new URLSearchParams(window.location.search);
    const sortValue = params.get('sort_by');
    if (sortValue) {
      const sortSelect = document.getElementById('sortBy');
      if (sortSelect) {
        sortSelect.value = sortValue;
      }
    }
  });
</script>

{% schema %}
{
  "name": "Collection Product Grid"
}
{% endschema %}
