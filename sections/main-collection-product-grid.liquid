    }
    
    .catalog-toolbar {
      flex-direction: column;
      gap: 15px;
      align-items: stretch;
    }
    
    .main-filter-container {
      max-width: 100%;
    }
  }
  
  /* Product Grid */
  .product-grid-catalog {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }
  
  /* Pagination */
  .pagination-container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 40px;
    padding: 20px;
  }
  
  .btn-pagination {
    padding: 10px 20px;
    background: linear-gradient(135deg, #FF6F00 0%, #FF8F00 100%);
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: transform 0.3s;
  }
  
  .btn-pagination:hover {
    transform: translateY(-2px);
  }
  
  .page-info {
    font-weight: 600;
    color: #666;
  }
  
  /* Filter Backdrop */
  .filter-backdrop {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    z-index: 998;
  }
  
  /* Mobile Styles */
  @media (max-width: 968px) {
    .collection-page {
      padding: 15px;
    }
    
    .mobile-filter-toggle {
      display: flex;
    }
    
    .mobile-only {
      display: block !important;
    }
    
    .filter-sidebar {
      position: fixed;
      top: 0;
      left: -100%;
      width: 85%;
      max-width: 350px;
      height: 100vh;
      z-index: 999;
      overflow-y: auto;
      transition: left 0.3s ease;
