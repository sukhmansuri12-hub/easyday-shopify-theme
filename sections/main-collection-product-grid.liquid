    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 40px;
    padding: 20px;
  }
  
  .btn-pagination {
    padding: 10px 20px;
    background: linear-gradient(135deg, #FF6F00 0%, #FF8F00 100%);
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: transform 0.3s;
