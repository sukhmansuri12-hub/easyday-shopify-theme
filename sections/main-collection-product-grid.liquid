{% comment %}
  Main Collection Product Grid with Filters & Sorting
  Professional catalog page with sidebar filters (desktop) and drawer filters (mobile)
{% endcomment %}

{%- paginate collection.products by 12 -%}
  <section class="collection-page">
    
    <!-- Mobile Filter Toggle Button -->
    <button class="mobile-filter-toggle" onclick="toggleFilterDrawer()">
      <span class="filter-icon">☰</span>
      <span>Filters</span>
    </button>
    
    <!-- Filter Sidebar / Mobile Drawer -->
    <aside class="filter-sidebar" id="filterSidebar">
      <div class="filter-header">
        <h3>Filters</h3>
        <button class="close-filters" onclick="toggleFilterDrawer()">×</button>
      </div>
      
      <!-- Active Filters -->
      <div class="active-filters" id="activeFilters"></div>
      
      <!-- Price Range Filter -->
      <div class="filter-group">
        <h4 class="filter-title">Price Range</h4>
        <div class="price-filter">
          <div class="price-slider-container">
            <input type="range" id="priceMin" min="0" max="5000" value="0" step="100" class="price-slider">
            <input type="range" id="priceMax" min="0" max="5000" value="5000" step="100" class="price-slider">
          </div>
          <div class="price-display">
            <span id="priceMinDisplay">₹0</span>
            <span>-</span>
            <span id="priceMaxDisplay">₹5000</span>
          </div>
        </div>
      </div>
      
      <!-- Category/Tag Filters -->
      <div class="filter-group">
        <h4 class="filter-title">Categories</h4>
        <div class="filter-options">
          <label class="filter-checkbox">
            <input type="checkbox" value="kitchen" onchange="toggleCategoryFilter(this)">
            <span>Kitchen ({{ collection.all_tags | where: 'kitchen' | size }})</span>
          </label>
          <label class="filter-checkbox">
            <input type="checkbox" value="health" onchange="toggleCategoryFilter(this)">
            <span>Health & Wellness</span>
          </label>
          <label class="filter-checkbox">
            <input type="checkbox" value="home" onchange="toggleCategoryFilter(this)">
            <span>Home Essentials</span>
          </label>
          <label class="filter-checkbox">
            <input type="checkbox" value="toys" onchange="toggleCategoryFilter(this)">
            <span>Toys & Games</span>
          </label>
        </div>
      </div>
      
      <!-- Filter Actions -->
      <div class="filter-actions">
        <button class="btn-clear-filters" onclick="clearAllFilters()">Clear All</button>
        <button class="btn-apply-filters mobile-only" onclick="toggleFilterDrawer()">Apply Filters</button>
      </div>
    </aside>
    
    <!-- Filter Backdrop (Mobile) -->
    <div class="filter-backdrop" id="filterBackdrop" onclick="toggleFilterDrawer()"></div>
    
    <!-- Main Content -->
    <div class="catalog-content">
      
      <!-- Toolbar: Results Count & Unified Filter -->
      <div class="catalog-toolbar">
        <div class="results-count">
          <span style="font-size:0.9rem; color:#666;">Showing</span> <strong style="font-size:1.1rem; color:#333;">{{ collection.products.size }}</strong> <span style="font-size:0.9rem; color:#666;">Products</span>
        </div>
        
        <div class="main-filter-container">
          <select id="mainFilter" class="main-filter-dropdown" onchange="handleMainFilter(this.value)">
            <optgroup label="CATEGORIES">
              <option value="/collections/all" {% if collection.handle == 'all' %}selected{% endif %}>All Products</option>
              <option value="/collections/kitchen-essentials" {% if collection.handle == 'kitchen-essentials' %}selected{% endif %}>Kitchen Essentials</option>
              <option value="/collections/health-management" {% if collection.handle == 'health-management' %}selected{% endif %}>Health & Wellness</option>
              <option value="/collections/home-essentials" {% if collection.handle == 'home-essentials' %}selected{% endif %}>Home Essentials</option>
              <option value="/collections/bathroom-essentials" {% if collection.handle == 'bathroom-essentials' %}selected{% endif %}>Bathroom Essentials</option>
            </optgroup>
            <optgroup label="SORT BY">
              <option value="?sort_by=">Featured</option>
              <option value="?sort_by=price-ascending">Price: Low to High</option>
              <option value="?sort_by=price-descending">Price: High to Low</option>
              <option value="?sort_by=created-descending">Newest First</option>
              <option value="?sort_by=best-selling">Best Selling</option>
            </optgroup>
          </select>
        </div>
      </div>
      
      <!-- Products Grid -->
      {%- if collection.products.size > 0 -%}
        <div class="product-grid-catalog" id="productGrid">
          {%- for product in collection.products -%}
            <div class="product-item animate-on-scroll" data-animation="scale-in" data-price="{{ product.price }}">
              {% render 'product-card', product: product %}
            </div>
          {%- endfor -%}
        </div>

        <!-- Pagination -->
        {%- if paginate.pages > 1 -%}
          <div class="pagination-container">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="btn-pagination">← Previous</a>
            {%- endif -%}
            
            <span class="page-info">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="btn-pagination">Next →</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="empty-collection">
          <p>No products found</p>
        </div>
      {%- endif -%}
      
    </div>
  </section>
{%- endpaginate -%}

<style>
