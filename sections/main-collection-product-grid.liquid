    color: white;
  }
  
  .btn-apply-filters {
    padding: 12px 20px;
    background: linear-gradient(135deg, #FF6F00 0%, #FF8F00 100%);
    border: none;
    color: white;
    border-radius: 8px;
    font-weight: 700;
    cursor: pointer;
