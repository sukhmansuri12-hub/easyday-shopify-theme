<section class="category-section" style="background: white; padding: 30px 0 10px 0; position: relative; overflow: hidden;">
  <div class="container" style="max-width: 100%; padding: 0;">
    
    <h2 style="text-align: center; margin-bottom: 20px; font-size: 1.8rem; font-weight: 700; color: #222; padding: 0 15px; position: relative; z-index: 1;">Popular Categories</h2>

    <div class="category-grid">
      <a href="/collections/all?filter.p.tag=toys" class="category-card">
        <div class="category-image-wrapper">
          <img src="{{ 'category-toys-gifts.png' | asset_url }}" alt="Toys & Gifts" loading="lazy">
        </div>
        <p class="category-title">Toys & Gifts</p>
      </a>

      <a href="/collections/all?filter.p.tag=kitchen" class="category-card">
        <div class="category-image-wrapper">
          <img src="{{ 'category-home-kitchen.png' | asset_url }}" alt="Home & Kitchen" loading="lazy">
        </div>
        <p class="category-title">Home & Kitchen</p>
      </a>

      <a href="/collections/all?filter.p.tag=pets" class="category-card">
        <div class="category-image-wrapper">
          <img src="{{ 'category-pet-essentials.png' | asset_url }}" alt="Pet Essentials" loading="lazy">
        </div>
        <p class="category-title">Pet Essentials</p>
      </a>

      <a href="/collections/all?filter.p.tag=wellness" class="category-card">
        <div class="category-image-wrapper">
          <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=600&h=600&fit=crop&q=80" alt="Personal Care & Wellness" loading="lazy">
        </div>
        <p class="category-title">Personal Care & Wellness</p>
      </a>
    </div>
  </div>
</section>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    width: 100%;
    padding: 0 15px !important;
  }

  @media (min-width: 768px) {
    .category-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 30px;
      padding: 0 30px !important;
    }
  }

  .category-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: inherit;
    padding: 8px;
    animation: float 6s ease-in-out infinite !important;
    transition: all 0.3s ease;
  }
  
  /* Staggered animation delays */
  .category-card:nth-child(1) { 
    animation: float 6s ease-in-out infinite !important;
    animation-delay: 0s !important; 
  }
  .category-card:nth-child(2) { 
    animation: float 6s ease-in-out infinite !important;
    animation-delay: 1.5s !important; 
  }
  .category-card:nth-child(3) { 
    animation: float 6s ease-in-out infinite !important;
    animation-delay: 3s !important; 
  }
  .category-card:nth-child(4) { 
    animation: float 6s ease-in-out infinite !important;
    animation-delay: 4.5s !important; 
  }

  /* PROFESSIONAL COMPACT IMAGES */
  .category-image-wrapper {
    width: 140px;
    height: 140px;
    border-radius: 50% !important;
    background: #f8f8f8;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    transition: all 0.3s ease;
    position: relative;
  }
  
  @media (min-width: 768px) {
    .category-image-wrapper {
      width: 160px;
      height: 160px;
    }
  }
  
  .category-image-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255,111,0,0.1) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  
  .category-image-wrapper img {
    width: 110%;
    height: 110%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  
  /* Floating animation */
  @keyframes float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  
  /* Hover effects */
  .category-card:hover {
    transform: translateY(-8px) scale(1.05);
  }
  
  .category-card:hover .category-image-wrapper {
    box-shadow: 
      0 15px 40px rgba(255, 111, 0, 0.3),
      0 8px 20px rgba(0,0,0,0.15);
  }
  
  .category-card:hover .category-image-wrapper::before {
    opacity: 1;
  }
  
  .category-card:hover .category-image-wrapper img {
    transform: scale(1.15);
  }
  
  .category-card:active {
    transform: translateY(-4px) scale(1.02);
  }

  /* PROFESSIONAL SMALLER TEXT */
  .category-title {
    font-size: 0.85rem;
    font-weight: 600;
    margin: 0;
    color: #333;
    transition: all 0.3s ease;
    line-height: 1.2;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    letter-spacing: 0.3px;
  }
  
  @media (min-width: 768px) {
    .category-title {
      font-size: 0.9rem;
    }
  }
  
  .category-card:hover .category-title {
    color: #ff6f00;
  }
  
  @media (max-width: 767px) {
    .category-grid {
      gap: 12px;
      padding: 0 10px !important;
    }
    .category-image-wrapper {
      width: 130px;
      height: 130px;
    }
    .category-card {
      padding: 6px;
    }
    .category-title {
      font-size: 0.8rem;
    }
  }
</style>

{% schema %}
{
  "name": "Category Grid",
  "presets": [{ "name": "Category Grid" }]
}
{% endschema %}
