    <h2 style="text-align: center; margin-bottom: 20px; font-size: 1.8rem; font-weight: 700; color: #222; padding: 0 15px; position: relative; z-index: 1;">Popular Categories</h2>

    <div class="category-grid">
      <a href="/pages/toys-gifts" class="category-card">
        <div class="category-image-wrapper">
          <img src="{{ 'category-toys-gifts.png' | asset_url }}" alt="Toys & Gifts" loading="lazy">
        </div>
        <p class="category-title">Toys & Gifts</p>
      </a>

      <a href="/pages/home-kitchen" class="category-card">
        <div class="category-image-wrapper">
          <img src="{{ 'category-home-kitchen.png' | asset_url }}" alt="Home & Kitchen" loading="lazy">
        </div>
        <p class="category-title">Home & Kitchen</p>
      </a>

      <a href="/pages/clothing-accessories" class="category-card">
        <div class="category-image-wrapper">
          <img src="{{ 'category-clothing-accessories.png' | asset_url }}" alt="Clothing & Accessories" loading="lazy">
        </div>
        <p class="category-title">Clothing & Accessories</p>
      </a>

      <a href="/pages/personal-care-wellness" class="category-card">
        <div class="category-image-wrapper">
          <img src="{{ 'category-wellness.png' | asset_url }}" alt="Personal Care & Wellness" loading="lazy">
