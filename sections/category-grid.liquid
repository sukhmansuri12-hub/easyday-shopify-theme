<section class="category-section" style="background: white; padding: 30px 0 10px 0; position: relative; overflow: hidden;">
  <div class="container" style="max-width: 100%; padding: 0;">
    <!-- Decorative Background Lines - Full Coverage Topographic Pattern -->
    <svg class="decorative-lines" xmlns="http://www.w3.org/2000/svg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; opacity: 0.07; pointer-events: none;">
      <!-- Top Layer - Orange Contours -->
      <path d="M 0 80 Q 200 60, 400 90 T 800 85 T 1200 80" stroke="#FF6F00" stroke-width="1.5" fill="none"/>
      <path d="M -100 150 Q 150 120, 450 155 T 950 145 T 1300 150" stroke="#FF6F00" stroke-width="1.2" fill="none"/>
      <path d="M 50 220 Q 300 190, 600 225 T 1100 215 T 1400 220" stroke="#FF6F00" stroke-width="1" fill="none"/>
      
      <!-- Mid Layer - Green Contours -->
      <path d="M -50 40 Q 180 20, 420 45 T 850 38 T 1250 42" stroke="#00C853" stroke-width="1.3" fill="none"/>
      <path d="M 80 110 Q 280 85, 550 115 T 1000 105 T 1350 110" stroke="#00C853" stroke-width="1.5" fill="none"/>
      <path d="M 0 180 Q 220 155, 500 185 T 980 175 T 1400 180" stroke="#00C853" stroke-width="1.1" fill="none"/>
      <path d="M 100 250 Q 350 220, 650 255 T 1150 245 T 1450 250" stroke="#00C853" stroke-width="1.2" fill="none"/>
      
      <!-- Deep Layer - Blue Contours -->
      <path d="M -80 20 Q 170 5, 440 25 T 900 18 T 1320 22" stroke="#2196F3" stroke-width="1" fill="none"/>
      <path d="M 30 65 Q 240 45, 520 70 T 980 62 T 1380 66" stroke="#2196F3" stroke-width="1.4" fill="none"/>
      <path d="M -20 135 Q 200 110, 480 140 T 950 130 T 1350 135" stroke="#2196F3" stroke-width="1.2" fill="none"/>
      <path d="M 60 200 Q 310 175, 610 205 T 1080 195 T 1420 200" stroke="#2196F3" stroke-width="1" fill="none"/>
      <path d="M 120 270 Q 380 240, 680 275 T 1180 265 T 1500 270" stroke="#2196F3" stroke-width="1.3" fill="none"/>
      
      <!-- Accent Layers - Mixed Colors for Depth -->
      <path d="M 40 10 Q 190 -5, 460 15 T 920 8 T 1340 12" stroke="#FF6F00" stroke-width="0.9" fill="none"/>
      <path d="M -60 95 Q 160 75, 430 100 T 880 92 T 1280 96" stroke="#2196F3" stroke-width="1.1" fill="none"/>
      <path d="M 90 165 Q 320 140, 620 170 T 1050 160 T 1400 165" stroke="#00C853" stroke-width="1" fill="none"/>
      <path d="M -40 235 Q 230 205, 530 240 T 1020 230 T 1440 235" stroke="#FF6F00" stroke-width="1.2" fill="none"/>
      <path d="M 70 295 Q 340 265, 660 300 T 1140 290 T 1480 295" stroke="#2196F3" stroke-width="1.1" fill="none"/>
      <path d="M 110 330 Q 390 300, 710 335 T 1200 325 T 1520 330" stroke="#00C853" stroke-width="1" fill="none"/>
    </svg>
    
    <h2 style="text-align: center; margin-bottom: 20px; font-size: 1.8rem; font-weight: 700; color: #222; padding: 0 15px; position: relative; z-index: 1;">Popular Categories</h2>

    <div class="category-grid">
      <a href="/pages/toys-gifts" class="category-card">
        <div class="category-image-wrapper">
          <img src="{{ 'category-toys-gifts.png' | asset_url }}" alt="Toys & Gifts" loading="lazy">
        </div>
        <p class="category-title">Toys & Gifts</p>
      </a>

      <a href="/pages/home-kitchen" class="category-card">
        <div class="category-image-wrapper">
          <img src="{{ 'category-home-kitchen.png' | asset_url }}" alt="Home & Kitchen" loading="lazy">
        </div>
        <p class="category-title">Home & Kitchen</p>
      </a>

      <a href="/pages/clothing-accessories" class="category-card">
        <div class="category-image-wrapper">
          <img src="{{ 'category-clothing-accessories.png' | asset_url }}" alt="Clothing & Accessories" loading="lazy">
        </div>
        <p class="category-title">Clothing & Accessories</p>
      </a>

      <a href="/pages/personal-care-wellness" class="category-card">
        <div class="category-image-wrapper">
          <img src="{{ 'category-wellness.png' | asset_url }}" alt="Personal Care & Wellness" loading="lazy">
        </div>
        <p class="category-title">Personal Care & Wellness</p>
      </a>
    </div>
  </div>
</section>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0px;
    width: 100%;
    padding: 0 !important;
  }

  @media (min-width: 768px) {
    .category-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 0px;
    }
  }

  .category-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: inherit;
    padding: 5px;
    animation: float 6s ease-in-out infinite !important;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  
  /* Staggered animation delays - ENSURE ALL CARDS ANIMATE */
  .category-card:nth-child(1) { 
    animation: float 6s ease-in-out infinite !important;
    animation-delay: 0s !important; 
  }
  .category-card:nth-child(2) { 
    animation: float 6s ease-in-out infinite !important;
    animation-delay: 1.5s !important; 
  }
  .category-card:nth-child(3) { 
    animation: float 6s ease-in-out infinite !important;
    animation-delay: 3s !important; 
  }
  .category-card:nth-child(4) { 
    animation: float 6s ease-in-out infinite !important;
    animation-delay: 4.5s !important; 
  }

  .category-image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    background: linear-gradient(135deg, #fff 0%, #f8f8f8 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    overflow: hidden;
    box-shadow: 
      0 8px 20px rgba(0,0,0,0.08),
      0 2px 6px rgba(0,0,0,0.04);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
  }
  
  .category-image-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255,111,0,0.1) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  
  .category-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  
  /* Floating animation - CRITICAL: Ensure it works */
  @keyframes float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  
  /* Hover effects */
  .category-card:hover {
    transform: translateY(-8px) scale(1.02);
  }
  
  .category-card:hover .category-image-wrapper {
    box-shadow: 
      0 15px 35px rgba(255, 111, 0, 0.25),
      0 5px 15px rgba(0,0,0,0.1);
    border-radius: 20px;
  }
  
  .category-card:hover .category-image-wrapper::before {
    opacity: 1;
  }
  
  .category-card:hover .category-image-wrapper img {
    transform: scale(1.08) rotate(2deg);
  }
  
  .category-card:active {
    transform: translateY(-4px) scale(0.98);
  }

  .category-title {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
    color: #333;
    transition: all 0.3s ease;
  }
  
  .category-card:hover .category-title {
    color: #ff6f00;
    transform: scale(1.05);
  }
  
  @media (max-width: 767px) {
    .category-title { 
      font-size: 0.85rem; 
    }
    .category-grid {
      gap: 0px;
    }
    .category-image-wrapper {
      border-radius: 12px;
    }
    .category-card {
      padding: 3px;
    }
  }
</style>

{% schema %}
{
  "name": "Category Grid",
  "presets": [{ "name": "Category Grid" }]
}
{% endschema %}
