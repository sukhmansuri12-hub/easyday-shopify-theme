<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0px;
    width: 100%;
    padding: 0 !important;
  }

  @media (min-width: 768px) {
    .category-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 0px;
    }
  }

  .category-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: inherit;
    padding: 5px;
    animation: float 6s ease-in-out infinite !important;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  
  /* Staggered animation delays - ENSURE ALL CARDS ANIMATE */
  .category-card:nth-child(1) { 
    animation: float 6s ease-in-out infinite !important;
    animation-delay: 0s !important; 
  }
  .category-card:nth-child(2) { 
    animation: float 6s ease-in-out infinite !important;
    animation-delay: 1.5s !important; 
  }
  .category-card:nth-child(3) { 
    animation: float 6s ease-in-out infinite !important;
    animation-delay: 3s !important; 
  }
  .category-card:nth-child(4) { 
    animation: float 6s ease-in-out infinite !important;
    animation-delay: 4.5s !important; 
  }

  .category-image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    background: linear-gradient(135deg, #fff 0%, #f8f8f8 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    overflow: hidden;
    box-shadow: 
      0 8px 20px rgba(0,0,0,0.08),
      0 2px 6px rgba(0,0,0,0.04);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
  }
  
  .category-image-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255,111,0,0.1) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  
  .category-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  
  /* Floating animation - CRITICAL: Ensure it works */
  @keyframes float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  
  /* Hover effects */
  .category-card:hover {
    transform: translateY(-8px) scale(1.02);
  }
  
  .category-card:hover .category-image-wrapper {
    box-shadow: 
      0 15px 35px rgba(255, 111, 0, 0.25),
      0 5px 15px rgba(0,0,0,0.1);
    border-radius: 20px;
  }
  
  .category-card:hover .category-image-wrapper::before {
    opacity: 1;
  }
  
  .category-card:hover .category-image-wrapper img {
    transform: scale(1.08) rotate(2deg);
  }
  
  .category-card:active {
    transform: translateY(-4px) scale(0.98);
  }

  .category-title {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
    color: #333;
    transition: all 0.3s ease;
  }
  
  .category-card:hover .category-title {
    color: #ff6f00;
    transform: scale(1.05);
  }
  
  @media (max-width: 767px) {
    .category-title { 
      font-size: 0.85rem; 
    }
    .category-grid {
      gap: 0px;
    }
    .category-image-wrapper {
      border-radius: 12px;
    }
    .category-card {
      padding: 3px;
    }
  }
</style>

{% schema %}
{
  "name": "Category Grid",
  "presets": [{ "name": "Category Grid" }]
}
{% endschema %}
