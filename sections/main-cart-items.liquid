{% comment %} Cart Section {% endcomment %}
<div class="cart-section section-padding" style="background:#f9f9f9; min-height: 500px;">
  <div class="container">
    <h1 class="text-center" style="margin-bottom: 20px;">Your Cart</h1>

    {% if cart.item_count > 0 %}
      <div class="cart-items">
         {% for item in cart.items %}
           <div class="cart-item" style="background:white; padding:15px; margin-bottom:10px; border-radius:8px; display:flex; gap:15px; align-items:center;" data-line-item="{{ forloop.index }}">
              <img src="{{ item.image | image_url: width: 80 }}" style="border-radius:8px; width: 80px; height: 80px; object-fit: cover;">
              <div style="flex: 1;">
                  <h3 style="margin:0 0 8px 0; font-size:1rem;">{{ item.title }}</h3>
                  <p style="margin:0; color: #666; font-size:0.9rem;">{{ item.price | money }}</p>
                  
                  {% comment %} Quantity Controls {% endcomment %}
                  <div style="display:flex; gap:10px; align-items:center; margin-top:10px;">
                    <button class="qty-btn" onclick="updateQuantity({{ forloop.index }}, {{ item.quantity }} - 1)" style="width:30px; height:30px; border:1px solid #ddd; background:white; border-radius:4px; cursor:pointer; font-size:18px; display:flex; align-items:center; justify-content:center;">−</button>
                    <span style="min-width:30px; text-align:center; font-weight:600;">{{ item.quantity }}</span>
                    <button class="qty-btn" onclick="updateQuantity({{ forloop.index }}, {{ item.quantity }} + 1)" style="width:30px; height:30px; border:1px solid #ddd; background:white; border-radius:4px; cursor:pointer; font-size:18px; display:flex; align-items:center; justify-content:center;">+</button>
                  </div>
              </div>
              
              {% comment %} Remove Button {% endcomment %}
              <button onclick="removeFromCart({{ forloop.index }})" style="background:transparent; border:none; color:#999; font-size:20px; cursor:pointer; padding:8px; transition: color 0.2s;" onmouseover="this.style.color='#FF0000'" onmouseout="this.style.color='#999'" title="Remove item">
                🗑️
              </button>
           </div>
         {% endfor %}
      </div>
      
      <div class="cart-footer" style="background:white; padding:20px; border-radius:8px; margin-top:20px;">
          <div style="display:flex; justify-content:space-between; margin-bottom:10px;">
              <span>Subtotal</span>
              <span>{{ cart.total_price | money }}</span>
          </div>
          <div style="display:flex; justify-content:space-between; margin-bottom:10px; color: green; font-weight:bold;">
              <span>Prepaid Discount (10%)</span>
              <span>- {{ cart.total_price | times: 0.1 | money }}</span>
          </div>
          <hr>
          <div style="display:flex; justify-content:space-between; margin-top:10px; font-size:1.2rem; font-weight:bold;">
              <span>Total (Prepaid)</span>
              <span>{{ cart.total_price | times: 0.9 | money }}</span>
          </div>
          
          <button class="btn btn-cod" style="width:100%; margin-top:20px; padding:15px; background: #FF6F00; color:white; border:none; border-radius:30px; font-weight:bold;">
             PROCEED TO CHECKOUT
          </button>
      </div>

    {% else %}
       <div class="empty-cart text-center">
           <p>Your cart is empty.</p>
           <a href="/" class="btn" style="text-decoration: underline;">Continue Shopping</a>
       </div>
    {% endif %}
  </div>
</div>

<script>
  // Remove item from cart
  function removeFromCart(lineItem) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        line: lineItem,
        quantity: 0
      })
    })
    .then(response => response.json())
    .then(data => {
      // Reload page to show updated cart
      window.location.reload();
    })
    .catch(error => {
      console.error('Error removing item:', error);
      alert('Failed to remove item. Please try again.');
    });
  }

  // Update item quantity
  function updateQuantity(lineItem, newQuantity) {
    // Prevent negative quantities
    if (newQuantity < 0) return;
    
    // If quantity is 0, remove the item
    if (newQuantity === 0) {
      removeFromCart(lineItem);
      return;
    }

    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        line: lineItem,
        quantity: newQuantity
      })
    })
    .then(response => response.json())
    .then(data => {
      // Reload page to show updated cart
      window.location.reload();
    })
    .catch(error => {
      console.error('Error updating quantity:', error);
      alert('Failed to update quantity. Please try again.');
    });
  }

  // Make checkout button functional
  document.addEventListener('DOMContentLoaded', function() {
    const checkoutBtn = document.querySelector('.btn-cod');
    if (checkoutBtn) {
      checkoutBtn.addEventListener('click', function() {
        window.location.href = '/checkout';
      });
    }
  });
</script>

{% schema %}
{ "name": "Cart Items", "presets": [{"name": "Cart Items"}] }
{% endschema %}
