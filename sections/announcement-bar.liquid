<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap');

  .sds-announcement-container {
    background: #1a56db !important;
    height: 40px !important;
    max-height: 40px !important;
    overflow: hidden !important;
    display: block !important;
    position: relative;
    z-index: 9999;
  }

  .sds-announcement-bar {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .sds-announcement-marquee {
    display: flex;
    white-space: nowrap;
    animation: sdsMarqueeScroll 22s linear infinite;
    will-change: transform;
  }

  .sds-announcement-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0 48px;
    font-family: 'Poppins', sans-serif;
    color: rgba(255,255,255,0.9) !important;
    font-size: 14px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.5px;
  }

  .sds-announcement-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    fill: rgba(255,255,255,0.9);
    color: rgba(255,255,255,0.9);
    vertical-align: middle;
  }

  @keyframes sdsMarqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": []
}
{% endschema %}
