<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@700&display=swap');

  .sds-announcement-container {
    background: #1a56db !important;
    height: 38px !important;
    max-height: 38px !important;
    overflow: hidden !important;
    display: block !important;
    position: relative !important;
    z-index: 1002 !important;
  }

  .sds-announcement-bar {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .sds-announcement-marquee {
    display: flex;
    white-space: nowrap;
    will-change: transform;
    /* Animation applied by JS after offset is set */
  }

  .sds-announcement-marquee.sds-marquee-running {
    animation: sdsMarqueeScroll 25s linear infinite;
  }

  .sds-announcement-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 20px;
    font-family: 'Poppins', sans-serif;
    color: #ffffff !important;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.5px;
  }

  .sds-announcement-item strong {
    font-weight: 700;
    color: #ffffff;
  }

  /* Prepaid item — same white as all other items */
  .sds-prepaid-item {
    color: #ffffff !important;
    font-size: 14px;
  }

  .sds-prepaid-item strong {
    color: #ffffff !important;
  }

  .sds-prepaid-icon {
    color: #ffffff !important;
    stroke: #ffffff !important;
  }

  .sds-announcement-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    color: #ffffff;
    stroke: #ffffff;
    fill: none;
    vertical-align: middle;
  }

  @keyframes sdsMarqueeScroll {
    0% { transform: translateX(var(--sds-start-x, 0px)); }
    100% { transform: translateX(calc(var(--sds-start-x, 0px) - 33.33333%)); }
  }
</style>

<script>
  (function() {
    var marquee = document.getElementById('sdsMarquee');
    if (!marquee) return;

    // Wait for layout to settle
    requestAnimationFrame(function() {
      requestAnimationFrame(function() {
        var prepaidItem = marquee.querySelector('#sdsPrepaidMain');
        if (!prepaidItem) {
          marquee.classList.add('sds-marquee-running');
          return;
        }

        var screenCenter = window.innerWidth / 2;
        var targetLeft = window.innerWidth * 0.25; // 25% from the left to match screenshot
        var itemLeft = prepaidItem.getBoundingClientRect().left;

        // Offset so the main prepaid text starts from 25% of the screen
        var startX = -(itemLeft - targetLeft);

        // We have 3 copies of the pair now (Left Buffer, Main, Right Buffer)
        // This ensures moving left or right won't expose empty edges.
        marquee.style.setProperty('--sds-start-x', startX + 'px');
        marquee.style.transform = 'translateX(' + startX + 'px)';

        // Small delay so the user sees the centered text before it starts moving
        setTimeout(function() {
          marquee.classList.add('sds-marquee-running');
        }, 600);
      });
    });
  })();
</script>

