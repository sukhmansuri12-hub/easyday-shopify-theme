{% comment %}
  Announcement Bar - Animated Slider
{% endcomment %}
{%- if section.settings.announcement_1 != blank or section.settings.announcement_2 != blank -%}
  <div class="announcement-bar">
    <div class="announcement-wrapper">
        <div class="announcement-slide">
            {{ section.settings.announcement_1 }}
        </div>
        <div class="announcement-slide">
            {{ section.settings.announcement_2 }}
        </div>
    </div>
  </div>
  <style>
      .announcement-bar { 
          background: #ff6f00; 
          color: white; 
          padding: 6px 10px !important; 
          height: 32px; 
          overflow: hidden; 
          position: relative;
      }
      .announcement-wrapper {
          position: relative;
          height: 100%;
          width: 100%;
      }
      .announcement-slide {
          position: absolute;
          width: 100%;
          height: 100%;
          text-align: center;
          opacity: 0;
          transform: translateY(100%);
          animation: slideUp 6s infinite ease-in-out;
          font-weight: bold;
          font-size: 0.9rem;
          display: flex;
          align-items: center;
          justify-content: center;
      }
      
      /* Stagger the second message */
      .announcement-slide:nth-child(1) { animation-delay: 0s; }
      .announcement-slide:nth-child(2) { animation-delay: 3s; }

      @keyframes slideUp {
          0% { opacity: 0; transform: translateY(100%); }
          10% { opacity: 1; transform: translateY(0); }
          40% { opacity: 1; transform: translateY(0); }
          50% { opacity: 0; transform: translateY(-100%); }
          100% { opacity: 0; transform: translateY(-100%); }
      }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "announcement_1",
      "label": "Announcement 1",
      "default": "Free Shipping All OVER India"
    },
    {
      "type": "text",
      "id": "announcement_2",
      "label": "Announcement 2",
      "default": "SAVE 10% Extra on Prepaid Orders"
    }
  ]
}
{% endschema %}
