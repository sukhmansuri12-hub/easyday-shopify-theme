{% comment %}
  Announcement Bar - Horizontal Marquee (3 messages)
{% endcomment %}
<div class="announcement-bar">
  <div class="announcement-marquee">
    <span class="announcement-marquee__inner">
      🎉 15% OFF on Prepaid Orders
      &nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;
      🔥 SALE 50% OFF
      &nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;
      🚀 Free Shipping All Over India
      &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
      🎉 15% OFF on Prepaid Orders
      &nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;
      🔥 SALE 50% OFF
      &nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;
      🚀 Free Shipping All Over India
      &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    </span>
  </div>
</div>

<style>
  .announcement-bar {
    background: #1a56db;
    color: #fff;
    height: 32px;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .announcement-marquee {
    width: 100%;
    overflow: hidden;
    white-space: nowrap;
  }
  .announcement-marquee__inner {
    display: inline-block;
    white-space: nowrap;
    animation: announcementScroll 20s linear infinite;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  @keyframes announcementScroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": []
}
{% endschema %}
