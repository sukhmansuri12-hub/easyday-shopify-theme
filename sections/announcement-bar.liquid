      <!-- Duplicate set for marquee -->
      <div class="sds-announcement-item">
        <svg class="sds-announcement-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82zM7 7h.01"></path></svg>
        Extra 100 Off On Prepaid Orders
      </div>
      <div class="sds-announcement-item">
        🌿 Spring Sale Up To 60% Off
      </div>
    </div>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@700&display=swap');

  /* Container forced to fixed height to stop page jumping */
  .sds-announcement-container {
    background: #1a56db !important;
    height: 42px !important; /* Increased for larger 15px text */
    max-height: 42px !important;
    overflow: hidden !important;
    display: block !important;
    position: relative;
    z-index: 9999;
  }

  .sds-announcement-bar {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .sds-announcement-marquee {
    display: flex;
    white-space: nowrap;
    animation: sdsMarqueeScroll 25s linear infinite;
    will-change: transform;
  }

  .sds-announcement-item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 0 50px;
    font-family: 'Poppins', sans-serif;
    color: #ffffff !important;
    font-size: 15px; /* Matched to Glitterbabe */
    font-weight: 700; /* Matched to Glitterbabe */
    line-height: 21px; /* Matched to Glitterbabe */
    letter-spacing: normal;
    text-transform: none; /* Matched to Glitterbabe (no more forced uppercase) */
  }

  .sds-announcement-icon {
    width: 18px; /* Slightly larger to match 15px font */
    height: 18px;
    flex-shrink: 0;
    stroke: #ffffff;
    vertical-align: middle;
  }

  @keyframes sdsMarqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); } 
  }

  @media (max-width: 480px) {
    .sds-announcement-container { height: 40px !important; }
    .sds-announcement-item {
      padding: 0 35px;
      font-size: 14px; /* Slightly scaled for small mobile but still prominent */
    }
  }
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": []
}
{% endschema %}
