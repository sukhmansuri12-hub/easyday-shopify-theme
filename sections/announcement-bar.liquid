{% comment %}
  Announcement Bar - Horizontal Marquee (3 messages)
{% endcomment %}
<div class="sds-announcement-container">
  <div class="sds-announcement-bar">
    <div class="sds-announcement-marquee">
      <!-- We use 4 blocks for a perfectly seamless feel on all screen sizes -->
      <div class="sds-announcement-item">
        <svg class="sds-announcement-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82zM7 7h.01"></path></svg>
        EXTRA 100 OFF ON PREPAID ORDERS
      </div>
      <div class="sds-announcement-item">
        🌿 SPRING SALE UP TO 60% OFF
      </div>
      <div class="sds-announcement-item">
        <svg class="sds-announcement-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82zM7 7h.01"></path></svg>
        EXTRA 100 OFF ON PREPAID ORDERS
      </div>
      <div class="sds-announcement-item">
        🌿 SPRING SALE UP TO 60% OFF
      </div>
      <!-- Duplicate set for marquee -->
      <div class="sds-announcement-item">
        <svg class="sds-announcement-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82zM7 7h.01"></path></svg>
        EXTRA 100 OFF ON PREPAID ORDERS
      </div>
      <div class="sds-announcement-item">
        🌿 SPRING SALE UP TO 60% OFF
      </div>
    </div>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@600&display=swap');

  /* Container forced to fixed height to stop page jumping */
  .sds-announcement-container {
    background: #1a56db !important;
    height: 38px !important;
    max-height: 38px !important;
    overflow: hidden !important;
    display: block !important;
    position: relative;
    z-index: 9999;
  }

  .sds-announcement-bar {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .sds-announcement-marquee {
    display: flex;
    white-space: nowrap;
    animation: sdsMarqueeScroll 25s linear infinite;
    will-change: transform;
  }

  .sds-announcement-item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 0 50px; /* Generous spacing */
    font-family: 'Poppins', sans-serif;
    color: #ffffff !important;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .sds-announcement-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    stroke: #ffffff;
    vertical-align: middle;
  }

  @keyframes sdsMarqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); } /* Halfway because we duplicated the items */
  }

  @media (max-width: 480px) {
    .sds-announcement-container { height: 35px !important; }
    .sds-announcement-item {
      padding: 0 35px;
      font-size: 11.5px;
    }
  }
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": []
}
{% endschema %}
