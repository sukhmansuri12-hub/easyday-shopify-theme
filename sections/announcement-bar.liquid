<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@700&display=swap');

  .sds-announcement-container {
    background: #1a56db !important;
    height: 38px !important;
    max-height: 38px !important;
    overflow: hidden !important;
    display: block !important;
    position: relative;
    z-index: 9999;
  }

  .sds-announcement-bar {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .sds-announcement-marquee {
    display: flex;
    white-space: nowrap;
    /* Same speed as Glitterbabe ~25s, tight gap between items */
    animation: sdsMarqueeScroll 25s linear infinite;
    will-change: transform;
  }

  .sds-announcement-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    /* Tight padding — matches Glitterbabe gap between items */
    padding: 0 20px;
    font-family: 'Poppins', sans-serif;
    color: #ffffff !important;
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.5px;
  }

  .sds-announcement-item strong {
    font-weight: 700;
    color: #ffffff;
  }

  .sds-announcement-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    color: #ffffff;
    stroke: #ffffff;
    fill: none;
    vertical-align: middle;
  }

  @keyframes sdsMarqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": []
}
{% endschema %}
