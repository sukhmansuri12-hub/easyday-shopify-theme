{% layout 'theme' %}

<section class="collection-page" style="padding: 20px;">
  <div class="container">
    <h1 style="text-align: center; margin: 20px 0 30px 0; font-size: 1.8rem;">Health Management</h1>
    
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; max-width: 1200px; margin: 0 auto;">
        
        {%comment%} Shoulder Brace {%endcomment%}
        <div class="product-card">
           <div style="position: relative; border-radius: 12px; overflow: hidden; margin-bottom: 10px; background: #f4f4f4; aspect-ratio: 1 / 1;">
             <span style="position: absolute; top: 10px; left: 10px; background: #e63946; color: white; padding: 5px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: bold; z-index: 2;">SALE 50%</span>
             <a href="/products/shoulder-brace">
                <div style="width: 100%; height: 100%; background-image: url('https://img.freepik.com/free-photo/man-wearing-shoulder-brace_23-2149176313.jpg?w=740'); background-size: cover; background-position: center;"></div>
             </a>
           </div>
           <div>
             <h3 style="font-size: 0.9rem; margin-bottom: 8px;"><a href="/products/shoulder-brace" style="text-decoration: none; color: #333;">Shoulder Brace For Pain Relief | 🔥FLAT 50% OFF SALE🔥</a></h3>
             <div>
               <span style="color: #e63946; font-weight: bold; font-size: 1.1rem;">Rs. 799.00</span>
               <span style="text-decoration: line-through; color: #999; font-size: 0.9rem; margin-left: 8px;">Rs. 1,599.00</span>
               <div style="color: #28a745; font-size: 0.8rem; margin-top: 4px;">Save 50%</div>
             </div>
           </div>
        </div>

        {%comment%} Knee Sleeves {%endcomment%}
        <div class="product-card">
           <div style="position: relative; border-radius: 12px; overflow: hidden; margin-bottom: 10px; background: #f4f4f4; aspect-ratio: 1 / 1;">
             <span style="position: absolute; top: 10px; left: 10px; background: #e63946; color: white; padding: 5px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: bold; z-index: 2;">SALE 46%</span>
             <a href="/products/knee-sleeves">
                <div style="width: 100%; height: 100%; background-image: url('https://img.freepik.com/free-photo/knee-brace-support_23-2149234876.jpg?w=740'); background-size: cover; background-position: center;"></div>
             </a>
           </div>
           <div>
             <h3 style="font-size: 0.9rem; margin-bottom: 8px;"><a href="/products/knee-sleeves" style="text-decoration: none; color: #333;">Bamboo Compression Knee Sleeves- 🔥Buy 1 Get 1 Free🔥</a></h3>
             <div>
               <span style="color: #e63946; font-weight: bold; font-size: 1.1rem;">Rs. 699.00</span>
               <span style="text-decoration: line-through; color: #999; font-size: 0.9rem; margin-left: 8px;">Rs. 1,299.00</span>
               <div style="color: #28a745; font-size: 0.8rem; margin-top: 4px;">Save 46%</div>
             </div>
           </div>
        </div>

    </div>
  </div>
</section>
