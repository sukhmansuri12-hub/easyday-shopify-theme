             <a href="/products/necklace-set">
                <div style="width: 100%; height: 100%; background-image: url('https://img.freepik.com/free-photo/luxury-necklace-display_23-2150036224.jpg?w=740'); background-size: cover; background-position: center;"></div>
             </a>
           </div>
           <div>
             <h3 style="font-size: 0.9rem; margin-bottom: 8px;"><a href="/products/necklace-set" style="text-decoration: none; color: #333;">Austrian Diamond Necklace Set | 🔥SET of 3 Necklace🔥</a></h3>
             <div>
               <span style="color: #e63946; font-weight: bold; font-size: 1.1rem;">Rs. 899.00</span>
