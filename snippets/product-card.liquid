{% comment %}
  Product Card Snippet with Auto Image Carousel
  Reusable product card for collections and featured products
  Usage: {% render 'product-card', product: product %}
{% endcomment %}

{%- assign product = product -%}

<a href="{{ product.url }}" class="product-card" data-product-handle="{{ product.handle }}">
  <div class="product-card-image" data-image-count="{{ product.images.size }}">
    {%- if product.images.size > 1 -%}
      {%- for image in product.images limit: 4 -%}
        <img 
          src="{{ image | image_url: width: 600 }}" 
          alt="{{ image.alt | default: product.title }}"
          loading="lazy"
          width="600"
          height="600"
          class="product-carousel-image {% if forloop.first %}active{% endif %}"
          data-index="{{ forloop.index0 }}"
        >
      {%- endfor -%}
      
      {%- if product.images.size > 1 -%}
        <div class="carousel-dots">
          {%- for image in product.images limit: 4 -%}
            <span class="dot {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}"></span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <img 
        src="{{ product.featured_image | image_url: width: 600 }}" 
        alt="{{ product.featured_image.alt | default: product.title }}"
        loading="lazy"
        width="600"
        height="600"
        class="product-carousel-image active"
      >
    {%- endif -%}
    
    {%- if product.compare_at_price > product.price -%}
      <div class="product-badge">Sale</div>
    {%- endif -%}
  </div>

  <div class="product-card-content">
    <h3 class="product-title">{{ product.title }}</h3>
    
    <div class="product-price">
      {%- if product.compare_at_price > product.price -%}
        <span class="price-sale">₹{{ product.price | money_without_currency }}</span>
        <span class="price-regular">₹{{ product.compare_at_price | money_without_currency }}</span>
        {%- assign savings_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
        <span class="price-savings">Save {{ savings_percent }}%</span>
      {%- else -%}
        <span class="price-sale">₹{{ product.price | money_without_currency }}</span>
      {%- endif -%}
    </div>
  </div>
</a>

<style>
  .product-card-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #f5f5f5;
    border-radius: 12px;
  }
  
  .product-carousel-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }
  
  .product-carousel-image.active {
    opacity: 1;
    position: relative;
  }
  
  .carousel-dots {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
    z-index: 10;
    padding: 6px 12px;
    background: rgba(0,0,0,0.3);
    border-radius: 20px;
  }
  
  .carousel-dots .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255,255,255,0.5);
    transition: all 0.3s;
  }
  
  .carousel-dots .dot.active {
    background: white;
    width: 20px;
    border-radius: 3px;
  }
</style>

<script>
(function() {
  // Auto-rotate product images continuously
  document.addEventListener('DOMContentLoaded', function() {
    const productCards = document.querySelectorAll('.product-card');
    
    productCards.forEach(card => {
      const imageContainer = card.querySelector('.product-card-image');
      const images = card.querySelectorAll('.product-carousel-image');
      const dots = card.querySelectorAll('.carousel-dots .dot');
      
      if (images.length <= 1) return; // Skip if only one image
      
      let currentIndex = 0;
      
      function showImage(index) {
        images.forEach((img, i) => {
          if (i === index) {
            img.classList.add('active');
            img.style.opacity = '1';
            img.style.position = 'relative';
          } else {
            img.classList.remove('active');
            img.style.opacity = '0';
            img.style.position = 'absolute';
          }
        });
        
        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === index);
        });
      }
      
      function nextImage() {
        currentIndex = (currentIndex + 1) % images.length;
        showImage(currentIndex);
      }
      
      // Start carousel automatically - continuous rotation
      setInterval(nextImage, 2000); // Change image every 2 seconds
    });
  });
})();
</script>
