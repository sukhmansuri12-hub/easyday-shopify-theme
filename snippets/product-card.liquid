{% comment %}
  Product Card Snippet with Auto Image Carousel
  Reusable product card for collections and featured products
  Usage: {% render 'product-card', product: product %}
{% endcomment %}

{%- assign product = product -%}

<a href="{{ product.url }}" class="product-card" data-product-handle="{{ product.handle }}">
  <div class="product-card-image" data-image-count="{{ product.images.size }}">
    {%- if product.images.size > 1 -%}
      {%- for image in product.images limit: 4 -%}
        <img 
          src="{{ image | image_url: width: 600 }}" 
          alt="{{ image.alt | default: product.title }}"
          loading="lazy"
          width="600"
          height="600"
          class="product-carousel-image {% if forloop.first %}active{% endif %}"
          data-index="{{ forloop.index0 }}"
        >
      {%- endfor -%}
    {%- else -%}
      <img 
        src="{{ product.featured_image | image_url: width: 600 }}" 
        alt="{{ product.featured_image.alt | default: product.title }}"
        loading="lazy"
        width="600"
        height="600"
        class="product-carousel-image active"
      >
    {%- endif -%}
    
    {%- if product.compare_at_price > product.price -%}
      {%- assign savings_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
      <div class="product-discount-badge">SAVE {{ savings_percent }}%</div>
    {%- endif -%}
  </div>

  <div class="product-card-content">
    <h3 class="product-title">{{ product.title }}</h3>
    
    <div class="product-price">
      {%- if product.compare_at_price > product.price -%}
        <span class="price-sale">₹{{ product.price | money_without_currency }}</span>
        <span class="price-regular">₹{{ product.compare_at_price | money_without_currency }}</span>
      {%- else -%}
        <span class="price-sale">₹{{ product.price | money_without_currency }}</span>
      {%- endif -%}
    </div>
  </div>
</a>
<button class="quick-add-btn-catalog" onclick="quickAddProductCatalog(event, {{ product.selected_or_first_available_variant.id }})">+</button>


<style>
  .product-card-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #f5f5f5;
    border-radius: 12px;
  }
  
  .product-carousel-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }
  
  .product-carousel-image.active {
    opacity: 1;
    position: relative;
  }
  
  /* Discount Badge */
  .product-discount-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #e74c3c;
    color: white;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    z-index: 2;
  }
  
  /* Quick Add Button */
  .quick-add-btn-catalog {
    position: absolute;
    bottom: 10px;
    right: 10px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #00C853;
    color: white;
    border: none;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,200,83,0.3);
    z-index: 3;
    transition: transform 0.2s;
  }
  
  .quick-add-btn-catalog:hover {
    transform: scale(1.1);
  }
</style>

<script>
(function() {
  // Auto-rotate product images continuously
  document.addEventListener('DOMContentLoaded', function() {
    const productCards = document.querySelectorAll('.product-card');
    
    productCards.forEach(card => {
      const imageContainer = card.querySelector('.product-card-image');
      const images = card.querySelectorAll('.product-carousel-image');
      const dots = card.querySelectorAll('.carousel-dots .dot');
      
      if (images.length <= 1) return; // Skip if only one image
      
      let currentIndex = 0;
      
      function showImage(index) {
        images.forEach((img, i) => {
          if (i === index) {
            img.classList.add('active');
            img.style.opacity = '1';
            img.style.position = 'relative';
          } else {
            img.classList.remove('active');
            img.style.opacity = '0';
            img.style.position = 'absolute';
          }
        });
        
        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === index);
        });
      }
      
      function nextImage() {
        currentIndex = (currentIndex + 1) % images.length;
        showImage(currentIndex);
      }
      
      // Start carousel automatically - continuous rotation
      setInterval(nextImage, 2000); // Change image every 2 seconds
    });
  });
})();

// Quick Add to Cart Function for Catalog
function quickAddProductCatalog(event, variantId) {
  event.preventDefault();
  event.stopPropagation();
  
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      id: variantId,
      quantity: 1
    })
  })
  .then(response => response.json())
  .then(data => {
    alert('✅ Added to cart!');
    // Update cart count if function exists
    if (window.updateCartCount) window.updateCartCount();
  })
  .catch(error => {
    console.error('Error:', error);
    alert('Failed to add to cart. Please try again.');
  });
}
</script>
