{% comment %}
  Product Card Snippet with Auto Image Carousel
  Reusable product card for collections and featured products
  Usage: {% render 'product-card', product: product %}
{% endcomment %}

{%- assign product = product -%}

<a href="{{ product.url }}" class="product-card" data-product-handle="{{ product.handle }}">
  <div class="product-card-image" data-image-count="{{ product.images.size }}">
    {%- if product.images.size > 1 -%}
      {%- for image in product.images limit: 4 -%}
        <img 
          src="{{ image | image_url: width: 600 }}" 
          alt="{{ image.alt | default: product.title }}"
          loading="lazy"
          width="600"
          height="600"
          class="product-carousel-image {% if forloop.first %}active{% endif %}"
          data-index="{{ forloop.index0 }}"
        >
      {%- endfor -%}
    {%- else -%}
      <img 
        src="{{ product.featured_image | image_url: width: 600 }}" 
        alt="{{ product.featured_image.alt | default: product.title }}"
        loading="lazy"
        width="600"
        height="600"
        class="product-carousel-image active"
      >
    {%- endif -%}
    
    {%- if product.compare_at_price > product.price -%}
      {%- assign savings_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
      <div class="homepage-style-badge">SALE {{ savings_percent }}%</div>
    {%- endif -%}
    
    <button class="homepage-style-add-btn" onclick="quickAddProductCatalog(event, {{ product.selected_or_first_available_variant.id }})">+</button>
  </div>

  <div class="product-card-content">
    <h3 class="product-title">{{ product.title }}</h3>
    
    <div class="product-price">
      <span class="price-sale">Rs. {{ product.price | money_without_currency }}</span>
      {%- if product.compare_at_price > product.price -%}
        <span class="price-regular">Rs. {{ product.compare_at_price | money_without_currency }}</span>
        <div class="save-text">Save {{ savings_percent }}%</div>
      {%- endif -%}
    </div>
  </div>
</a>


<style>
  .product-card {
    display: block;
    text-decoration: none;
    position: relative;
  }

  .product-card-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #f5f5f5;
    border-radius: 12px;
    margin-bottom: 10px;
  }
  
  .product-carousel-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }
  
  .product-carousel-image.active {
    opacity: 1;
    position: relative;
  }
  
  /* LEFT BADGE LIKE HOMEPAGE */
  .homepage-style-badge {
    position: absolute;
    top: 10px;
    left: 0;
    background: #d32f2f;
    color: white;
    padding: 4px 8px;
    font-size: 0.7rem;
    font-weight: 700;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    z-index: 2;
  }
  
  /* ORANGE BUTTON - PERFECTLY ROUND AT EXACT TOP-RIGHT CORNER */
  .homepage-style-add-btn {
    position: absolute !important;
    top: 0 !important;
    right: 0 !important;
    background: #ff6f00 !important;
    color: white !important;
    border: none !important;
    width: 40px !important;
    height: 40px !important;
    border-radius: 50% !important;
    font-size: 1.4rem !important;
    line-height: 1 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    z-index: 9999 !important;
    box-shadow: 0 3px 10px rgba(255, 111, 0, 0.5) !important;
    pointer-events: auto !important;
    transition: transform 0.2s ease !important;
  }
  
  .homepage-style-add-btn:hover {
    transform: scale(1.15) !important;
  }
  
  /* Content Styling - FIXED HEIGHT FOR ALIGNMENT */
  .product-card-content {
    text-align: left;
    padding: 0 5px;
    min-height: 90px;
    display: flex;
    flex-direction: column;
  }
  
  .product-title {
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 8px;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    height: 2.6em;
    color: #333;
    text-decoration: none;
  }
  
  .product-price {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  
  .price-sale {
    font-size: 1.1rem;
    font-weight: 700;
    color: #333;
  }
  
  .price-regular {
    font-size: 0.8rem;
    color: #888;
    text-decoration: line-through;
  }
  
  .save-text {
    color: #d32f2f;
    font-size: 0.8rem;
    font-weight: 600;
  }
</style>

<script>
(function() {
  // Auto-rotate product images continuously
  document.addEventListener('DOMContentLoaded', function() {
    const productCards = document.querySelectorAll('.product-card');
    
    productCards.forEach(card => {
      const imageContainer = card.querySelector('.product-card-image');
      const images = card.querySelectorAll('.product-carousel-image');
      const dots = card.querySelectorAll('.carousel-dots .dot');
      
      if (images.length <= 1) return; // Skip if only one image
      
      let currentIndex = 0;
      
      function showImage(index) {
        images.forEach((img, i) => {
          if (i === index) {
            img.classList.add('active');
            img.style.opacity = '1';
            img.style.position = 'relative';
          } else {
            img.classList.remove('active');
            img.style.opacity = '0';
            img.style.position = 'absolute';
          }
        });
        
        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === index);
        });
      }
      
      function nextImage() {
        currentIndex = (currentIndex + 1) % images.length;
        showImage(currentIndex);
      }
      
      // Start carousel automatically - continuous rotation
      setInterval(nextImage, 2000); // Change image every 2 seconds
    });
  });
})();

// Quick Add to Cart Function for Catalog
function quickAddProductCatalog(event, variantId) {
  event.preventDefault();
  event.stopPropagation();
  
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      id: variantId,
      quantity: 1
    })
  })
  .then(response => response.json())
  .then(data => {
    alert('✅ Added to cart!');
    // Update cart count if function exists
    if (window.updateCartCount) window.updateCartCount();
  })
  .catch(error => {
    console.error('Error:', error);
    alert('Failed to add to cart. Please try again.');
  });
}
</script>
