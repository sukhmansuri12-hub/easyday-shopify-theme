{% comment %}
  Login Modal - Integrated with Shopify Shop App
  Uses Shopify's native authentication with OTP support
{% endcomment %}

<div id="login-modal" class="login-modal">
  <div class="login-modal-content">
    <button class="login-close" onclick="closeLoginModal()">×</button>
    
    <div class="login-box">
      <!-- Login View -->
      <div id="login-view" class="auth-view active">
        <h2>Welcome Back!</h2>
        <p class="login-subtitle">Login with OTP</p>
        
        <div class="login-form-group">
          <label for="login-email">Email Address</label>
          <input
            type="email"
            id="login-email"
            placeholder="your@email.com"
            required
            class="login-input"
          >
        </div>
        
        <button type="button" class="btn-login-submit" onclick="proceedToLogin()">
          SEND OTP
        </button>
        
        <div class="auth-switch">
          Don't have an account? <a href="#" onclick="event.preventDefault(); switchToSignup();">Sign Up</a>
        </div>
      </div>
      
      <!-- Signup View -->
      <div id="signup-view" class="auth-view">
        <h2>Create Account</h2>
        <p class="login-subtitle">Sign up with OTP</p>
        
        <div class="login-form-group">
          <label for="signup-email">Email Address</label>
          <input
            type="email"
            id="signup-email"
            placeholder="your@email.com"
            required
            class="login-input"
          >
        </div>
        
        <button type="button" class="btn-login-submit" onclick="proceedToSignup()">
          CONTINUE
        </button>
        
        <div class="auth-switch">
          Already have an account? <a href="#" onclick="event.preventDefault(); switchToLogin();">Login</a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .login-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: rgba(0, 0, 0, 0.6);
    z-index: 9999999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  
  .login-modal.open {
    display: flex;
  }
  
  .login-modal-content {
    background: white;
    border-radius: 16px;
    width: 100%;
    max-width: 400px;
    position: relative;
    animation: slideDown 0.3s ease;
  }
  
  @keyframes slideDown {
    from {
      transform: translateY(-50px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  
  .login-close {
    position: absolute;
    top: 15px;
    right: 15px;
    background: none;
    border: none;
    font-size: 2rem;
    cursor: pointer;
    color: #333;
    line-height: 1;
    z-index: 10;
  }
  
  .login-box {
    padding: 40px;
  }
  
  .auth-view {
    display: none;
  }
  
  .auth-view.active {
    display: block;
  }
  
  .login-box h2 {
    text-align: center;
    margin-bottom: 10px;
    color: #333;
  }
  
  .login-subtitle {
    text-align: center;
    color: #666;
    margin-bottom: 30px;
    font-size: 0.95rem;
  }
  
  .login-form-group {
    margin-bottom: 20px;
  }
  
  .login-form-group label {
    display: block;
    font-weight: 600;
    margin-bottom: 8px;
    color: #333;
  }
  
  .login-input {
    width: 100%;
    padding: 14px 16px;
    border: 2px solid #ddd;
    border-radius: 8px;
    font-size: 1rem;
    transition: border-color 0.3s;
    box-sizing: border-box;
  }
  
  .login-input:focus {
    outline: none;
    border-color: #FF6F00;
  }
  
  .btn-login-submit {
    width: 100%;
    padding: 15px;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s;
    text-align: center;
    background: linear-gradient(135deg, #FF6F00 0%, #FF8F00 100%);
    color: white;
    margin-bottom: 15px;
  }
  
  .btn-login-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255, 111, 0, 0.4);
  }
  
  .auth-switch {
    text-align: center;
    margin-top: 25px;
    color: #666;
    font-size: 0.95rem;
  }
  
  .auth-switch a {
    color: #FF6F00;
    text-decoration: none;
    font-weight: 600;
  }
</style>

<script>
  function openLoginModal() {
    const modal = document.getElementById('login-modal');
    if (modal) {
      modal.classList.add('open');
    }
  }
  
  function closeLoginModal() {
    const modal = document.getElementById('login-modal');
    if (modal) {
      modal.classList.remove('open');
      // Reset views
      document.getElementById('login-email').value = '';
      document.getElementById('signup-email').value = '';
    }
  }
  
  function switchToSignup() {
    document.getElementById('login-view').classList.remove('active');
    document.getElementById('signup-view').classList.add('active');
  }
  
  function switchToLogin() {
    document.getElementById('signup-view').classList.remove('active');
    document.getElementById('login-view').classList.add('active');
  }
  
  function proceedToLogin() {
    const email = document.getElementById('login-email').value;
    if (!email || !email.includes('@')) {
      alert('Please enter a valid email address');
      return;
    }
    
    // Redirect to Shopify's login page - Shop App will handle OTP automatically
    // Store email in URL parameter so Shopify can pre-fill it
    window.location.href = '/account/login?checkout_url=/account&email=' + encodeURIComponent(email);
  }
  
  function proceedToSignup() {
    const email = document.getElementById('signup-email').value;
    if (!email || !email.includes('@')) {
      alert('Please enter a valid email address');
      return;
    }
    
    // Redirect to Shopify's register page - will use Shop App if available
    window.location.href = '/account/register?checkout_url=/account&email=' + encodeURIComponent(email);
  }
  
  // Close on backdrop click
  document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('login-modal');
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) {
          closeLoginModal();
        }
      });
    }
    
    // Allow Enter key to submit
    document.getElementById('login-email')?.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        proceedToLogin();
      }
    });
    
    document.getElementById('signup-email')?.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        proceedToSignup();
      }
    });
  });
</script>
