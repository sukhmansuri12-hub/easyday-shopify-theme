{% comment %}
  OFFICIAL DESKTOP OPTIMIZATION - EASYDAY THEME
  Apply ONLY to screens wider than 1024px (Laptop/Desktop).
  Mobile view (under 768px) is strictly UNTOUCHED.
{% endcomment %}

<style>
@media (min-width: 1024px) {

  /* 1. Main Container: GRID LAYOUT */
  .product-page-rc-car {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 40px;
    display: grid !important;
    grid-template-columns: 58% 38%; /* Left Image, Right Content */
    gap: 4%;
    align-items: start;
  }

  /* 2. Left Column: Image Gallery ONLY */
  .product-image-gallery {
    grid-column: 1;
    grid-row: 1 / 100; /* Span way down to cover height of right side */
    position: sticky;
    top: 20px;
    height: auto;
    background: transparent !important;
    width: 100%;
    margin: 0 !important;
  }

  /* 3. Right Column: Force EVERYTHING ELSE to the right */
  /* This selector grabs all direct children of the container that are NOT the gallery */
  .product-page-rc-car > *:not(.product-image-gallery) {
    grid-column: 2;
    width: 100%;
    margin-bottom: 20px;
  }

  /* Gallery Internals - Grid of images */
  .gallery-container {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 15px !important;
    overflow: visible !important;
  }

  /* First image spans full width */
  .slide:first-child {
    grid-column: span 2;
  }

  .slide {
    width: 100% !important;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #eee;
  }

  .slide img {
    width: 100% !important;
    height: auto !important;
    object-fit: cover !important;
    display: block;
  }
  
  .gallery-dots { display: none !important; }

  /* Right Column Styling */
  .product-info-section {
    padding: 0 !important;
    background: transparent !important;
    margin-bottom: 30px !important;
  }

  /* Typography */
  .product-title-rc {
    font-size: 2.2rem !important;
    line-height: 1.2;
    margin-bottom: 15px !important;
  }

  .current-price-rc { font-size: 2.0rem !important; }
  
  /* Variant Selector */
  .variant-options-rc {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  
  .variant-option-rc { margin: 0 !important; }

  /* Description & Reviews on the Right */
  .product-description-rc {
    margin-top: 20px;
    padding: 20px 0 !important;
    border-top: 1px solid #eee;
  }
  
  .reviews-section-rc {
    padding: 20px 0 !important;
    background: transparent !important;
    border-top: 1px solid #eee;
  }

  /* Fix the sticky bottom bar - hide on desktop */
  .sticky-bottom-bar-rc { display: none !important; }

  /* Make sure the "You May Also Like" section breaks out of the grid or sits at bottom */
  .you-may-also-like-section {
    grid-column: 1 / -1 !important; /* Span full width */
    margin-top: 60px;
    padding-top: 40px;
    border-top: 2px solid #eee;
  }
  
  /* Fix CTA button container */
  .product-page-rc-car > div[style*="text-align:center"] {
    background: transparent !important;
    text-align: left !important;
    padding: 10px 0 !important;
  }
  
  .cta-shake-button {
    width: 100%;
    margin: 0 !important;
  }
}
</style>
