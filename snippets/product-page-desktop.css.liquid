{% comment %}
  OFFICIAL DESKTOP OPTIMIZATION - EASYDAY THEME
  Apply ONLY to screens wider than 1024px (Laptop/Desktop).
  Mobile view (under 768px) is strictly UNTOUCHED.
{% endcomment %}

<style>
@media (min-width: 1024px) {

  /* 1. Main Container: GRID LAYOUT - Optimized Spacing */
  .product-page-rc-car {
    max-width: 1400px;
    margin: 30px auto;
    padding: 0 40px;
    display: grid !important;
    grid-template-columns: 55% 40%;
    column-gap: 40px;
    row-gap: 0;
    align-items: start;
  }

  /* 2. Left Column: Image Gallery ONLY */
  .product-image-gallery {
    grid-column: 1;
    grid-row: 1 / 10; /* Span down */
    position: relative;
    height: auto;
    background: transparent !important;
    width: 100%;
    margin: 0 !important;
  }

  /* 3. Right Column: Info & Description */
  /* Target specific classes to go to the right */
  .product-info-section,
  .product-description-rc {
    grid-column: 2;
    width: 100%;
    margin-bottom: 0 !important; /* Remove bottom margin */
  }

  /* Sticky Info - Keeps buy button visible while scrolling images */
  /* Sticky Info Removed as per user request */
  .product-info-section {
    position: relative;
    z-index: 10;
    border-bottom: none !important; /* improved flow */
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    margin-bottom: 0 !important;
    box-shadow: none !important; /* cleaner look */
    border: none !important;
    padding: 0 !important; /* Remove padding to align with edge */
    padding-bottom: 10px !important;
  }

  /* Gallery Internals - Grid of images - Optimized */
  .gallery-container {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 15px !important;
    overflow: visible !important;
  }

  .slide:first-child {
    grid-column: span 2;
  }

  .slide {
    width: 100% !important;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #e5e5e5;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    transition: all 0.3s ease;
  }
  
  .slide:hover {
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
    transform: translateY(-2px);
  }

  .slide img {
    width: 100% !important;
    height: auto !important;
    object-fit: cover !important;
    display: block;
    transition: transform 0.4s ease;
  }
  
  .slide:hover img {
    transform: scale(1.03);
  }
  
  .gallery-dots { display: none !important; }

  /* Right Column Styling */
  /* We removed the box style from .product-info-section above to make it cleaner */
  
  /* Typography - Enhanced */
  .product-title-rc {
    font-size: 3rem !important;
    line-height: 1.1;
    margin-bottom: 15px !important;
    font-weight: 700 !important;
    letter-spacing: -0.01em;
  }

  .current-price-rc { 
    font-size: 2.4rem !important;
    font-weight: 800 !important;
  }
  
  /* Variant Selector */
  .variant-options-rc {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .variant-option-rc { margin: 0 !important; }

  /* Description on Right, below Info */
  .product-description-rc {
    padding: 20px 0 0 0 !important; /* Reduced padding */
    border-top: 1px solid #eee;
    margin-top: 0 !important; /* No top margin */
  }

  /* Trust Badges - Fix spacing */
  .product-description-rc > div[style*="text-align: center"] {
    margin-bottom: 15px !important; /* Reduced from 30px */
  }

  /* =========================================
     4. CUSTOMER REVIEWS - BOTTOM FULL WIDTH 
     ========================================= */
  .reviews-section-rc {
    grid-column: 1 / -1 !important; /* Forces full width */
    margin-top: 40px !important;
    padding: 60px 0 !important;
    border-top: 2px solid #f5f5f5;
    background: white !important;
  }

  /* Review Title */
  .reviews-title {
    text-align: center;
    font-size: 2rem !important;
    margin-bottom: 40px !important;
  }
  
  /* Hide the summary stars/count in the big section (redundant) */
  .reviews-section-rc > div[style*="display:flex"] {
    justify-content: center;
    margin-bottom: 50px !important;
    transform: scale(1.2);
  }

  /* TRANSFORM REVIEW CARDS INTO GRID */
  /* We use a flex container logic applied to the parent div of cards */
  /* Since cards are direct children of .reviews-section-rc, we target the container and enable grid */
  .reviews-section-rc {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
  }
  
  /* Force Title and Summary to take full width of the flex container */
  .reviews-title,
  .reviews-section-rc > div[style*="display:flex"] {
    width: 100%;
  }

  .review-card {
    width: calc(33.333% - 20px) !important;
    min-width: 300px;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 16px;
    padding: 30px !important;
    box-shadow: 0 6px 25px rgba(0,0,0,0.05);
    margin-bottom: 0 !important;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .review-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.12);
  }
  
  /* Ultra-wide screens: 4 columns */
  @media (min-width: 1600px) {
    .review-card {
      width: calc(25% - 20px) !important;
    }
  }

  /* User Info styling inside card */
  .reviewer-info strong {
    font-size: 1.1rem;
    color: #333;
  }

  /* =========================================
     5. BOTTOM SECTIONS
     ========================================= */

  /* You May Also Like */
  .you-may-also-like-section {
    grid-column: 1 / -1 !important;
    margin-top: 20px;
    padding-top: 40px;
    border-top: none;
  }
  
  /* Fix CTA button container */
  .product-page-rc-car > div[style*="text-align:center"] {
    grid-column: 2; /* Keep CTA with sticky info or move to bottom? */
    /* Let's keep it near info for conversion, or we can hide it. */
    /* The user's ref shows sticky info. We have sticky info. */
    /* Let's hide the extra floating CTA at bottom of desktop since we have sticky buy buttons */
    display: none !important; 
  }

  /* Hide sticky bottom bar on desktop */
  .sticky-bottom-bar-rc { display: none !important; }
  
}
</style>
